      "scene": "s1",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "用 WiFi 信号就能感知人体，完全不需要摄像头，这事真的成了。",
          "start": 0.1,
          "end": 4.9
        }
      ]
    },
    {
      "scene": "s2",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "第一个 RuView，把家用路由器的 WiFi 信号变成空间雷达。",
          "start": 0.1,
          "end": 4.0
        },
        {
          "index": 1,
          "text": "不用一个摄像头，就能检测人体位置、呼吸频率，连老人跌倒都能发现。",
          "start": 3.95,
          "end": 9.13
        },
        {
          "index": 2,
          "text": "今天涨了六百多星，将近七万总星，Rust 写的。",
          "start": 9.13,
          "end": 12.98
        }
      ]
    },
    {
      "scene": "s3",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "第二个 markitdown，微软出品，今天涨了两千四百星，加速上涨中。",
          "start": 0.1,
          "end": 4.73
        },
        {
          "index": 1,
          "text": "把 Word、PDF、Excel 各种文件一键转成 Markdown，相当于给大模型开了个万能文件转换器。",
          "start": 4.68,
          "end": 11.51
        }
      ]
    },
    {
      "scene": "s4",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "第三个 liteparse，LlamaIndex 用 Rust 写的极速文档解析器。",
          "start": 0.1,
          "end": 3.74
        },
        {
          "index": 1,
          "text": "今天九百多星，解析速度碾压同类，开源免费。",
          "start": 3.69,
          "end": 7.45
        },
        {
          "index": 2,
          "text": "做 RAG 应用的开发者直接上手。",
          "start": 7.45,
          "end": 10.12
        }
      ]
    },
    {
      "scene": "s5",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "第四个 VoxCPM，清华 OpenBMB 团队出品。",
          "start": 0.1,
          "end": 3.34
        },
        {
          "index": 1,
          "text": "最大亮点是不需要 tokenizer，就能做高质量多语言语音克隆，还能设计全新的声音角色。",
          "start": 3.29,
          "end": 9.34
        },
        {
          "index": 2,
          "text": "今天涨了六百多星。",
          "start": 9.34,
          "end": 11.25
        }
      ]
    },
    {
      "scene": "s6",
      "segment_index": 5,
      "sentences": [
        {
          "index": 0,
          "text": "第五个 ECC，将近二十万星。",
          "start": 0.1,
          "end": 2.38
        },
        {
          "index": 1,
          "text": "AI 智能体性能优化系统，给 Agent 加上记忆、直觉、安全和研究能力。",
          "start": 2.33,
          "end": 7.87
        },
        {
          "index": 2,
          "text": "用,克劳德扣得,和 Cursor 的开发者已经在用了。",
          "start": 7.87,
          "end": 11.68
        }
      ]
    },
    {
      "scene": "s7",
      "segment_index": 6,
      "sentences": [
        {
          "index": 0,
          "text": "MoneyPrinterTurbo 连续两天霸榜，今天又涨了两千七百多星。",
          "start": 0.1,
          "end": 4.24
        }
      ]
    },
    {
      "scene": "s8",
      "segment_index": 7,
      "sentences": [
        {
          "index": 0,
          "text": "关注我，每天发现开源好项目。",
          "start": 0.1,
          "end": 2.91
        }
      ]
    }
  ]
