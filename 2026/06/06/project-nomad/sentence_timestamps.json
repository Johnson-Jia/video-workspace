{
  "meta": {
    "voice": "zh-CN-YunjianNeural",
    "rate": "+25%",
    "source": "edge-tts-srt"
  },
  "segments": [
    {
      "scene": "s1-hook",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "拔掉网线，你的电脑还能干什么？",
          "start": 0.1,
          "end": 3.09
        }
      ]
    },
    {
      "scene": "s2-what",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "这个项目叫 NOMAD，一个完全免费的开源离线知识服务器。",
          "start": 0.1,
          "end": 4.09
        },
        {
          "index": 1,
          "text": "装上它之后，断网也能用 AI 聊天、查百科全书、看离线地图、学课程。",
          "start": 4.04,
          "end": 9.73
        },
        {
          "index": 2,
          "text": "不到一个月，二万八千,的星标，翻了 20 倍。",
          "start": 9.73,
          "end": 13.48
        }
      ]
    },
    {
      "scene": "s3-philosophy",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "它的设计理念很直接：互联网不是永久的。",
          "start": 0.1,
          "end": 3.38
        },
        {
          "index": 1,
          "text": "一旦安装完成，你的电脑就变成一座独立的知识库，零联网、零遥测、零依赖。",
          "start": 3.33,
          "end": 9.31
        },
        {
          "index": 2,
          "text": "创建者不是什么 AI 科学家，而是一个干了十八年网络工程的工程师。",
          "start": 9.31,
          "end": 14.22
        },
        {
          "index": 3,
          "text": "他觉得，知识不应该只有在线才能获取，这个想法促成了 NOMAD。",
          "start": 14.22,
          "end": 19.02
        }
      ]
    },
    {
      "scene": "s4-architecture",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "技术实现上，NOMAD 用 Docker 容器编排，把六个独立工具打包在一台电脑上。",
          "start": 0.1,
          "end": 5.35
        },
        {
          "index": 1,
          "text": "外面套了一个管理面板叫 Command Center，一键安装、统一管理，全是图形化操作。",
          "start": 5.3,
          "end": 11.1
        },
        {
          "index": 2,
          "text": "架构设计得很干净，每个模块独立运行、独立更新，互不干扰。",
          "start": 11.1,
          "end": 16.22
        }
      ]
    },
    {
      "scene": "s5-features-ai",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "最亮眼的功能是离线 AI 对话。",
          "start": 0.1,
          "end": 2.55
        },
        {
          "index": 1,
          "text": "你可以上传文档让它帮你分析总结，完全在本地运行，隐私零泄露。",
          "start": 2.5,
          "end": 7.54
        },
        {
          "index": 2,
          "text": "底层用 Ollama 跑大模型，配上语义搜索。",
          "start": 7.54,
          "end": 10.7
        },
        {
          "index": 3,
          "text": "再结合离线维基百科，整个百科全书下载到本地，99G 的内容，医学参考、生存指南全都有。",
          "start": 10.7,
          "end": 18.04
        }
      ]
    },
    {
      "scene": "s6-features-tools",
      "segment_index": 5,
      "sentences": [
        {
          "index": 0,
          "text": "离线地图也很实用，下载区域数据就能导航。",
          "start": 0.1,
          "end": 3.46
        },
        {
          "index": 1,
          "text": "教育方面，内置了完整的在线课程，支持进度追踪和多用户，适合家庭和教室。",
          "start": 3.41,
          "end": 9.27
        },
        {
          "index": 2,
          "text": "还有数据分析的瑞士军刀，本地 Markdown 笔记。",
          "start": 9.27,
          "end": 12.59
        },
        {
          "index": 3,
          "text": "六个工具各司其职，全部离线运行。",
          "start": 12.59,
          "end": 15.79
        }
      ]
    },
    {
      "scene": "s7-limitations",
      "segment_index": 6,
      "sentences": [
        {
          "index": 0,
          "text": "说说不方便的地方。",
          "start": 0.1,
          "end": 1.72
        },
        {
          "index": 1,
          "text": "推荐配置是 RTX 3060 加 32G 内存，硬件门槛不低。",
          "start": 1.67,
          "end": 6.43
        },
        {
          "index": 2,
          "text": "安装过程需要联网下载几十 G 的内容，国内用户还得解决网络问题。",
          "start": 6.43,
          "end": 11.34
        },
        {
          "index": 3,
          "text": "内容全是英文，中文维基需要另外下载适配。",
          "start": 11.34,
          "end": 15.07
        }
      ]
    },
    {
      "scene": "s8-usecases",
      "segment_index": 7,
      "sentences": [
        {
          "index": 0,
          "text": "但它特别适合这些场景：露营或偏远地区、应急通信中断、隐私敏感环境、教育信息化。",
          "start": 0.1,
          "end": 6.86
        },
        {
          "index": 1,
          "text": "一旦装好，谁都不需要网络也能用。",
          "start": 6.81,
          "end": 9.72
        },
        {
          "index": 2,
          "text": "这个思路很值得国内开发者借鉴。",
          "start": 9.72,
          "end": 12.61
        }
      ]
    },
    {
      "scene": "s9-cta",
      "segment_index": 8,
      "sentences": [
        {
          "index": 0,
          "text": "你觉得断网后还需要什么功能？",
          "start": 0.1,
          "end": 2.85
        },
        {
          "index": 1,
          "text": "评论区告诉我。",
          "start": 2.8,
          "end": 4.24
        },
        {
          "index": 2,
          "text": "关注我，下期见。",
          "start": 4.24,
          "end": 6.24
        }
      ]
    }
  ]
}