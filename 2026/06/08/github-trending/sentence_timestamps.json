  "segments": [
    {
      "scene": "hook",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "6月8日几个项目杀上来，有个向量引擎比同类快两成，千万级数据只占4G内存",
          "start": 0.1,
          "end": 6.85
        }
      ]
    },
    {
      "scene": "turbovec",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "开头说个猛的，turbovec，基于谷歌的TurboQuant算法，用Rust写的向量索引引擎。",
          "start": 0.1,
          "end": 5.57
        },
        {
          "index": 1,
          "text": "一千万条向量数据，传统方案要31GB内存，它只要4GB，搜索速度还比同类快12%到20%。",
          "start": 5.52,
          "end": 12.92
        },
        {
          "index": 2,
          "text": "关键是完全本地运行，数据不离开你的机器，做RAG的同学们可以关注一下",
          "start": 12.92,
          "end": 18.38
        }
      ]
    },
    {
      "scene": "pg_durable",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "第二个 pg_durable，微软出的PostgreSQL插件。",
          "start": 0.1,
          "end": 4.11
        },
        {
          "index": 1,
          "text": "它把数据库变成了工作流引擎，你在SQL里定义好步骤，每一步自动存检查点，数据库崩了也不怕，虫启从上一步接着跑。",
          "start": 4.06,
          "end": 12.38
        },
        {
          "index": 2,
          "text": "以前要搭Airflow或Temporal来编排任务，现在直接在数据库里搞定",
          "start": 12.38,
          "end": 17.2
        }
      ]
    },
    {
      "scene": "goose",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "第三个 goose，一个开源的AI Agent，用Rust写的，四万七千星。",
          "start": 0.1,
          "end": 4.72
        },
        {
          "index": 1,
          "text": "它不只是代码补全，能从安装依赖、写代码、跑测试一条龙搞定。",
          "start": 4.67,
          "end": 9.65
        },
        {
          "index": 2,
          "text": "支持接入任意大模型，遵循MCP协议，喜欢折腾Agent的同学可以试试",
          "start": 9.65,
          "end": 15.18
        }
      ]
    },
    {
      "scene": "ai_tools",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "还有两个工具类项目，AiToEarn用AI自动生成内容然后一键发到多个平台，抖音快手小红书全覆盖。",
          "start": 0.1,
          "end": 7.32
        },
        {
          "index": 1,
          "text": "tolaria是个Markdown知识库桌面应用，本地优先数据不外传，做笔记管理挺方便的",
          "start": 7.27,
          "end": 13.2
        }
      ]
    },
    {
      "scene": "cta",
      "segment_index": 5,
      "sentences": [
        {
          "index": 0,
          "text": "对了上次说的跨平台研究技能last30days又涨了一千星，连续霸榜好几天了。",
          "start": 0.1,
          "end": 5.91
        },
        {
          "index": 1,
          "text": "关注我，下期见",
          "start": 5.86,
          "end": 7.83
        }
      ]
    }
  ]
