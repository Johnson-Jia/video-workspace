{
  "meta": {
    "voice": "zh-CN-YunjianNeural",
    "rate": "+25%",
    "source": "edge-tts-srt"
  },
  "segments": [
    {
      "scene": "hook",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "170亿烧光，证明这是真需求。",
          "start": 0.1,
          "end": 3.21
        }
      ]
    },
    {
      "scene": "market",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "先看盘子有多大。",
          "start": 0.1,
          "end": 1.82
        },
        {
          "index": 1,
          "text": "全球企业培训市场，2025年突破4000亿美金，6家机构交叉验证。",
          "start": 1.77,
          "end": 7.17
        },
        {
          "index": 2,
          "text": "其中AI培训这个细分，年增掌率20%以上，是整体增速的三倍。",
          "start": 7.17,
          "end": 12.25
        },
        {
          "index": 3,
          "text": "美国每员工年均培训支出874美金，还在涨。",
          "start": 12.25,
          "end": 16.09
        },
        {
          "index": 4,
          "text": "结论很简单：这是一块确定增掌的大蛋糕，而且AI这块涨得最快。",
          "start": 16.09,
          "end": 21.7
        }
      ]
    },
    {
      "scene": "gap",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "但真正有意思的是供需错配。",
          "start": 0.1,
          "end": 2.57
        },
        {
          "index": 1,
          "text": "麦肯锡数据显示，92%的公司打算加大AI培训投入。",
          "start": 2.52,
          "end": 7.12
        },
        {
          "index": 2,
          "text": "可只有1%的公司，敢说自己真的做到了。",
          "start": 7.12,
          "end": 10.37
        },
        {
          "index": 3,
          "text": "71%的培训负责人在探索AI，77%的雇主想搞AI再培训，但真正受过AI培训的员工只有13%。",
          "start": 10.37,
          "end": 18.82
        },
        {
          "index": 4,
          "text": "想要的人排着队，能做好的机乎没有。",
          "start": 18.82,
          "end": 21.62
        },
        {
          "index": 5,
          "text": "这就是机会。",
          "start": 21.62,
          "end": 23.14
        }
      ]
    },
    {
      "scene": "byjus",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "但机会前面，摆着170亿美金的尸骨。",
          "start": 0.1,
          "end": 3.44
        },
        {
          "index": 1,
          "text": "先说 Byju's。",
          "start": 3.39,
          "end": 4.78
        },
        {
          "index": 2,
          "text": "印度曾经最值钱的独角兽，估值220亿美金。",
          "start": 4.78,
          "end": 8.32
        },
        {
          "index": 3,
          "text": "怎么崩的？",
          "start": 8.32,
          "end": 9.45
        },
        {
          "index": 4,
          "text": "疯狂收购，花10亿美金买一家，又花6亿买一家，根本没整合。",
          "start": 9.45,
          "end": 14.38
        },
        {
          "index": 5,
          "text": "营销一年烧2.5亿，每个学生获客成本过万卢比。",
          "start": 14.38,
          "end": 18.49
        },
        {
          "index": 6,
          "text": "疫情红利一退，债务连环爆雷。",
          "start": 18.49,
          "end": 21.17
        },
        {
          "index": 7,
          "text": "2024年，估值直接归零。",
          "start": 21.17,
          "end": 23.57
        },
        {
          "index": 8,
          "text": "规模，救不了烂账。",
          "start": 23.57,
          "end": 25.64
        }
      ]
    },
    {
      "scene": "two-u",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "再看 2U。",
          "start": 0.1,
          "end": 1.25
        },
        {
          "index": 1,
          "text": "靠借债扩张，花8亿美金收购edX，背了9亿多美金债务。",
          "start": 1.2,
          "end": 5.74
        },
        {
          "index": 2,
          "text": "结果大学开始自己搞网课，它的分成模式被瓦解。",
          "start": 5.74,
          "end": 9.48
        },
        {
          "index": 3,
          "text": "收入见顶回落，债务越滚越大。",
          "start": 9.48,
          "end": 12.26
        },
        {
          "index": 4,
          "text": "2024年7月，直接申请破产。",
          "start": 12.26,
          "end": 14.86
        },
        {
          "index": 5,
          "text": "累计亏损16亿美金。",
          "start": 14.86,
          "end": 16.87
        },
        {
          "index": 6,
          "text": "记住一句话：教育不是房地产，别用债务撬规模。",
          "start": 16.87,
          "end": 20.94
        }
      ]
    },
    {
      "scene": "udacity",
      "segment_index": 5,
      "sentences": [
        {
          "index": 0,
          "text": "接着 Udacity。",
          "start": 0.1,
          "end": 1.6
        },
        {
          "index": 1,
          "text": "曾经的10亿美金独角兽。",
          "start": 1.55,
          "end": 3.6
        },
        {
          "index": 2,
          "text": "问题出在哪？",
          "start": 3.6,
          "end": 4.97
        },
        {
          "index": 3,
          "text": "完成率常期个位数。",
          "start": 4.97,
          "end": 6.75
        },
        {
          "index": 4,
          "text": "注册的人多，学完的人机乎没有。",
          "start": 6.75,
          "end": 9.34
        },
        {
          "index": 5,
          "text": "转型转了四五回，每次都伴随大裁员。",
          "start": 9.34,
          "end": 12.37
        },
        {
          "index": 6,
          "text": "最后7500万美金债务到期，没人愿意再投钱。",
          "start": 12.37,
          "end": 16.2
        },
        {
          "index": 7,
          "text": "2024年，8000万美金卖身给Accenture，价值蒸发92%。",
          "start": 16.2,
          "end": 20.88
        },
        {
          "index": 8,
          "text": "低完成率，是教育产品的死刑。",
          "start": 20.88,
          "end": 23.67
        }
      ]
    },
    {
      "scene": "juni-mooc",
      "segment_index": 6,
      "sentences": [
        {
          "index": 0,
          "text": "还有个更典型的死法。",
          "start": 0.1,
          "end": 1.89
        },
        {
          "index": 1,
          "text": "Juni Learning，做一对一编程辅导。",
          "start": 1.84,
          "end": 4.32
        },
        {
          "index": 2,
          "text": "问题很数学：导师一小时25美金，月费收不到400美金，毛利率怎么算都到不了70%的及格线。",
          "start": 4.32,
          "end": 11.47
        },
        {
          "index": 3,
          "text": "加一个学生就得加一个导师，成本线性增掌，永远无法规模化。",
          "start": 11.47,
          "end": 16.31
        },
        {
          "index": 4,
          "text": "再算上MOOC平台们，完成率不到10%，免费根本变不了现。",
          "start": 16.31,
          "end": 20.87
        },
        {
          "index": 5,
          "text": "人力密集，就是死路。",
          "start": 20.87,
          "end": 23.2
        }
      ]
    },
    {
      "scene": "attribution",
      "segment_index": 7,
      "sentences": [
        {
          "index": 0,
          "text": "那它们到底未什么死？",
          "start": 0.1,
          "end": 1.99
        },
        {
          "index": 1,
          "text": "有人整理了1600多个失败案例。",
          "start": 1.94,
          "end": 4.49
        },
        {
          "index": 2,
          "text": "结论反直觉：只有不到12%，是死于没人要。",
          "start": 4.49,
          "end": 8.3
        },
        {
          "index": 3,
          "text": "真正的三大杀手是：43%死于竞争太惨烈，18%死于监管和合规，16%死于单位经济算不过来。",
          "start": 8.3,
          "end": 16.65
        },
        {
          "index": 4,
          "text": "也就是说，需求是真的，死在打法上。",
          "start": 16.65,
          "end": 19.71
        },
        {
          "index": 5,
          "text": "这句话是整个赛道的分水岭。",
          "start": 19.71,
          "end": 22.4
        }
      ]
    },
    {
      "scene": "death-formula",
      "segment_index": 8,
      "sentences": [
        {
          "index": 0,
          "text": "把死因翻译成公式就是：人力成本线性增掌，加上疫情后需求回归正常，加上完成率不到10%，加上获客成本高企，再加上债务撬动规模。",
          "start": 0.1,
          "end": 10.36
        },
        {
          "index": 1,
          "text": "五条凑齐，必死。",
          "start": 10.31,
          "end": 11.99
        },
        {
          "index": 2,
          "text": "这不是某一家的悲剧，是整个旧打法的系统性缺陷。",
          "start": 11.99,
          "end": 15.98
        }
      ]
    },
    {
      "scene": "ai-fix",
      "segment_index": 9,
      "sentences": [
        {
          "index": 0,
          "text": "而AI，精准拆掉了这条公式最致命的一环。",
          "start": 0.1,
          "end": 3.76
        },
        {
          "index": 1,
          "text": "人力导师，一小时100到500美金。",
          "start": 3.71,
          "end": 6.62
        },
        {
          "index": 2,
          "text": "AI导师，用GPT-4o mini，一次辅导成本，2到5美分。",
          "start": 6.62,
          "end": 11.2
        },
        {
          "index": 3,
          "text": "降幅最高两万五千倍。",
          "start": 11.2,
          "end": 13.1
        },
        {
          "index": 4,
          "text": "加一个学生，不再需要加一个导师。",
          "start": 13.1,
          "end": 15.81
        },
        {
          "index": 5,
          "text": "从线性成本，变成无限并发，24小时在线。",
          "start": 15.81,
          "end": 19.62
        },
        {
          "index": 6,
          "text": "哈佛的实验更狠，AI导师组的学习效果，是对照组的两倍以上。",
          "start": 19.62,
          "end": 24.4
        },
        {
          "index": 7,
          "text": "人力成本这座大山，被AI直接铲平。",
          "start": 24.4,
          "end": 27.52
        }
      ]
    },
    {
      "scene": "academic",
      "segment_index": 10,
      "sentences": [
        {
          "index": 0,
          "text": "光便宜还不够，得有效。",
          "start": 0.1,
          "end": 2.12
        },
        {
          "index": 1,
          "text": "哈佛物理课做了对照实验，AI组效果是两倍。",
          "start": 2.07,
          "end": 5.56
        },
        {
          "index": 2,
          "text": "卡内基梅隆的最新研究说得更细：纯AI很强，但AI加人类导师的混合模式，效果才最佳。",
          "start": 5.56,
          "end": 12.52
        },
        {
          "index": 3,
          "text": "结论很清晰，AI负责规模和效率，人负责深层引导。",
          "start": 12.52,
          "end": 16.67
        },
        {
          "index": 4,
          "text": "这不是替代，是分工。",
          "start": 16.67,
          "end": 18.92
        }
      ]
    },
    {
      "scene": "enterprise",
      "segment_index": 11,
      "sentences": [
        {
          "index": 0,
          "text": "而且大厂已经在真金白银地投。",
          "start": 0.1,
          "end": 2.58
        },
        {
          "index": 1,
          "text": "联合利华用AI做内部人才市场，招聘时间缩短九成，省了100万英镑。",
          "start": 2.53,
          "end": 8.12
        },
        {
          "index": 2,
          "text": "普华永道给7.5万员工做AI培训，砸了10亿美金级战略。",
          "start": 8.12,
          "end": 12.81
        },
        {
          "index": 3,
          "text": "IBM更狠，目标三年培训200万人。",
          "start": 12.81,
          "end": 15.83
        },
        {
          "index": 4,
          "text": "需求不是PPT画出来的，是真有人在买单。",
          "start": 15.83,
          "end": 19.45
        }
      ]
    },
    {
      "scene": "differentiation",
      "segment_index": 12,
      "sentences": [
        {
          "index": 0,
          "text": "那新打法到底掌什么样？",
          "start": 0.1,
          "end": 2.17
        },
        {
          "index": 1,
          "text": "两个关键词。",
          "start": 2.12,
          "end": 3.38
        },
        {
          "index": 2,
          "text": "一个是嵌入式。",
          "start": 3.38,
          "end": 4.78
        },
        {
          "index": 3,
          "text": "不做一个学习APP让人专门去学，而是钻进IDE、钻进邮箱、钻进CRM，在员工干活的时候实时指导。",
          "start": 4.78,
          "end": 12.07
        },
        {
          "index": 4,
          "text": "另一个是按效果收费。",
          "start": 12.07,
          "end": 13.9
        },
        {
          "index": 5,
          "text": "别人按人头收席位费，你按技能提升收钱。",
          "start": 13.9,
          "end": 17.16
        },
        {
          "index": 6,
          "text": "绕开正面竞争，把定价和客户成果绑在一起。",
          "start": 17.16,
          "end": 21.22
        }
      ]
    },
    {
      "scene": "model",
      "segment_index": 13,
      "sentences": [
        {
          "index": 0,
          "text": "这么一改，单位经济直接翻盘。",
          "start": 0.1,
          "end": 2.65
        },
        {
          "index": 1,
          "text": "用GPT-4o mini，毛利率能做到90%以上。",
          "start": 2.6,
          "end": 6.41
        },
        {
          "index": 2,
          "text": "还记得Juni那道算不过来的题吗？",
          "start": 6.41,
          "end": 8.86
        },
        {
          "index": 3,
          "text": "VC要的70%毛利率门槛，现在轻松跨过。",
          "start": 8.86,
          "end": 12.42
        },
        {
          "index": 4,
          "text": "就算用顶配模型，毛利率也有五到六成，照样能持续增掌。",
          "start": 12.42,
          "end": 16.86
        },
        {
          "index": 5,
          "text": "轻资产，高毛利，这才是对的生意。",
          "start": 16.86,
          "end": 20.1
        }
      ]
    },
    {
      "scene": "redline",
      "segment_index": 14,
      "sentences": [
        {
          "index": 0,
          "text": "当然，机会不等于躺赚。",
          "start": 0.1,
          "end": 2.16
        },
        {
          "index": 1,
          "text": "有五条红线必须盯紧。",
          "start": 2.11,
          "end": 3.99
        },
        {
          "index": 2,
          "text": "毛利率跌破60%，月流失超过5%，获客成本18个月收不回，AI每月用不到两次，续约率低于85%。",
          "start": 3.99,
          "end": 12.4
        },
        {
          "index": 3,
          "text": "任何一条亮起，商业模式就要虫新评估。",
          "start": 12.4,
          "end": 15.78
        },
        {
          "index": 4,
          "text": "这不是吓唬，是前面那些尸体换来的教训。",
          "start": 15.78,
          "end": 19.31
        }
      ]
    },
    {
      "scene": "roadmap",
      "segment_index": 15,
      "sentences": [
        {
          "index": 0,
          "text": "最后，怎么落地？",
          "start": 0.1,
          "end": 1.83
        },
        {
          "index": 1,
          "text": "分四步走。",
          "start": 1.78,
          "end": 2.96
        },
        {
          "index": 2,
          "text": "起步阶段，半年内，挑一个垂直技能，做MVP，找3到5个付费试点，预算5到15万美金。",
          "start": 2.96,
          "end": 9.91
        },
        {
          "index": 3,
          "text": "成掌阶段，一年半，验证单位经济，做到20家企业，年营收百万美金。",
          "start": 9.91,
          "end": 15.53
        },
        {
          "index": 4,
          "text": "扩张阶段，三年内，规模化和垂直SaaS渠道，做到千万。",
          "start": 15.53,
          "end": 19.88
        },
        {
          "index": 5,
          "text": "成熟阶段，五年，自研模型、国际化，冲击五千万美金年营收。",
          "start": 19.88,
          "end": 24.7
        },
        {
          "index": 6,
          "text": "先验证，再放大。",
          "start": 24.7,
          "end": 26.92
        }
      ]
    },
    {
      "scene": "cta",
      "segment_index": 16,
      "sentences": [
        {
          "index": 0,
          "text": "需求是真的，AI把账算平了，剩下的就是执行。",
          "start": 0.1,
          "end": 3.78
        },
        {
          "index": 1,
          "text": "关注我，看清每个赛道的商业底牌。",
          "start": 3.73,
          "end": 6.78
        }
      ]
    }
  ]
}