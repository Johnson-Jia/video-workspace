  "segments": [
    {
      "scene": "hook",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "这条视频，人类没有参与。",
          "start": 0.1,
          "end": 2.45
        },
        {
          "index": 1,
          "text": "它是一个开源工具，从文字到画面，自动锻造出来的。",
          "start": 2.4,
          "end": 6.44
        },
        {
          "index": 2,
          "text": "感谢你点亮 GitHub星探——今天，带你看看这把锤子。",
          "start": 6.44,
          "end": 10.76
        }
      ]
    },
    {
      "scene": "proof",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "它叫 ClipForge。",
          "start": 0.1,
          "end": 1.4
        },
        {
          "index": 1,
          "text": "九道工序，连成一条流水线；六十五个组件，搭出每一帧画面；四颗引擎之心，盯紧每一步不跑偏。",
          "start": 1.35,
          "end": 8.8
        },
        {
          "index": 2,
          "text": "内容丢进去，成片走出来。",
          "start": 8.8,
          "end": 11.31
        }
      ]
    },
    {
      "scene": "faith",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "而它把这一切，都开源了。",
          "start": 0.1,
          "end": 2.32
        },
        {
          "index": 1,
          "text": "源码、规则、组件，全部敞开。",
          "start": 2.27,
          "end": 5.07
        },
        {
          "index": 2,
          "text": "开源不是交换，是把火种，递到下一个人手里。",
          "start": 5.07,
          "end": 9.06
        }
      ]
    },
    {
      "scene": "whatif",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "如果每个人，都能用一套工具，做出属于自己的视频呢？",
          "start": 0.1,
          "end": 4.3
        },
        {
          "index": 1,
          "text": "如果这些工具，汇聚成一片星海，又会怎样？",
          "start": 4.25,
          "end": 8.16
        }
      ]
    },
    {
      "scene": "multiply",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "一个人写下工具，帮几十个人锻造视频；几十个人分享，就点燃了几百个创作灵感。",
          "start": 0.1,
          "end": 6.11
        },
        {
          "index": 1,
          "text": "当分享成为习惯，进步就不再是加法，而是乘法。",
          "start": 6.06,
          "end": 10.03
        }
      ]
    },
    {
      "scene": "climax",
      "segment_index": 5,
      "sentences": [
        {
          "index": 0,
          "text": "星火，可以燎原。",
          "start": 0.1,
          "end": 1.85
        },
        {
          "index": 1,
          "text": "在这套系统里，管线是锻造炉，把粗糙的文字，烧成精致的画面；组件是火种，六十五颗，一颗接一颗，点亮整片星空；引擎是鼓风机，让每一簇火苗，都烧得更旺。",
          "start": 1.8,
          "end": 14.16
        },
        {
          "index": 2,
          "text": "当千万簇星火汇聚，就能照亮每一个想表达的人。",
          "start": 14.16,
          "end": 17.84
        },
        {
          "index": 3,
          "text": "这就是开源的力量，不熄，不灭，一脉相承。",
          "start": 17.84,
          "end": 21.8
        }
      ]
    },
    {
      "scene": "you",
      "segment_index": 6,
      "sentences": [
        {
          "index": 0,
          "text": "而你，已经站在了这片火光里。",
          "start": 0.1,
          "end": 2.69
        },
        {
          "index": 1,
          "text": "你做的每一条视频，每一次点赞、每一次转发，都是其中一簇星火。",
          "start": 2.64,
          "end": 7.76
        }
      ]
    },
    {
      "scene": "cta",
      "segment_index": 7,
      "sentences": [
        {
          "index": 0,
          "text": "感谢你点亮 GitHub星探。",
          "start": 0.1,
          "end": 2.11
        },
        {
          "index": 1,
          "text": "开源让星火燎原，而你，就是那颗最新的星。",
          "start": 2.06,
          "end": 5.66
        },
        {
          "index": 2,
          "text": "接下来的日子，咱们，一起走。",
          "start": 5.66,
          "end": 8.56
        }
      ]
    }
  ]
}