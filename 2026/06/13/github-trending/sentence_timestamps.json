  "segments": [
    {
      "scene": "s1-hook",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "6月13日 GitHub 杀入几个猛项目，Apple 官方开源了个容器工具，单日冲上三千五百星",
          "start": 0.1,
          "end": 6.54
        }
      ]
    },
    {
      "scene": "s2-body",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "apple/container，苹果用 Swift 写的轻量容器工具，专未自家芯片优化。",
          "start": 0.1,
          "end": 4.75
        },
        {
          "index": 1,
          "text": "Mac 开发者终于不用装 Docker 桌面版了。",
          "start": 4.7,
          "end": 7.54
        },
        {
          "index": 2,
          "text": "三万五千星，今日最高涨星。",
          "start": 7.54,
          "end": 10.55
        }
      ]
    },
    {
      "scene": "s3-body",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "superpowers，把开发方法论打包成 Agent 能直接调用的技能包。",
          "start": 0.1,
          "end": 4.77
        },
        {
          "index": 1,
          "text": "二十二万星，技能框架确实是今年最热的风口。",
          "start": 4.72,
          "end": 8.63
        }
      ]
    },
    {
      "scene": "s4-body",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "openmed，开源的本地推理框架，模型在设备端跑，不依赖云端。",
          "start": 0.1,
          "end": 4.67
        },
        {
          "index": 1,
          "text": "支持文本理解和信息抽取，三千二百星，涨星还在加速。",
          "start": 4.62,
          "end": 9.29
        }
      ]
    },
    {
      "scene": "s5-body",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "PowerToys，微软官方的 Windows 效率工具合集，窗口管理、批量重命名、颜色拾取一应俱全。",
          "start": 0.1,
          "end": 7.03
        },
        {
          "index": 1,
          "text": "十三万星，连微软都觉得 Windows 自带功能不够用。",
          "start": 6.98,
          "end": 10.96
        }
      ]
    },
    {
      "scene": "s6-body",
      "segment_index": 5,
      "sentences": [
        {
          "index": 0,
          "text": "mattermost，十一年老项目突然加速，单日涨星从二十六飙升到三百九十一，十五倍。",
          "start": 0.1,
          "end": 5.88
        },
        {
          "index": 1,
          "text": "自托管协作，数据完全自主。",
          "start": 5.83,
          "end": 8.69
        }
      ]
    },
    {
      "scene": "s7-body",
      "segment_index": 6,
      "sentences": [
        {
          "index": 0,
          "text": "LMCache，专攻大模型推理的 KV 缓存层，把推理速度拉满。",
          "start": 0.1,
          "end": 4.68
        },
        {
          "index": 1,
          "text": "八千六百星，支持主流推理框架。",
          "start": 4.63,
          "end": 7.85
        }
      ]
    },
    {
      "scene": "s8-cta",
      "segment_index": 7,
      "sentences": [
        {
          "index": 0,
          "text": "今天六个项目，从容器到效率工具到推理加速，开源正在把专业能力送到每个人手上。",
          "start": 0.1,
          "end": 6.28
        },
        {
          "index": 1,
          "text": "关注我，下期见。",
          "start": 6.23,
          "end": 8.23
        }
      ]
    }
  ]
}