  "segments": [
    {
      "scene": "hook",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "旗舰模型，上线4天，全网下架。",
          "start": 0.1,
          "end": 3.57
        }
      ]
    },
    {
      "scene": "close",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "今天，海外顶尖AI公司，收到美国政府一封信。",
          "start": 0.1,
          "end": 3.98
        },
        {
          "index": 1,
          "text": "理由是国家安全。",
          "start": 3.93,
          "end": 5.48
        },
        {
          "index": 2,
          "text": "一纸出口管制，暂停所有外国人，访问它的旗舰模型。",
          "start": 5.48,
          "end": 9.89
        },
        {
          "index": 3,
          "text": "未了合规，连美国本土，也被一起禁用了。",
          "start": 9.89,
          "end": 13.6
        }
      ]
    },
    {
      "scene": "heat",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "一条公告，5742万阅读。",
          "start": 0.1,
          "end": 2.93
        },
        {
          "index": 1,
          "text": "朋友圈，直接刷屏。",
          "start": 2.88,
          "end": 4.9
        }
      ]
    },
    {
      "scene": "turn",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "就在所有人惋惜的时候。",
          "start": 0.1,
          "end": 2.05
        },
        {
          "index": 1,
          "text": "同一天下午，另一边，有人选择，把门打开。",
          "start": 2.0,
          "end": 5.86
        }
      ]
    },
    {
      "scene": "manifesto",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "国产团队，发了一条公告。",
          "start": 0.1,
          "end": 2.23
        },
        {
          "index": 1,
          "text": "它说：在一些前沿模型，突然变得不可用的时刻，前沿智能，不该只属于少数人。",
          "start": 2.18,
          "end": 8.28
        },
        {
          "index": 2,
          "text": "也不该被少数规则，随时收回。",
          "start": 8.28,
          "end": 11.15
        }
      ]
    },
    {
      "scene": "power",
      "segment_index": 5,
      "sentences": [
        {
          "index": 0,
          "text": "GLM-5.2，智谱当前的开源旗舰大模型。",
          "start": 0.1,
          "end": 3.63
        },
        {
          "index": 1,
          "text": "真正能用的，百万级超长上下文。",
          "start": 3.58,
          "end": 6.72
        },
        {
          "index": 2,
          "text": "长程Agent、复杂工程，扛得住。",
          "start": 6.72,
          "end": 9.7
        },
        {
          "index": 3,
          "text": "今晚开放，下周API，MIT协议，全面开源。",
          "start": 9.7,
          "end": 13.53
        }
      ]
    },
    {
      "scene": "contrast",
      "segment_index": 6,
      "sentences": [
        {
          "index": 0,
          "text": "封锁，守的是门。",
          "start": 0.1,
          "end": 1.89
        },
        {
          "index": 1,
          "text": "开源，开的是路。",
          "start": 1.84,
          "end": 3.52
        },
        {
          "index": 2,
          "text": "海外停服，国产补位。",
          "start": 3.52,
          "end": 5.43
        },
        {
          "index": 3,
          "text": "差距在算力，不在脑力。",
          "start": 5.43,
          "end": 7.77
        }
      ]
    },
    {
      "scene": "closing",
      "segment_index": 7,
      "sentences": [
        {
          "index": 0,
          "text": "一边关门，一边开门。",
          "start": 0.1,
          "end": 1.96
        },
        {
          "index": 1,
          "text": "墙，挡不住洪流。",
          "start": 1.91,
          "end": 3.63
        },
        {
          "index": 2,
          "text": "智能，应该属于所有人。",
          "start": 3.63,
          "end": 5.82
        },
        {
          "index": 3,
          "text": "关注我，一起看懂AI。",
          "start": 5.82,
          "end": 8.32
        }
      ]
    }
  ]
}