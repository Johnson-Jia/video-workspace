{
  "meta": {
    "voice": "zh-CN-YunjianNeural",
    "rate": "+10%",
    "source": "edge-tts-srt"
  },
  "segments": [
    {
      "scene": "s1_hook",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "13万亿，利润却不到百分之五。",
          "start": 0.1,
          "end": 3.175
        },
        {
          "index": 1,
          "text": "蛋糕大得惊人，利润薄得扎手。",
          "start": 3.125,
          "end": 6.215
        }
      ]
    },
    {
      "scene": "s2_digitization",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "答案在数字化。",
          "start": 0.1,
          "end": 1.8
        },
        {
          "index": 1,
          "text": "建筑业IT支出占比不到百分之一，连制造业零头都够不上。",
          "start": 1.75,
          "end": 7.045
        },
        {
          "index": 2,
          "text": "上千万的投标，还在凭老经验。",
          "start": 7.045,
          "end": 10.488
        }
      ]
    },
    {
      "scene": "s3_gap",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "这是航业最大的数据空白。",
          "start": 0.1,
          "end": 2.561
        },
        {
          "index": 1,
          "text": "没有结构化历史，没有价格对标，没有中标概率。",
          "start": 2.511,
          "end": 6.727
        },
        {
          "index": 2,
          "text": "报多高让几步，全凭感觉。",
          "start": 6.727,
          "end": 9.659
        }
      ]
    },
    {
      "scene": "s4_opportunity",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "可利润率每涨一到两个点，单个项目就是几百万。",
          "start": 0.1,
          "end": 4.22
        },
        {
          "index": 1,
          "text": "一年几十个标，数字惊人。",
          "start": 4.17,
          "end": 6.84
        },
        {
          "index": 2,
          "text": "帮他们把决策做对，就是金矿。",
          "start": 6.84,
          "end": 9.954
        }
      ]
    },
    {
      "scene": "s5_katerra_rise",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "这条路有人烧过巨资。",
          "start": 0.1,
          "end": 2.425
        },
        {
          "index": 1,
          "text": "2015年Katerra登场，号称颠覆建筑业，软银重金押注，巅峰估值四十亿美元。",
          "start": 2.375,
          "end": 9.25
        }
      ]
    },
    {
      "scene": "s6_katerra_fall",
      "segment_index": 5,
      "sentences": [
        {
          "index": 0,
          "text": "六年不到，烧光十六到二十亿美元。",
          "start": 0.1,
          "end": 3.47
        },
        {
          "index": 1,
          "text": "2021年6月破产，遣散费都没结清。",
          "start": 3.42,
          "end": 6.909
        },
        {
          "index": 2,
          "text": "明星独角兽，一夜归零。",
          "start": 6.909,
          "end": 9.693
        }
      ]
    },
    {
      "scene": "s7_five_causes",
      "segment_index": 6,
      "sentences": [
        {
          "index": 0,
          "text": "未什么垮？",
          "start": 0.1,
          "end": 1.47
        },
        {
          "index": 1,
          "text": "五个坑。",
          "start": 1.42,
          "end": 2.59
        },
        {
          "index": 2,
          "text": "全链条运营失控，替不掉传统分包商，质量频频失控，命脉押单一贷款方，过度扩张从未盈利。",
          "start": 2.59,
          "end": 11.034
        }
      ]
    },
    {
      "scene": "s8_wework",
      "segment_index": 7,
      "sentences": [
        {
          "index": 0,
          "text": "这和WeWork一个模子。",
          "start": 0.1,
          "end": 2.129
        },
        {
          "index": 1,
          "text": "同一个金主，同一个垂直整合，同一个结局。",
          "start": 2.079,
          "end": 6.09
        },
        {
          "index": 2,
          "text": "估值四百七十亿暴跌到八十亿，走向破产。",
          "start": 6.09,
          "end": 10.056
        }
      ]
    },
    {
      "scene": "s9_formula_vs_fix",
      "segment_index": 8,
      "sentences": [
        {
          "index": 0,
          "text": "失败有公式：全链条、运营失控、对抗航业、押注单点、堆规模。",
          "start": 0.1,
          "end": 6.209
        },
        {
          "index": 1,
          "text": "修复逻辑相反：只做一件事、嵌入流程、轻资本、靠数据。",
          "start": 6.159,
          "end": 12.056
        }
      ]
    },
    {
      "scene": "s10_market",
      "segment_index": 9,
      "sentences": [
        {
          "index": 0,
          "text": "机会多大？",
          "start": 0.1,
          "end": 1.538
        },
        {
          "index": 1,
          "text": "投标管理软件眼下五十八亿美元，年增掌近百分之六，十年有望一百零二亿。",
          "start": 1.488,
          "end": 8.181
        },
        {
          "index": 2,
          "text": "建筑技术更是千亿赛道。",
          "start": 8.181,
          "end": 10.988
        }
      ]
    },
    {
      "scene": "s11_competition_gap",
      "segment_index": 10,
      "sentences": [
        {
          "index": 0,
          "text": "头部玩家年收入十四亿，却盯大企业，月费六百多美元，中型公司够不着。",
          "start": 0.1,
          "end": 6.481
        },
        {
          "index": 1,
          "text": "高端被占，中端空白。",
          "start": 6.431,
          "end": 9.147
        }
      ]
    },
    {
      "scene": "s12_positioning",
      "segment_index": 11,
      "sentences": [
        {
          "index": 0,
          "text": "所以不抢巨头地盘，钻进它够不到的缝隙，用AI把投标决策这一件事做透。",
          "start": 0.1,
          "end": 6.754
        },
        {
          "index": 1,
          "text": "不贪大，只做精。",
          "start": 6.704,
          "end": 8.988
        }
      ]
    },
    {
      "scene": "s13_thesis",
      "segment_index": 12,
      "sentences": [
        {
          "index": 0,
          "text": "核心一句话：不做施工，只做决策。",
          "start": 0.1,
          "end": 3.777
        },
        {
          "index": 1,
          "text": "这是数据产品，不是建筑产品。",
          "start": 3.727,
          "end": 6.659
        },
        {
          "index": 2,
          "text": "不背施工的锅，只赚决策的钱。",
          "start": 6.659,
          "end": 10.022
        }
      ]
    },
    {
      "scene": "s14_four_capabilities",
      "segment_index": 13,
      "sentences": [
        {
          "index": 0,
          "text": "它干四件事。",
          "start": 0.1,
          "end": 1.663
        },
        {
          "index": 1,
          "text": "扒历史标书找报价偏差，对标同类市场价，预测中标概率，在利润和中标间找最优报价。",
          "start": 1.613,
          "end": 9.465
        }
      ]
    },
    {
      "scene": "s15_architecture",
      "segment_index": 14,
      "sentences": [
        {
          "index": 0,
          "text": "技术链路：标书进来先文字识别结构化，再喂历史数据库比对模式，最后大模型给定价建议和中标预测，生成报告。",
          "start": 0.1,
          "end": 9.925
        }
      ]
    },
    {
      "scene": "s16_speed",
      "segment_index": 15,
      "sentences": [
        {
          "index": 0,
          "text": "比人快多少？",
          "start": 0.1,
          "end": 1.606
        },
        {
          "index": 1,
          "text": "人工两到八小时，AI五到十五分钟。",
          "start": 1.556,
          "end": 5.159
        },
        {
          "index": 2,
          "text": "效率三十到五十倍。",
          "start": 5.159,
          "end": 7.181
        },
        {
          "index": 3,
          "text": "而且能吃下海量数据，不受情绪影响。",
          "start": 7.181,
          "end": 10.977
        }
      ]
    },
    {
      "scene": "s17_cost",
      "segment_index": 16,
      "sentences": [
        {
          "index": 0,
          "text": "成本更狠。",
          "start": 0.1,
          "end": 1.515
        },
        {
          "index": 1,
          "text": "人工一次两百到五百美元，AI只要零点五到五美元。",
          "start": 1.465,
          "end": 5.977
        },
        {
          "index": 2,
          "text": "降幅一百到一千倍，毛利冲到八十五到九十五。",
          "start": 5.977,
          "end": 10.375
        }
      ]
    },
    {
      "scene": "s18_models",
      "segment_index": 17,
      "sentences": [
        {
          "index": 0,
          "text": "技术上跑得通。",
          "start": 0.1,
          "end": 1.709
        },
        {
          "index": 1,
          "text": "轻量大模型提标书，主流大模型做分析，开源模型压成本。",
          "start": 1.659,
          "end": 6.818
        },
        {
          "index": 2,
          "text": "每次几毛到几块，一个月用上百次也才几百块。",
          "start": 6.818,
          "end": 11.318
        }
      ]
    },
    {
      "scene": "s19_pricing",
      "segment_index": 18,
      "sentences": [
        {
          "index": 0,
          "text": "钱怎么收？",
          "start": 0.1,
          "end": 1.379
        },
        {
          "index": 1,
          "text": "按投标量阶梯。",
          "start": 1.329,
          "end": 3.079
        },
        {
          "index": 2,
          "text": "基础版月费五百、十个标；专业版两千、五十个；企业版五千、无限加定制。",
          "start": 3.079,
          "end": 9.75
        },
        {
          "index": 3,
          "text": "瞄准中型公司。",
          "start": 9.75,
          "end": 11.772
        }
      ]
    },
    {
      "scene": "s20_unit_economics",
      "segment_index": 19,
      "sentences": [
        {
          "index": 0,
          "text": "这账漂亮。",
          "start": 0.1,
          "end": 1.459
        },
        {
          "index": 1,
          "text": "传统咨询毛利三十到五十，AI这套八十五到九十五。",
          "start": 1.409,
          "end": 6.181
        },
        {
          "index": 2,
          "text": "一个卖人力，一个卖软件，边际成本机乎未零。",
          "start": 6.181,
          "end": 10.693
        }
      ]
    },
    {
      "scene": "s21_revenue",
      "segment_index": 20,
      "sentences": [
        {
          "index": 0,
          "text": "增掌清晰。",
          "start": 0.1,
          "end": 1.527
        },
        {
          "index": 1,
          "text": "半年三到五个试点验证，一年半二十客户约五十万美元，三年一百多客户五百万，五年五百多家冲击两千五百万。",
          "start": 1.477,
          "end": 11.022
        }
      ]
    },
    {
      "scene": "s22_moat",
      "segment_index": 21,
      "sentences": [
        {
          "index": 0,
          "text": "护城河是数据。",
          "start": 0.1,
          "end": 1.788
        },
        {
          "index": 1,
          "text": "投标数据匿名聚合越聚越值钱，客户越多基准越准是网络效应，换平台数据带不走是切换成本，只能靠时间攒。",
          "start": 1.738,
          "end": 11.715
        }
      ]
    },
    {
      "scene": "s23_risks",
      "segment_index": 22,
      "sentences": [
        {
          "index": 0,
          "text": "风险也现实。",
          "start": 0.1,
          "end": 1.686
        },
        {
          "index": 1,
          "text": "建筑业抗拒新技术得熬，投标数据是机密得拿免费服务换，大厂还可能随时下场。",
          "start": 1.636,
          "end": 8.727
        }
      ]
    },
    {
      "scene": "s24_redlines",
      "segment_index": 23,
      "sentences": [
        {
          "index": 0,
          "text": "五条死亡红线。",
          "start": 0.1,
          "end": 1.754
        },
        {
          "index": 1,
          "text": "毛利跌破七十、月用不到五次、获客成本两年收不回、年流失超两成、半年攒不够十个客户数据。",
          "start": 1.704,
          "end": 9.875
        },
        {
          "index": 2,
          "text": "踩中就得重来。",
          "start": 9.875,
          "end": 11.863
        }
      ]
    },
    {
      "scene": "s25_phase1",
      "segment_index": 24,
      "sentences": [
        {
          "index": 0,
          "text": "落地分四步。",
          "start": 0.1,
          "end": 1.618
        },
        {
          "index": 1,
          "text": "起手半年内，挑一个细分市场搭MVP，招三到五个试点，用免费分析换数据，预算五到十五万美元，两三个人。",
          "start": 1.568,
          "end": 10.738
        }
      ]
    },
    {
      "scene": "s26_phase2",
      "segment_index": 25,
      "sentences": [
        {
          "index": 0,
          "text": "第二步六到十八个月。",
          "start": 0.1,
          "end": 2.106
        },
        {
          "index": 1,
          "text": "打磨产品，验证利润涨多少，把航业基准做成第二条产品线。",
          "start": 2.056,
          "end": 7.511
        },
        {
          "index": 2,
          "text": "目标二十客户，年收入约五十万美元。",
          "start": 7.511,
          "end": 11.17
        }
      ]
    },
    {
      "scene": "s27_phase3",
      "segment_index": 26,
      "sentences": [
        {
          "index": 0,
          "text": "第三步一年半到三年。",
          "start": 0.1,
          "end": 2.345
        },
        {
          "index": 1,
          "text": "扩两三个细分市场，自研航业模型，把投标分析做成接口接进大平台。",
          "start": 2.295,
          "end": 8.568
        },
        {
          "index": 2,
          "text": "目标一百多客户，五百万美元。",
          "start": 8.568,
          "end": 11.829
        }
      ]
    },
    {
      "scene": "s28_phase4",
      "segment_index": 27,
      "sentences": [
        {
          "index": 0,
          "text": "第四步三到五年。",
          "start": 0.1,
          "end": 1.993
        },
        {
          "index": 1,
          "text": "全国铺开，进英国澳大利亚，让基准数据成标准，反哺保险金融。",
          "start": 1.943,
          "end": 7.636
        },
        {
          "index": 2,
          "text": "目标五百多客户，两千五百万美元以上。",
          "start": 7.636,
          "end": 11.409
        }
      ]
    },
    {
      "scene": "s29_loop",
      "segment_index": 28,
      "sentences": [
        {
          "index": 0,
          "text": "绕回起点。",
          "start": 0.1,
          "end": 1.402
        },
        {
          "index": 1,
          "text": "Katerra想做建筑，倒在施工风险上。",
          "start": 1.352,
          "end": 4.556
        },
        {
          "index": 2,
          "text": "这回的答案是只做决策不碰施工，用数据壁垒把决策做到难以替代。",
          "start": 4.556,
          "end": 10.875
        }
      ]
    },
    {
      "scene": "s30_cta",
      "segment_index": 29,
      "sentences": [
        {
          "index": 0,
          "text": "十三万亿的市场，利润都藏在决策里。",
          "start": 0.1,
          "end": 3.527
        },
        {
          "index": 1,
          "text": "谁能把数据变成决策力，谁就拿到那把钥匙。",
          "start": 3.477,
          "end": 7.545
        }
      ]
    }
  ]
}