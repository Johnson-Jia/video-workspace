  "segments": [
    {
      "scene": "s1_hook",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "4万颗星，因未它让你在终端里直接看图。",
          "start": 0.1,
          "end": 3.7
        },
        {
          "index": 1,
          "text": "想看张图，还用得着切出去开软件？",
          "start": 3.65,
          "end": 6.65
        }
      ]
    },
    {
      "scene": "s2_what",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "它叫 yazi，是终端里的文件管理器。",
          "start": 0.1,
          "end": 2.93
        },
        {
          "index": 1,
          "text": "键盘上下翻文件，图片、视频、PDF、代码，全能在终端里直接预览。",
          "start": 2.88,
          "end": 8.6
        }
      ]
    },
    {
      "scene": "s3_scenarios",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "写代码随手翻文件，远程连服务器直接管，看视频看图都不用离开终端，手不离键盘。",
          "start": 0.1,
          "end": 6.71
        }
      ]
    },
    {
      "scene": "s4_audience",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "常泡终端的开发者、运维，还有 Vim 党最对它胃口。",
          "start": 0.1,
          "end": 4.08
        },
        {
          "index": 1,
          "text": "鼠标摸得少的键盘流爱好者，会爱不释手。",
          "start": 4.03,
          "end": 7.69
        }
      ]
    },
    {
      "scene": "s5_arch",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "打开源码，31个模块整整6层，层层依赖却不绕圈子。",
          "start": 0.1,
          "end": 4.91
        },
        {
          "index": 1,
          "text": "这么拆，就未改一航不用重编整个项目。",
          "start": 4.86,
          "end": 8.39
        }
      ]
    },
    {
      "scene": "s6_philosophy",
      "segment_index": 5,
      "sentences": [
        {
          "index": 0,
          "text": "更狠的是它的哲学：整个界面只跑一个线程，状态直接传递，全程零把锁。",
          "start": 0.1,
          "end": 6.09
        },
        {
          "index": 1,
          "text": "别人锁来锁去就卡，它换个思路反而丝滑。",
          "start": 6.04,
          "end": 9.55
        }
      ]
    },
    {
      "scene": "s7_tech",
      "segment_index": 6,
      "sentences": [
        {
          "index": 0,
          "text": "终端看图的难点，它用四种自研图像协议解决，还拿看不见的占位字符编码坐标。",
          "start": 0.1,
          "end": 6.22
        },
        {
          "index": 1,
          "text": "再加预加载，你没翻到的页早准备好了。",
          "start": 6.17,
          "end": 9.56
        }
      ]
    },
    {
      "scene": "s8_limits_cta",
      "segment_index": 7,
      "sentences": [
        {
          "index": 0,
          "text": "但也有短板：得跑在支持的终端，远程连服务器默认不校验身份，核心代码机乎没测试。",
          "start": 0.1,
          "end": 6.34
        },
        {
          "index": 1,
          "text": "yazi 这终端利器你站谁？",
          "start": 6.29,
          "end": 8.36
        },
        {
          "index": 2,
          "text": "关注 GitHub 星探，下期见。",
          "start": 8.36,
          "end": 10.86
        }
      ]
    }
  ]
}