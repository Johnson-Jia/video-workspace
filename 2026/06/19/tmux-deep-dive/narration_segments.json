  {
    "scene": "philosophy1",
    "type": "how",
    "estimated_duration": 12,
    "text": "tmux 最巧的地方，是同一个二进制，既是客户端，又是服务器。运行时它自己决定当哪个角色。客户端连不上，就 fork 出一个服务器守护进程，用文件锁防止重复启动。用户根本不用操心怎么启动服务。",
    "emotion": "build",
    "emotion_intensity": 0.7,
    "humor_type": "analogy",
    "character_expression": "think",
    "selling_points": null,
    "commentary": null,
    "contrarian_angle": null,
    "visual_phases": [
      {
        "focus": "一个二进制身兼 client+server",
        "visual_type": "highlight",
        "narration_anchor": {
          "start_sentence": 0,
          "end_sentence": 0
        },
        "key_data": [
          "同一个二进制",
          "client",
          "server",
          "运行时自动决定角色"
        ]
      },
      {
        "focus": "连不上就 fork server + flock 文件锁防重复",
        "visual_type": "timeline",
        "narration_anchor": {
          "start_sentence": 1,
          "end_sentence": 3
        },
        "key_data": [
          "连不上 → fork server 守护进程",
          "flock 文件锁",
          "防重复启动",
          "用户无需启动服务"
        ]
      }
    ],
