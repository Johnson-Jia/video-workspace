      "scene": "hook",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "一个人的.克劳德目录，总星十三万八，盖过众多大厂项目。",
          "start": 0.1,
          "end": 4.89
        }
      ]
    },
    {
      "scene": "skills",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "它叫skills，一位工程师公开的.克劳德技能合集，拿来即用。",
          "start": 0.1,
          "end": 4.58
        },
        {
          "index": 1,
          "text": "一个人的目录整理，十三万八千星，盖过众多大厂项目。",
          "start": 4.53,
          "end": 9.3
        }
      ]
    },
    {
      "scene": "pake",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "Pake更接地气，一条命令把网页打包成桌面应用。",
          "start": 0.1,
          "end": 3.73
        },
        {
          "index": 1,
          "text": "Rust写的，体积小、启动快，普通人开箱就能用。",
          "start": 3.68,
          "end": 7.51
        }
      ]
    },
    {
      "scene": "palmier-pro",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "palmier-pro是macOS上的视频编辑器，思路反了过来——未AI设计，把AI能力做成剪辑的主轴，普通人也能上手。",
          "start": 0.1,
          "end": 7.87
        }
      ]
    },
    {
      "scene": "headroom",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "headroom是今天的单日涨星王，一天涨三千七百多星，总星冲到四万一。",
          "start": 0.1,
          "end": 5.45
        },
        {
          "index": 1,
          "text": "它把日志、文件、检索分块送进AI前先处理一道，让模型读得更省。",
          "start": 5.4,
          "end": 11.22
        }
      ]
    },
    {
      "scene": "codebase-memory-mcp",
      "segment_index": 5,
      "sentences": [
        {
          "index": 0,
          "text": "codebase-memory-mcp给做开发的观众：整个代码库索引成可查询的图谱，一百多种语言，查询不到一毫秒，让AI不必每次虫读代码。",
          "start": 0.1,
          "end": 9.43
        }
      ]
    },
    {
      "scene": "smsforwarder",
      "segment_index": 6,
      "sentences": [
        {
          "index": 0,
          "text": "SmsForwarder更平民，一部旧安卓手机化身通知中枢，短信、验证码按规则自动转发到钉钉、飞书、邮箱。",
          "start": 0.1,
          "end": 8.4
        }
      ]
    },
    {
      "scene": "cta",
      "segment_index": 7,
      "sentences": [
        {
          "index": 0,
          "text": "Pake和palmier-pro，你更想用哪个？",
          "start": 0.1,
          "end": 2.6
        },
        {
          "index": 1,
          "text": "关注我，下期见。",
          "start": 2.55,
          "end": 4.55
        }
      ]
    }
  ]
