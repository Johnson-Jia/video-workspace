  "segments": [
    {
      "scene": "hook",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "第25周GitHub周榜，6月15到21日，有个工具把喂给大模型的内容砍掉九成多，答案还一样。",
          "start": 0.1,
          "end": 7.31
        }
      ]
    },
    {
      "scene": "ai_cost",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "冠军叫headroom，把日志和文档先压缩再喂给大模型，省六到九成五的内容，周涨一万六千星。",
          "start": 0.1,
          "end": 7.04
        },
        {
          "index": 1,
          "text": "另一个叫Agent-Reach，给AI装上眼睛，一条命令读推特、Reddit、B站，不用付接口费。",
          "start": 6.99,
          "end": 13.55
        }
      ]
    },
    {
      "scene": "ai_coding",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "给做AI编程的开发者，addyosmani的agent-skills是生产级工程技能包。",
          "start": 0.1,
          "end": 4.81
        },
        {
          "index": 1,
          "text": "DeusData的codebase-memory-mcp把整个代码库索引成知识图谱，AI几毫秒就能查，支持一百五十八种语言。",
          "start": 4.76,
          "end": 12.37
        }
      ]
    },
    {
      "scene": "ai_model_security",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "大厂也下场了。",
          "start": 0.1,
          "end": 1.6
        },
        {
          "index": 1,
          "text": "Google的timesfm是时序预测基础模型，专门预测未来。",
          "start": 1.55,
          "end": 5.6
        },
        {
          "index": 2,
          "text": "英伟达的SkillSpector扫描AI技能里的漏洞和恶意模式，给做安全开发的开发者用。",
          "start": 5.6,
          "end": 11.46
        }
      ]
    },
    {
      "scene": "ai_creative",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "创作这边，OpenMontage把AI编程助手变成视频工作室，十二条流水线五十二个工具。",
          "start": 0.1,
          "end": 6.19
        },
        {
          "index": 1,
          "text": "Astro团队出的flue是个沙箱框架，给做agent开发的开发者随便折腾。",
          "start": 6.14,
          "end": 11.26
        }
      ]
    },
    {
      "scene": "tools_for_everyone",
      "segment_index": 5,
      "sentences": [
        {
          "index": 0,
          "text": "这三个你能直接用。",
          "start": 0.1,
          "end": 1.89
        },
        {
          "index": 1,
          "text": "insomnia是免费API调试工具，支持GraphQL和REST。",
          "start": 1.84,
          "end": 5.62
        },
        {
          "index": 2,
          "text": "plane是免费版Jira平替，管任务和迭代。",
          "start": 5.62,
          "end": 8.79
        },
        {
          "index": 3,
          "text": "chatwoot是开源客服系统，在线聊天邮件全渠道。",
          "start": 8.79,
          "end": 12.51
        },
        {
          "index": 4,
          "text": "免费替代商业软件。",
          "start": 12.51,
          "end": 14.62
        }
      ]
    },
    {
      "scene": "cta",
      "segment_index": 6,
      "sentences": [
        {
          "index": 0,
          "text": "还有turso嵌入式数据库，freeCodeCamp免费学编程。",
          "start": 0.1,
          "end": 3.72
        },
        {
          "index": 1,
          "text": "这周的项目你最想尝试哪个？",
          "start": 3.67,
          "end": 6.25
        },
        {
          "index": 2,
          "text": "第25周周榜就到这，关注GitHub星探，下周见。",
          "start": 6.25,
          "end": 10.3
        }
      ]
    }
  ]
}