  "segments": [
    {
      "scene": "hook",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "AI 帮写代码，居然转身去做视频了。",
          "start": 0.1,
          "end": 3.47
        }
      ]
    },
    {
      "scene": "openmontage",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "今天涨星最猛的是 OpenMontage，单日冲上近三千星。",
          "start": 0.1,
          "end": 3.92
        },
        {
          "index": 1,
          "text": "它把AI编程助手变成了一整套视频制作工作室，12条流水线、52个工具、500多个技能，全开源。",
          "start": 3.87,
          "end": 11.39
        }
      ]
    },
    {
      "scene": "tools_local",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "想免费用设计软件，看 penpot，浏览器开箱即用，开源平替不收订阅费。",
          "start": 0.1,
          "end": 5.07
        },
        {
          "index": 1,
          "text": "要编辑PDF，Stirling-PDF 本地就能改，文件不上传云端，八万多星。",
          "start": 5.02,
          "end": 10.37
        }
      ]
    },
    {
      "scene": "gstack",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "还有个有意思的，硅谷知名投资人公开了自己的AI编程工具配置，23个工具分别当CEO、设计师、工程师。",
          "start": 0.1,
          "end": 8.11
        },
        {
          "index": 1,
          "text": "相当于把大佬的作业直接抄过来用，11万3千星。",
          "start": 8.06,
          "end": 12.21
        }
      ]
    },
    {
      "scene": "airllm_palmier",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "最反直觉的是 airllm，4G显存的破显卡，居然能跑70B顶级大模型，大象塞进小盒子。",
          "start": 0.1,
          "end": 6.79
        },
        {
          "index": 1,
          "text": "昨天讲的 palmier-pro 今天又涨了两千多星，AI做视频的工具还在加速。",
          "start": 6.74,
          "end": 12.17
        }
      ]
    },
    {
      "scene": "cta",
      "segment_index": 5,
      "sentences": [
        {
          "index": 0,
          "text": "AI做视频这个趋势，你最想试哪个？",
          "start": 0.1,
          "end": 3.05
        },
        {
          "index": 1,
          "text": "关注我，下期见。",
          "start": 3.0,
          "end": 5.0
        }
      ]
    }
  ]
}