  "segments": [
    {
      "scene": "hook",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "淘金！",
          "start": 0.1,
          "end": 1.115
        },
        {
          "index": 1,
          "text": "开淘！",
          "start": 1.065,
          "end": 2.076
        },
        {
          "index": 2,
          "text": "五千家网贷平台，国家一声令下，清零到一家不剩。",
          "start": 2.076,
          "end": 6.554
        }
      ]
    },
    {
      "scene": "what",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "今天这家叫微贷网，2011年开干的中国P2P平台，拿了1.1亿美金融资。",
          "start": 0.1,
          "end": 6.071
        },
        {
          "index": 1,
          "text": "干的活就是把想借钱的人，和想放贷赚钱的人，牵到一起抽中介费。",
          "start": 6.021,
          "end": 11.38
        },
        {
          "index": 2,
          "text": "那几年中国P2P火到五千多家平台同时跑，号称要颠覆银航做普惠金融。",
          "start": 11.38,
          "end": 17.684
        },
        {
          "index": 3,
          "text": "微贷网就是头部玩家之一。",
          "start": 17.684,
          "end": 20.51
        }
      ]
    },
    {
      "scene": "why_fail",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "可这模式天生有个致命病根，叫期限错配——拿别人的短钱放掌贷。",
          "start": 0.1,
          "end": 5.886
        },
        {
          "index": 1,
          "text": "投资者随时要提现，钱却借出去三年了，一有风吹草动大家挤兑，平台根本拿不出钱。",
          "start": 5.836,
          "end": 12.793
        },
        {
          "index": 2,
          "text": "2016年起国家系统性整治，到2020年明确下令，所有P2P要么拿银航级牌照，要么关门。",
          "start": 12.793,
          "end": 20.521
        },
        {
          "index": 3,
          "text": "雪上加霜的是，e租宝那个76亿美金的庞氏骗局一爆，投资者信心全崩，违约率从两三个点飙到将近二十个点。",
          "start": 20.521,
          "end": 29.445
        },
        {
          "index": 4,
          "text": "平台只能拿新钱填老窟窿，整个航业五千多家，清零到一家不剩。",
          "start": 29.445,
          "end": 34.902
        }
      ]
    },
    {
      "scene": "loot",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "我扒完这家，淘到一个值钱的教训——金融监管套利从来不是护城河，是定时炸弹。",
          "start": 0.1,
          "end": 6.734
        },
        {
          "index": 1,
          "text": "但我也淘到一个能偷的点子叫CreditOS：不碰放贷这条死路，给银航和持牌方卖AI风控的铲子。",
          "start": 6.684,
          "end": 14.119
        },
        {
          "index": 2,
          "text": "新兴市场银航有牌照有钱，就是没现代风控，审贷手工干的比例高达四到六成。",
          "start": 14.119,
          "end": 20.521
        },
        {
          "index": 3,
          "text": "你把风控做成API卖给他们。",
          "start": 20.521,
          "end": 23.152
        },
        {
          "index": 4,
          "text": "淘金热里咱不挖矿，咱卖铲子给持牌玩家。",
          "start": 23.152,
          "end": 27.239
        }
      ]
    },
    {
      "scene": "compare",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "同期还有家叫千和的，一亿美金融资，一模一样的死法——监管清退加庞氏化，年放贷五个多亿美金，准备金才两千万，纸糊的都算不上。",
          "start": 0.1,
          "end": 10.376
        },
        {
          "index": 1,
          "text": "所以微贷网不是个案，是整个P2P航业的结构性绝症。",
          "start": 10.326,
          "end": 15.01
        },
        {
          "index": 2,
          "text": "这个卖铲子的点子，你觉得能成吗？",
          "start": 15.01,
          "end": 18.586
        }
      ]
    }
  ]
}