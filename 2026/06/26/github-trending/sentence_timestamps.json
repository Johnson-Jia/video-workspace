  "segments": [
    {
      "scene": "hook",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "6月26日 GitHub，Google 居然给 AI 写了份说明书，单日砍下一千四百星。",
          "start": 0.1,
          "end": 5.87
        }
      ]
    },
    {
      "scene": "design_md",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "头一个，design.md，一天一千四百星。",
          "start": 0.1,
          "end": 3.35
        },
        {
          "index": 1,
          "text": "它是格式规范，给 AI 编程助手写视觉设计手册，让助手掌记性。",
          "start": 3.3,
          "end": 8.48
        },
        {
          "index": 2,
          "text": "等于给 AI 发本品牌手册。",
          "start": 8.48,
          "end": 10.88
        }
      ]
    },
    {
      "scene": "gstack",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "下一个，gstack，八百多星。",
          "start": 0.1,
          "end": 2.39
        },
        {
          "index": 1,
          "text": "Garry Tan 的,克劳德扣得,配置，一个文件给 AI 配二十三个角色：CEO、设计师、QA 全有，AI 自己组了支小团队。",
          "start": 2.34,
          "end": 10.84
        }
      ]
    },
    {
      "scene": "mineru_pageagent",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "后面这俩，一个喂 AI、一个替你点。",
          "start": 0.1,
          "end": 2.99
        },
        {
          "index": 1,
          "text": "MinerU 把 PDF 秒变成 AI 能读的 markdown，给 AI 做'预消化'。",
          "start": 2.94,
          "end": 7.68
        },
        {
          "index": 2,
          "text": "阿里 page-agent 用自然语言控制网页，AI 直接上手。",
          "start": 7.68,
          "end": 11.64
        }
      ]
    },
    {
      "scene": "trek",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "最后来个普通人能用的。",
          "start": 0.1,
          "end": 2.2
        },
        {
          "index": 1,
          "text": "TREK 自托管旅行规划，实时协作、地图、预算全有，朋友一起编行程，数据留自己服务器。",
          "start": 2.15,
          "end": 8.8
        }
      ]
    },
    {
      "scene": "cta",
      "segment_index": 5,
      "sentences": [
        {
          "index": 0,
          "text": "给 AI 写说明书、配团队、喂文档、操控网页，再加个自托管旅行——这几个你最想试哪个？",
          "start": 0.1,
          "end": 7.02
        },
        {
          "index": 1,
          "text": "关注我，下期见。",
          "start": 6.97,
          "end": 8.97
        }
      ]
    }
  ]
}