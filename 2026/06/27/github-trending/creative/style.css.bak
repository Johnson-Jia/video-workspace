:root {
  --bg-deep: #080818;
  --accent-warm: #f9a825;
  --accent-cool: #00f5d4;
  --text: #ffffff;
  --text2: rgba(255,255,255,0.6);
  --font-title: 'Inter','PingFang SC','Microsoft YaHei',sans-serif;
  --font-body: 'Noto Sans SC','PingFang SC','Microsoft YaHei',sans-serif;
  --font-data: 'JetBrains Mono','Consolas',monospace;
  --title-weight: 900;
}

/* ============================================
 * LLM 自定义组件 CSS（按场景 bg 配色 + 差异化强调色）
 * ============================================ */

/* ───────────────────────────────────────────────
 * S1 HOOK — 深蓝紫底 + 金橙暖光震撼开场
 * bg: radial_beams；fx: 中心脉冲环 + 金色射线
 * ─────────────────────────────────────────────── */
.s-hook-content {
  position: relative; z-index: 3;
  display: flex; flex-direction: column;
  justify-content: center; align-items: center;
  gap: 36px; width: 100%; height: 100%;
  text-align: center;
}
.s-hook-eyebrow {
  font-family: var(--font-data);
  font-size: 32px; font-weight: 600;
  letter-spacing: 0.32em;
  color: var(--accent-warm);
  text-transform: uppercase;
  opacity: 0.9;
}
.s-hook-title {
  font-family: var(--font-title);
  font-size: 124px; font-weight: 900;
  line-height: 1.0; letter-spacing: -0.02em;
  color: #fff;
  text-shadow: 0 0 50px rgba(249,168,37,0.45);
}
.s-hook-title .accent {
  background-image: linear-gradient(135deg, #ffe082 0%, #f9a825 45%, #ff6b35 100%);
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent; color: transparent;
}
.s-hook-keywords {
  display: flex; gap: 18px; justify-content: center; flex-wrap: wrap;
  margin-top: 12px;
}
.s-hook-kw {
  font-family: var(--font-body);
  font-size: 40px; font-weight: 700;
  padding: 14px 32px; border-radius: 999px;
  background: rgba(249,168,37,0.10);
  border: 1.5px solid rgba(249,168,37,0.45);
  color: #fff;
  letter-spacing: 0.04em;
}
.s-hook-kw.cool {
  background: rgba(0,245,212,0.10);
  border-color: rgba(0,245,212,0.45);
}
.s-hook-sub {
  font-family: var(--font-body);
  font-size: 38px; font-weight: 500;
  color: rgba(255,255,255,0.72);
  letter-spacing: 0.04em;
  margin-top: 8px;
}

/* ───────────────────────────────────────────────
 * S2 design.md — 钢蓝青调（AI 设计规范）
 * ─────────────────────────────────────────────── */

/* ───────────────────────────────────────────────
 * S3 Agent-Reach — 深紫电光蓝（AI 全网眼睛）
 * ─────────────────────────────────────────────── */

/* ───────────────────────────────────────────────
 * S4 TREK — 深青琥珀（自托管旅行，地图轨迹）
 * ─────────────────────────────────────────────── */

/* ───────────────────────────────────────────────
 * S5 MinerU — 深靛青数据（文档转 AI 格式）
 * ─────────────────────────────────────────────── */

/* ───────────────────────────────────────────────
 * S6 CasaOS — 暖琥珀（自建家庭云盘）
 * ─────────────────────────────────────────────── */

/* ───────────────────────────────────────────────
 * S7 simplex-chat + CTA — 神秘深紫（无 ID 加密聊天）
 * ─────────────────────────────────────────────── */
.s-cta-wrap {
  position: relative; z-index: 3;
  display: flex; flex-direction: column;
  justify-content: space-between;
  padding: 180px 90px 220px 90px;
  width: 100%; height: 100%;
}
.s-cta-top { display: flex; flex-direction: column; gap: 20px; }
.s-cta-rank-row { display: flex; align-items: baseline; gap: 28px; }
.s-cta-rank {
  font-family: var(--font-data);
  font-size: 88px; font-weight: 900; line-height: 0.9;
  color: var(--accent-warm);
  text-shadow: 0 0 48px rgba(249,168,37,0.5);
}
.s-cta-cat {
  font-size: 36px; font-weight: 600;
  letter-spacing: 0.10em; text-transform: uppercase;
  color: var(--accent-cool);
}
.s-cta-use {
  font-size: 50px; font-weight: 800; line-height: 1.15;
  background-image: linear-gradient(135deg, #ffe082 0%, #f9a825 50%, #ff6b35 100%);
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent; color: transparent;
  letter-spacing: 0.02em;
}
.s-cta-name {
  font-family: var(--font-data);
  font-size: 58px; font-weight: 800; color: #fff;
  word-break: break-word; text-align: center;
  line-height: 1.1; letter-spacing: -0.01em;
}
.s-cta-name .owner { font-size: 32px; font-weight: 500; color: rgba(255,255,255,0.45); }

.s-cta-mid {
  display: flex; flex-direction: column; align-items: center;
  gap: 32px;
}
.s-cta-avatar-wrap {
  position: relative; width: 220px; height: 220px;
  display: flex; align-items: center; justify-content: center;
}
.s-cta-avatar-ring {
  position: absolute; inset: -16px; border-radius: 50%;
  background: conic-gradient(from 0deg, var(--accent-warm), var(--accent-cool), var(--accent-warm));
  filter: blur(14px); opacity: 0.55;
}
.s-cta-avatar {
  position: relative; z-index: 1;
  width: 220px; height: 220px; border-radius: 50%;
  object-fit: cover; border: 3px solid rgba(255,255,255,0.85);
  box-shadow: 0 0 50px rgba(0,0,0,0.5);
}
.s-cta-three {
  display: flex; flex-direction: column; gap: 14px;
  font-family: var(--font-body); font-size: 44px; font-weight: 700;
  color: #fff; text-align: center; line-height: 1.25;
}
.s-cta-three .strike { text-decoration: line-through; text-decoration-color: rgba(255,90,90,0.7); text-decoration-thickness: 4px; color: rgba(255,255,255,0.55); }
.s-cta-three .also { color: rgba(255,255,255,0.55); }
.s-cta-three .final {
  background-image: linear-gradient(135deg, #ffe082 0%, #f9a825 60%, #ff6b35 100%);
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent; color: transparent;
}

.s-cta-bottom { display: flex; flex-direction: column; gap: 24px; }
.s-cta-question {
  font-family: var(--font-title);
  font-size: 60px; font-weight: 900; line-height: 1.2;
  text-align: center; color: #fff;
  text-shadow: 0 0 30px rgba(0,245,212,0.4);
}
.s-cta-question .grad {
  background-image: linear-gradient(90deg, #00f5d4 0%, #f9a825 100%);
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent; color: transparent;
}
.s-cta-follow {
  font-family: var(--font-body);
  font-size: 34px; font-weight: 600;
  text-align: center; color: rgba(255,255,255,0.7);
  letter-spacing: 0.08em;
}

/* ───────────────────────────────────────────────
 * ProjectFullCard 场景级配色覆盖（每个项目独立强调色）
 * 通过 .scene-specific 类切换 --accent-warm/--accent-cool
 * ─────────────────────────────────────────────── */
.pfc-scene-design { --accent-warm: #4DA8DA; --accent-cool: #00f5d4; }   /* 钢蓝青 — AI 设计规范 */
.pfc-scene-agent  { --accent-warm: #7B61FF; --accent-cool: #00E5FF; }   /* 电光紫 — AI 全网 */
.pfc-scene-trek   { --accent-warm: #FFB300; --accent-cool: #2EE6A8; }   /* 琥珀翠 — 旅行 */
.pfc-scene-mineru { --accent-warm: #8B5CF6; --accent-cool: #22D3EE; }   /* 靛紫青 — 文档处理 */
.pfc-scene-casa   { --accent-warm: #FF8C32; --accent-cool: #FFC36B; }   /* 暖橙 — 家庭云 */
.pfc-scene-simplex{ --accent-warm: #f9a825; --accent-cool: #00f5d4; }   /* 金青 — 隐私 */

/* ============================================
 * ProjectFullCard 布局 + 强色规范
 * 三带 space-between：顶带(rank+use) / 中带(name+avatar+desc) / 底带(stars)。
 * 项目名与头像同在中带 gap 28px 紧贴，消除了原两带 30% 大空白断层。
 * 强色：use 胶囊(强调色底+深色字) / star 数字(强调色大字) /
 *       repo(场景渐变) / desc(暗白让位星标)
 * ============================================ */
.layer-content .project-full-card {
  position: relative; z-index: 3;
  width: 100%; height: 100%;
  display: flex; flex-direction: column;
  justify-content: space-between;   /* 三带撑满 1920，无中间断层 */
}
.pfc-glow {
  position: absolute; border-radius: 50%; filter: blur(150px);
  pointer-events: none; z-index: 0;
}
.pfc-glow-warm {
  width: 520px; height: 520px; opacity: 0.20;
  background: var(--accent-warm);
  top: 200px; left: -120px;
}
.pfc-glow-cool {
  width: 460px; height: 460px; opacity: 0.18;
  background: var(--accent-cool);
  bottom: 320px; right: -100px;
}
.pfc-grid {
  position: absolute; inset: 0; z-index: 0;
  background-image:
    linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px);
  background-size: 44px 44px; pointer-events: none;
}

/* ── 顶带：排名（强调色小字）+ 用途胶囊 ── */
.pfc-top {
  position: relative; z-index: 2;
  display: flex; flex-direction: column; gap: 20px;
  width: 100%;
}
.pfc-rank {
  font-family: 'JetBrains Mono', monospace;
  font-size: 56px; font-weight: 800; line-height: 0.9;
  color: var(--accent-warm);
  letter-spacing: 0.02em;
  text-shadow: 0 0 24px var(--accent-warm);
  opacity: 0.92;
}
/* 用途标签：强调色胶囊底 + 深色字（醒目，自带头部锚点） */
.pfc-use {
  align-self: flex-start;
  font-family: 'Noto Sans SC', sans-serif;
  font-size: 40px; font-weight: 800; line-height: 1.1;
  padding: 14px 34px; border-radius: 999px;
  background: var(--accent-warm);
  color: #0a0a18;
  letter-spacing: 0.02em;
  box-shadow: 0 10px 30px rgba(0,0,0,0.45), 0 0 24px var(--accent-warm);
}
/* 项目名：owner 小字灰 / repo 场景渐变大字（独占行 width:100% 居中） */
.pfc-name {
  width: 100%; text-align: center;
  font-family: 'JetBrains Mono', monospace;
  line-height: 1.08; letter-spacing: -0.01em;
  word-break: break-word;
  display: flex; flex-wrap: wrap; justify-content: center; align-items: baseline; gap: 14px;
}
.pfc-owner {
  font-size: 34px; font-weight: 500;
  color: rgba(255,255,255,0.55);
  letter-spacing: 0.04em;
}
.pfc-repo {
  font-size: 64px; font-weight: 800;
  background-image: linear-gradient(135deg,
    var(--accent-warm) 0%,
    var(--accent-cool) 100%);
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent; color: transparent;
  /* 渐变文字 text-shadow 用同色系（accent-cool 半透），禁黑色（gate R-S6-023） */
  text-shadow: 0 0 28px var(--accent-cool);
  filter: drop-shadow(0 0 16px var(--accent-cool));
}

/* ── 中带：项目名 + avatar 锚点 + 描述（项目名紧贴头像，gap 28px）── */
.pfc-mid {
  position: relative; z-index: 2;
  display: flex; flex-direction: column; align-items: center;
  gap: 28px; width: 100%;
}
.pfc-avatar-wrap {
  position: relative;
  width: 240px; height: 240px;
  display: flex; align-items: center; justify-content: center;
}
.pfc-avatar-ring {
  position: absolute; inset: -18px;
  border-radius: 50%;
  background: conic-gradient(from 0deg, var(--accent-warm), var(--accent-cool), var(--accent-warm));
  filter: blur(16px); opacity: 0.5;
}
.pfc-avatar {
  position: relative; z-index: 1;
  width: 240px; height: 240px;
  border-radius: 50%; object-fit: cover;
  border: 3px solid rgba(255,255,255,0.85);
  box-shadow: 0 0 50px rgba(0,0,0,0.5);
}
/* 描述：暗白让位星标，1 句精简（无 text-shadow，避免渐变同文件误判 R-S6-023） */
.pfc-desc {
  font-family: 'Noto Sans SC', sans-serif;
  font-size: 42px; font-weight: 600; line-height: 1.35;
  color: rgba(255,255,255,0.85);
  text-align: center; max-width: 820px;
}
/* ── 底带：星标数据焦点（强调色大字 + 标签）── */
.pfc-bottom {
  position: relative; z-index: 2;
  display: flex; flex-direction: column; align-items: center;
  gap: 10px; width: 100%;
}
/* 星标：今日涨星大字（强调色 92px 最突出） + 标签（暗白小字） */
.pfc-stars {
  display: flex; flex-direction: column; align-items: center; gap: 10px;
}
.pfc-star-today {
  font-family: 'JetBrains Mono', monospace;
  font-size: 92px; font-weight: 900; line-height: 1.0;
  color: var(--accent-warm);
  letter-spacing: -0.02em;
  text-shadow: 0 0 40px var(--accent-warm);
}
.pfc-star-label {
  font-family: 'Noto Sans SC', sans-serif;
  font-size: 34px; font-weight: 600;
  color: rgba(255,255,255,0.72);
  letter-spacing: 0.06em;
}
