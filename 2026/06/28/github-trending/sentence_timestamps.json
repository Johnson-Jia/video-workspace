  "segments": [
    {
      "scene": "hook",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "开源自动驾驶，装了三百多款车。",
          "start": 0.1,
          "end": 2.82
        },
        {
          "index": 1,
          "text": "还有个 AI，能记住你说过的每句话，另一个能把文档秒变 PPT。",
          "start": 2.77,
          "end": 7.45
        },
        {
          "index": 2,
          "text": "今天 GitHub 这几个，挺有意思。",
          "start": 7.45,
          "end": 10.4
        }
      ]
    },
    {
      "scene": "cognee",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "先看 cognee，给 AI 装上跨会话的常期记忆。",
          "start": 0.1,
          "end": 3.62
        },
        {
          "index": 1,
          "text": "普通 AI 你说一句它忘一句，cognee 帮它建个自托管的知识图谱，记住你之前聊过啥。",
          "start": 3.57,
          "end": 9.36
        },
        {
          "index": 2,
          "text": "今天涨了八百多星，做 AI 应用的开发者挺关注。",
          "start": 9.36,
          "end": 13.04
        }
      ]
    },
    {
      "scene": "ppt-master",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "再看 ppt-master，丢份文档进去，AI 直接生成能编辑的 PPT。",
          "start": 0.1,
          "end": 4.58
        },
        {
          "index": 1,
          "text": "不是截图那种，是真 PPT，形状动画都保留，语音备注还能自动念出来，连你自己的模板都能套。",
          "start": 4.53,
          "end": 11.31
        },
        {
          "index": 2,
          "text": "今天涨了五百多星，做汇报的人估计会喜欢。",
          "start": 11.31,
          "end": 14.97
        }
      ]
    },
    {
      "scene": "openpilot",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "接着 openpilot，这个最反直觉。",
          "start": 0.1,
          "end": 2.71
        },
        {
          "index": 1,
          "text": "开源的驾驶辅助系统，已经能装进三百多款车。",
          "start": 2.66,
          "end": 6.34
        },
        {
          "index": 2,
          "text": "不用等车企慢慢更新，自己就能给老车升级。",
          "start": 6.34,
          "end": 9.46
        },
        {
          "index": 3,
          "text": "六万多星，fork 一万多，玩自动驾驶的机乎都知道它，今天又涨了三百多星。",
          "start": 9.46,
          "end": 15.25
        }
      ]
    },
    {
      "scene": "open-seo",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "还有 open-seo，付费 SEO 工具的开源替代。",
          "start": 0.1,
          "end": 3.24
        },
        {
          "index": 1,
          "text": "一年几千块的订阅费省了，做网站运营的人可以试试。",
          "start": 3.19,
          "end": 6.98
        },
        {
          "index": 2,
          "text": "三千多星，今天涨了两百多，体量小但方向挺实用。",
          "start": 6.98,
          "end": 11.18
        }
      ]
    },
    {
      "scene": "powertoys_cta",
      "segment_index": 5,
      "sentences": [
        {
          "index": 0,
          "text": "最后 PowerToys，微软官方的 Windows 增强工具集，十三万星的老牌项目，快速带过。",
          "start": 0.1,
          "end": 6.26
        },
        {
          "index": 1,
          "text": "让 AI 记住你、还是让 AI 做 PPT，你最想试试哪个？",
          "start": 6.21,
          "end": 10.14
        },
        {
          "index": 2,
          "text": "关注我，下期见。",
          "start": 10.14,
          "end": 12.14
        }
      ]
    }
  ]
}