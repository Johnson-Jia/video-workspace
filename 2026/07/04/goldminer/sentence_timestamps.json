  "segments": [
    {
      "scene": "hook",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "淘金！",
          "start": 0.1,
          "end": 1.115
        },
        {
          "index": 1,
          "text": "开淘！",
          "start": 1.065,
          "end": 2.076
        },
        {
          "index": 2,
          "text": "三亿美金烧光，自动驾驶卡车没等到天亮。",
          "start": 2.076,
          "end": 5.902
        },
        {
          "index": 3,
          "text": "技术没错，钱熬不到——这才是深科技最贵的教训。",
          "start": 5.902,
          "end": 10.326
        }
      ]
    },
    {
      "scene": "what",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "今天扒一家美国公司，Embark Trucks，让卡车自己跑常途。",
          "start": 0.1,
          "end": 4.376
        },
        {
          "index": 1,
          "text": "八千亿美金的美国卡车业，缺司机，人工还涨了两成五。",
          "start": 4.326,
          "end": 8.804
        },
        {
          "index": 2,
          "text": "融了三点一七亿美金，二零二一年借壳上市，估值五十二亿。",
          "start": 8.804,
          "end": 13.641
        },
        {
          "index": 3,
          "text": "今天呢？",
          "start": 13.641,
          "end": 14.793
        },
        {
          "index": 4,
          "text": "停业清盘，IP 卖了不到五千万，投资人亏九成九。",
          "start": 14.793,
          "end": 19.467
        }
      ]
    },
    {
      "scene": "why_fail",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "未什么死？",
          "start": 0.1,
          "end": 1.354
        },
        {
          "index": 1,
          "text": "根子就两条。",
          "start": 1.304,
          "end": 2.728
        },
        {
          "index": 2,
          "text": "一条是深科技熬不到成熟。",
          "start": 2.728,
          "end": 5.184
        },
        {
          "index": 3,
          "text": "L4 自动驾驶比当年炒的难太多——施工区、暴风雨、传感器失灵，常尾场景要的数据是指数级的。",
          "start": 5.184,
          "end": 12.836
        },
        {
          "index": 4,
          "text": "一年烧一亿美金研发，收入还是试点级。",
          "start": 12.836,
          "end": 15.978
        },
        {
          "index": 5,
          "text": "技术要七到十年，公开市场只给三到五年。",
          "start": 15.978,
          "end": 19.706
        },
        {
          "index": 6,
          "text": "另一条，借壳上市锁死了它。",
          "start": 19.706,
          "end": 22.554
        },
        {
          "index": 7,
          "text": "私下公司钱烧完能桥接融资，公开市场不行——季度审视、股价从十块跌到一块、现金剩五千万。",
          "start": 22.554,
          "end": 30.217
        },
        {
          "index": 8,
          "text": "想熬五年等监管？",
          "start": 30.217,
          "end": 32.108
        },
        {
          "index": 9,
          "text": "没机会。",
          "start": 32.108,
          "end": 33.152
        },
        {
          "index": 10,
          "text": "这就是 SPAC 的定时炸弹。",
          "start": 33.152,
          "end": 35.826
        }
      ]
    },
    {
      "scene": "loot",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "淘什么？",
          "start": 0.1,
          "end": 1.136
        },
        {
          "index": 1,
          "text": "我淘到两个。",
          "start": 1.086,
          "end": 2.586
        },
        {
          "index": 2,
          "text": "教训一条：深科技不是 SaaS，要七到十年资本计划。",
          "start": 2.586,
          "end": 6.782
        },
        {
          "index": 3,
          "text": "拿不到五亿美金耐心资本，就别早上市。",
          "start": 6.782,
          "end": 10.13
        },
        {
          "index": 4,
          "text": "可偷的点子更值钱，我给它起名 HaulOS——别跟巨头抢公路，转去采矿、港口、大农场这些围栏场景。",
          "start": 10.13,
          "end": 17.739
        },
        {
          "index": 5,
          "text": "八十亿美金市场，路线预设、没行人，监管快五倍，技术低十倍。",
          "start": 17.739,
          "end": 23.173
        },
        {
          "index": 6,
          "text": "先在围栏跑通单位经济，再往外扩。",
          "start": 23.173,
          "end": 26.467
        },
        {
          "index": 7,
          "text": "这是 Embark 重做的正确姿势。",
          "start": 26.467,
          "end": 29.217
        }
      ]
    },
    {
      "scene": "compare",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "Embark 不是孤例。",
          "start": 0.1,
          "end": 1.756
        },
        {
          "index": 1,
          "text": "Plenty 室内农业、K-Scale 还有 Shape Robotics 机器人，都是硬科技烧光，钱熬不到。",
          "start": 1.706,
          "end": 7.5
        },
        {
          "index": 2,
          "text": "深科技这条赛道，你敢投吗？",
          "start": 7.5,
          "end": 10.293
        },
        {
          "index": 3,
          "text": "谁的钱能熬十年？",
          "start": 10.293,
          "end": 12.239
        },
        {
          "index": 4,
          "text": "留言聊聊。",
          "start": 12.239,
          "end": 13.739
        }
      ]
    }
  ]
}