      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "这一段快速过一下教程自带的 5 个可运行 demo。",
          "start": 0.1,
          "end": 4.3
        },
        {
          "index": 1,
          "text": "每个都自包含——自带 README、依赖、源码、示例数据，开箱即跑，不是空谈。",
          "start": 4.25,
          "end": 11.9
        }
      ]
    },
    {
      "scene": "seg2",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "先看 ai-test-frame，最小可运行的 AI 自动化测试框架。",
          "start": 0.1,
          "end": 5.387
        },
        {
          "index": 1,
          "text": "核心思想是「录制操作、AI 生成测试类」——AI 在编码期生成测试资产，运行期确定性执行。",
          "start": 5.337,
          "end": 13.4
        },
        {
          "index": 2,
          "text": "架构上五个模块：注册中心装饰器注册、软断言失败不中断、测试基类通用定位、运行器调度用例、操作处理器对应每种操作。",
          "start": 13.4,
          "end": 25.05
        },
        {
          "index": 3,
          "text": "自带一个极简商品管理页做被测对象，python main.py 即跑，终端输出通过失败汇总。",
          "start": 25.05,
          "end": 33.0
        }
      ]
    },
    {
      "scene": "seg3",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "再看 ai-metrics，这是重头戏。",
          "start": 0.1,
          "end": 2.975
        },
        {
          "index": 1,
          "text": "AI 代码占比度量，亮点在三层识别算法——只靠 Co-authored-by 不够，会被误标，所以加了一层风格计量学反伪造。",
          "start": 2.925,
          "end": 12.125
        },
        {
          "index": 2,
          "text": "首层 Co-authored-by 初筛，commit message 含 AI 工具名判 AI；中层风格学复核，算代码与作者本人风格画像的余弦相似度，像本人可能误标就降置信度，不像本人确认 AI；末层注册表兜底组合判定。",
          "start": 12.125,
          "end": 28.85
        },
        {
          "index": 3,
          "text": "还能导 Excel 做提效同比，2025 基线对 2026 AI 推行后。",
          "start": 28.85,
          "end": 34.887
        }
      ]
    },
    {
      "scene": "seg4",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "第三个 report-templates，5 类汇报材料的 Prompt 模板包。",
          "start": 0.1,
          "end": 4.687
        },
        {
          "index": 1,
          "text": "战略汇报 PPT、转型计划书、周报、阶段总结、效果度量报告——复制 prompt 填数据，发给任意 AI 生成 Markdown，PPT 类还能用 ppt-master 渲染成原生可编辑 PPTX。",
          "start": 4.637,
          "end": 19.25
        },
        {
          "index": 2,
          "text": "没有真实数据也能先用占位跑通，30 秒拿一份汇报。",
          "start": 19.25,
          "end": 24.725
        }
      ]
    },
    {
      "scene": "seg5",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "第四个 role-handbooks，4 份角色操作手册。",
          "start": 0.1,
          "end": 3.787
        },
        {
          "index": 1,
          "text": "开发、测试、组掌、产品各一份，每份含角色定位、核心任务、怎么做、工具箱、检查清单、常见坑六部分。",
          "start": 3.737,
          "end": 14.037
        },
        {
          "index": 2,
          "text": "各级人员拿自己那份照做，可单独打包分发。",
          "start": 14.037,
          "end": 18.462
        }
      ]
    },
    {
      "scene": "seg6",
      "segment_index": 5,
      "sentences": [
        {
          "index": 0,
          "text": "第五个,克劳德-skills，4 个,克劳德扣得 skill 加 12 份团队规范。",
          "start": 0.1,
          "end": 6.375
