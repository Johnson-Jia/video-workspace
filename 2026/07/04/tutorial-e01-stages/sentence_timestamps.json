{
  "meta": {
    "voice": "zh-CN-YunjianNeural",
    "rate": "+0%",
    "source": "edge-tts-srt"
  },
  "segments": [
    {
      "scene": "seg1",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "这一段讲 7 阶段方法论。",
          "start": 0.1,
          "end": 2.65
        },
        {
          "index": 1,
          "text": "先看一张全景图——总纲是思想地基，6 个实施阶段从战略启动、全员赋能，一路到基础设施、闭环试点、推广度量、沉淀复用。",
          "start": 2.6,
          "end": 14.637
        },
        {
          "index": 2,
          "text": "每一步都带着可运行的 demo 和真实团队数据，不是空讲。",
          "start": 14.637,
          "end": 20.05
        }
      ]
    },
    {
      "scene": "seg2",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "先讲阶段 0，总纲。",
          "start": 0.1,
          "end": 2.512
        },
        {
          "index": 1,
          "text": "转型的前提是人的转型。",
          "start": 2.462,
          "end": 5.162
        },
        {
          "index": 2,
          "text": "AI 能扩展人的能力边界，但它不是万能——最终依赖使用人的能力边界。",
          "start": 5.162,
          "end": 11.387
        },
        {
          "index": 3,
          "text": "所以起手不是上工具，是先转型思想加懂原理：先拥抱 AI，再理解它怎么运作，才能精准下达指令。",
          "start": 11.387,
          "end": 20.575
        },
        {
          "index": 4,
          "text": "记住一句，人加 AI，人是根本。",
          "start": 20.575,
          "end": 24.212
        }
      ]
    },
    {
      "scene": "seg3",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "再说阶段 1，战略启动。",
          "start": 0.1,
          "end": 2.825
        },
        {
          "index": 1,
          "text": "这是 Leader 的主战场。",
          "start": 2.775,
          "end": 4.912
        },
        {
          "index": 2,
          "text": "要回答老板三个问题——要多少钱、多久回本、失败了怎么办。",
          "start": 4.912,
          "end": 10.525
        },
        {
          "index": 3,
          "text": "预算算清工具、培训、基础设施、推广四块成本，回本用 ROI 公式估算，航业常见三到六个月回本。",
          "start": 10.525,
          "end": 19.8
        },
        {
          "index": 4,
          "text": "失败就讲试点可控、可止损、沉没成本低。",
          "start": 19.8,
          "end": 24.562
        },
        {
          "index": 5,
          "text": "把试点验证加可止损讲清，比承诺数字更扎实。",
          "start": 24.562,
          "end": 29.925
        }
      ]
    },
    {
      "scene": "seg4",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "阶段 2，全员赋能。",
          "start": 0.1,
          "end": 2.5
        },
        {
          "index": 1,
          "text": "三件事——选对工具、培训到百分之百覆盖、规范资产化。",
          "start": 2.45,
          "end": 8.2
        },
        {
          "index": 2,
          "text": "开发者首选,克劳德扣得，终端原生、自主执行；产品经理和非开发用 OpenAI Codex，云端委托不碰终端。",
          "start": 8.2,
          "end": 17.975
        },
        {
          "index": 3,
          "text": "再把团队规范写进,克劳德.md、Skills、Hooks，提交进仓库——让规范变成 AI 能读的资产。",
          "start": 17.975,
          "end": 26.75
        }
      ]
    },
    {
      "scene": "seg5",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "阶段 3，基础设施。",
          "start": 0.1,
          "end": 2.425
        },
        {
          "index": 1,
          "text": "业务知识 RAG、代码知识图谱、Skill 仓库、MCP 网关，让 AI 从概率性盲读升级未确定性查证。",
          "start": 2.375,
          "end": 11.7
        },
        {
          "index": 2,
          "text": "但这套是未大代码库、复杂业务准备的。",
          "start": 11.7,
          "end": 15.8
        },
        {
          "index": 3,
          "text": "小团队、单仓库、几万航内——直接跳过，用,克劳德.md 加 grep 就够，强行建是过度工程。",
          "start": 15.8,
          "end": 24.787
        }
      ]
    },
    {
      "scene": "seg6",
      "segment_index": 5,
      "sentences": [
        {
          "index": 0,
          "text": "阶段 4，闭环试点，这是核心。",
          "start": 0.1,
          "end": 3.287
        },
        {
          "index": 1,
          "text": "单点用 AI 容易，难的是把需求到交付串成端到端跑、还能断点续传的流水线。",
          "start": 3.237,
          "end": 11.05
        },
        {
          "index": 2,
          "text": "用 OpenSpec 管规范，管做什么和未什么；Superpowers 管执行，管怎么做。",
          "start": 11.05,
          "end": 17.175
        },
        {
          "index": 3,
          "text": "配合 spec、plan、tasks 三产物，把发现需求偏差的成本从改代码左移到改 Markdown——便宜一个数量级。",
          "start": 17.175,
          "end": 26.25
        }
      ]
    },
    {
      "scene": "seg7",
      "segment_index": 6,
      "sentences": [
        {
          "index": 0,
          "text": "阶段 5，推广度量。",
          "start": 0.1,
          "end": 2.487
        },
        {
          "index": 1,
          "text": "试点跑通了，要放大加证伪。",
          "start": 2.437,
          "end": 5.512
        },
        {
          "index": 2,
          "text": "多 Agent 并行把单点提效放大到全员，度量用 AI 代码占比——通过 Git 提交元数据识别，再加风格学复核防伪造。",
          "start": 5.512,
          "end": 15.787
        },
        {
          "index": 3,
          "text": "最怕的状态是大家觉得有用但说不清提升了多少——那投入就没法持续。",
          "start": 15.787,
          "end": 22.325
        },
        {
          "index": 4,
          "text": "度量要让数据说话，不是感觉有用。",
          "start": 22.325,
          "end": 26.05
        }
      ]
    },
    {
      "scene": "seg8",
      "segment_index": 7,
      "sentences": [
        {
          "index": 0,
          "text": "最后阶段 6，沉淀复用。",
          "start": 0.1,
          "end": 2.862
        },
        {
          "index": 1,
          "text": "把个体经验变成组织资产。",
          "start": 2.812,
          "end": 5.875
        },
        {
          "index": 2,
          "text": "能力固化成 Skill 范式，规范和避坑写进规则文件让 AI 自动加载，把犯错变成自我改进。",
          "start": 5.875,
          "end": 13.925
        },
        {
          "index": 3,
          "text": "这是转型从一次性项目变成持续进化能力的关键——人走了，经验留下来。",
          "start": 13.925,
          "end": 21.0
        }
      ]
    }
  ]
}