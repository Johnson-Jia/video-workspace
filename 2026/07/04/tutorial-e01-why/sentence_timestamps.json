  "meta": {
    "voice": "zh-CN-YunjianNeural",
    "rate": "+0%",
    "source": "edge-tts-srt"
  },
  "segments": [
    {
      "scene": "seg1",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "先讲未什么必须转型。",
          "start": 0.1,
          "end": 2.512
        },
        {
          "index": 1,
          "text": "一句话——不转型，不是维持现状，是相对落后。",
          "start": 2.462,
          "end": 7.362
        }
      ]
    },
    {
      "scene": "seg2",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "AI 不是噱头，不是锦上添花的工具。",
          "start": 0.1,
          "end": 3.487
        },
        {
          "index": 1,
          "text": "它是研发生产关系的重写。",
          "start": 3.437,
          "end": 6.062
        },
        {
          "index": 2,
          "text": "先动的人，用同样的人数，能产出 2 倍的代码。",
          "start": 6.062,
          "end": 10.825
        },
        {
          "index": 3,
          "text": "这是相关性、不是因果——不能 100% 归功 AI，但先动者确实拉开了身位。",
          "start": 10.825,
          "end": 18.262
        }
      ]
    },
    {
      "scene": "seg3",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "不光研发团队的事。",
          "start": 0.1,
          "end": 2.175
        },
        {
          "index": 1,
          "text": "传统软件巨头——做 CRM、做 SaaS 的那批——正因 AI 颠覆其模式而估值承压。",
          "start": 2.125,
          "end": 9.562
        },
        {
          "index": 2,
          "text": "AI 不再是「要不要用」的问题，是「不用就被重写」的变量。",
          "start": 9.562,
          "end": 14.037
        },
        {
          "index": 3,
          "text": "别人用 AI 提效，你原地不动，半年后差距就是数量级的。",
          "start": 14.037,
          "end": 19.575
        }
      ]
    },
    {
      "scene": "seg4",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "但有两个极端，都要避免。",
          "start": 0.1,
          "end": 2.875
        },
        {
          "index": 1,
          "text": "一端是抗拒 AI——觉得是噱头、怕被替代，碰都不碰，结果被时代抛下；不是 AI 替代你，是用 AI 的人替代你。",
          "start": 2.825,
          "end": 12.662
        },
        {
          "index": 2,
          "text": "另一端是盲目崇拜——觉得它万能、全盘交付不验证，产出不可控、质量崩塌。",
          "start": 12.662,
          "end": 20.162
        }
      ]
    },
    {
      "scene": "seg5",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "那正确姿态是什么？",
          "start": 0.1,
          "end": 2.312
        },
        {
          "index": 1,
          "text": "拥抱，加验证——信任，但验证。",
          "start": 2.262,
          "end": 6.1
        },
        {
          "index": 2,
          "text": "把 AI 当一个不知疲倦、但会犯错的资深实习生：委派任务，但审查它的产出。",
          "start": 6.1,
          "end": 13.412
        },
        {
          "index": 3,
          "text": "它能放大一个懂业务、懂原理的人十倍；对一个不懂的人，产出再多也用不对。",
          "start": 13.412,
          "end": 20.775
        }
      ]
    },
    {
      "scene": "seg6",
      "segment_index": 5,
      "sentences": [
        {
          "index": 0,
          "text": "记住一句：AI 扩展的是「会用 AI 的人」的能力边界。",
          "start": 0.1,
          "end": 4.612
        },
        {
          "index": 1,
          "text": "人的能力边界，决定了 AI 产出的上限。",
          "start": 4.562,
          "end": 8.437
        },
        {
          "index": 2,
          "text": "人加 AI，人是根本。",
          "start": 8.437,
          "end": 11.112
        }
      ]
    }
  ]
}