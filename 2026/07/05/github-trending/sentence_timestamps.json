  "segments": [
    {
      "scene": "s1",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "让AI学山顶洞人，token省六成",
          "start": 0.1,
          "end": 3.12
        }
      ]
    },
    {
      "scene": "s2",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "先看caveman，让AI像山顶洞人一样简短说话，token消耗直接砍掉六成五。",
          "start": 0.1,
          "end": 5.69
        },
        {
          "index": 1,
          "text": "八万多颗星还在涨，开发者用脚投票，省下来的都是真金白银。",
          "start": 5.64,
          "end": 10.72
        }
      ]
    },
    {
      "scene": "s3",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "再看page-agent，浏览器里的一句话图形助手。",
          "start": 0.1,
          "end": 3.39
        },
        {
          "index": 1,
          "text": "不用写脚本，直接用自然语言指挥它点页面、填表单，普通人也能上手。",
          "start": 3.34,
          "end": 8.91
        }
      ]
    },
    {
      "scene": "s4",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "接着看meetily，会议纪要的全本地处理。",
          "start": 0.1,
          "end": 2.99
        },
        {
          "index": 1,
          "text": "转写、摘要全部在电脑里跑完，录音不出本地一步。",
          "start": 2.94,
          "end": 7.35
        },
        {
          "index": 2,
          "text": "Rust写的，四倍速转写，隐私敏感会议也能安心用。",
          "start": 7.35,
          "end": 11.68
        }
      ]
    },
    {
      "scene": "s5",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "然后是romm，自托管的ROM管理器。",
          "start": 0.1,
          "end": 2.97
        },
        {
          "index": 1,
          "text": "Docker一键部署，给老游戏玩家一个自己的游戏库，不交给云盘。",
          "start": 2.92,
          "end": 7.65
        }
      ]
    },
    {
      "scene": "s6",
      "segment_index": 5,
      "sentences": [
        {
          "index": 0,
          "text": "还有herdr，终端里的agent多路复用器。",
          "start": 0.1,
          "end": 2.98
        },
        {
          "index": 1,
          "text": "一个窗口同时管多个AI协作者，像tmux之于终端，但给agent用。",
          "start": 2.93,
          "end": 8.01
        },
        {
          "index": 2,
          "text": "给做自动化的开发者。",
          "start": 8.01,
          "end": 10.12
        }
      ]
    },
    {
      "scene": "s7",
      "segment_index": 6,
      "sentences": [
        {
          "index": 0,
          "text": "最后是terax-ai，只有7MB的AI原生开发工作区。",
          "start": 0.1,
          "end": 4.0
        },
        {
          "index": 1,
          "text": "终端优先，Tauri打造，轻到反潮流。",
          "start": 3.95,
          "end": 6.83
        },
        {
          "index": 2,
          "text": "这几个你最想用哪个，关注我下期见。",
          "start": 6.83,
          "end": 10.14
        }
      ]
    }
  ]
}