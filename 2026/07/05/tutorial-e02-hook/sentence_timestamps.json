          "end": 14.2
        }
      ]
    },
    {
      "scene": "seg2",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "但它能放大一个会用的人十倍。",
          "start": 0.1,
          "end": 2.962
        },
        {
          "index": 1,
          "text": "差别在哪？",
          "start": 2.912,
          "end": 4.55
        },
        {
          "index": 2,
          "text": "就在这集讲的——思想转变，加五条 AI 原理。",
          "start": 4.55,
          "end": 9.337
        },
        {
          "index": 3,
          "text": "AI 转型的起手，不是上工具，是先过这一关。",
