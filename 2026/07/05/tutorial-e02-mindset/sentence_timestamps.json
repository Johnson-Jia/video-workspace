  "segments": [
    {
      "scene": "seg1",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "转型里最容易栽的两个坑，刚好是两个极端。",
          "start": 0.1,
          "end": 4.262
        },
        {
          "index": 1,
          "text": "一端是抗拒——觉得 AI 是噱头、怕被替代，碰都不碰。",
          "start": 4.212,
          "end": 9.612
        },
        {
          "index": 2,
          "text": "半年后回头发现，不是 AI 替代了你，是会用 AI 的人替代了你——差距是数量级的。",
          "start": 9.612,
          "end": 16.787
        },
        {
          "index": 3,
          "text": "另一端是盲目崇拜——觉得它万能，全盘交付不验证，产出不可控、质量崩塌。",
          "start": 16.787,
          "end": 23.987
        },
        {
          "index": 4,
          "text": "正确姿态四个字：拥抱，加验证。",
          "start": 23.987,
          "end": 27.8
        },
        {
          "index": 5,
          "text": "把 AI 当一个不知疲倦但会犯错的资深实习生——委派任务，但审查产出。",
          "start": 27.8,
          "end": 34.65
        },
        {
          "index": 6,
          "text": "信任，但验证。",
          "start": 34.65,
          "end": 36.837
        },
        {
          "index": 7,
          "text": "光有态度不够——得懂它怎么运作，才能精准驾驭。",
          "start": 36.837,
          "end": 42.15
        }
      ]
    }
  ]
}