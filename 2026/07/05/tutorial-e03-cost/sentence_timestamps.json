      "sentences": [
        {
          "index": 0,
          "text": "目标定了，立项要算清要多少钱。",
          "start": 0.1,
          "end": 3.275
        },
        {
          "index": 1,
          "text": "成本分四块。",
          "start": 3.225,
          "end": 5.0
        },
        {
          "index": 2,
          "text": "其一，工具和 API——人均月费乘人数乘月数，克劳德扣得,订阅或模型调用。",
          "start": 5.0,
          "end": 12.462
        },
        {
          "index": 3,
          "text": "其二，培训——2 天全员脱产加讲师，工时成本。",
          "start": 12.462,
          "end": 17.575
        },
        {
          "index": 4,
          "text": "其三，基础设施——大团队要 RAG、知识图谱服务器加架构师。",
          "start": 17.575,
          "end": 23.362
        },
        {
          "index": 5,
          "text": "小团队可跳过。",
          "start": 23.362,
          "end": 25.312
        },
        {
          "index": 6,
          "text": "其四，推广运营——度量工具、试点激励、考核绑定，轻量。",
          "start": 25.312,
          "end": 31.187
        },
        {
          "index": 7,
          "text": "四块加起来就是总投入。",
          "start": 31.187,
          "end": 34.237
        }
      ]
    }
  ]
