      "sentences": [
        {
          "index": 0,
          "text": "失败预案，立项就想好退路。",
          "start": 0.1,
          "end": 3.05
        },
        {
          "index": 1,
          "text": "转型有风险，三条兜底。",
          "start": 3.0,
          "end": 6.0
        },
        {
          "index": 2,
          "text": "一是止损线——试点 3 个月，AI 占比、产出、质量无明显改善就触发复盘：工具没装好、培训没到位、还是场景选错。",
          "start": 6.0,
          "end": 17.037
        },
        {
          "index": 3,
          "text": "二是回退——工具按月付费可停、试点范围可控可缩、代码在 Git 可回退，沉没成本低。",
          "start": 17.037,
          "end": 25.112
        },
        {
          "index": 4,
          "text": "三是复盘——分清是方法错还是执行错，调整后再小范围试，不一次梭哈。",
          "start": 25.112,
          "end": 32.325
        },
        {
          "index": 5,
          "text": "把\"试点验证加可止损\"写进立项，老板才敢真投。",
          "start": 32.325,
          "end": 37.387
        }
      ]
    }
  ]
}