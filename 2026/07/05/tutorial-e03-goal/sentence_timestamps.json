      "sentences": [
        {
          "index": 0,
          "text": "先讲目标量化。",
          "start": 0.1,
          "end": 2.037
        },
        {
          "index": 1,
          "text": "不可度量等于不可管理——转型启动就要定好量化目标。",
          "start": 1.987,
          "end": 7.162
        },
        {
          "index": 2,
          "text": "给个阶梯参考：培训后 1 个月，提效 10 到 20%，这是适应期，主要在简单任务；培训后 2 个月，20 到 30%，扩展到复杂任务；3 个月目标，人均产出 +50%。",
          "start": 7.162,
          "end": 22.7
        },
        {
          "index": 3,
          "text": "注意：+50% 是启动时承诺的目标，实际跑出多少靠后面度量。",
          "start": 22.7,
          "end": 29.2
        },
        {
          "index": 4,
          "text": "关键是目标要前置——启动时就公开承诺，配度量工具。",
          "start": 29.2,
          "end": 34.575
        },
        {
          "index": 5,
          "text": "没有前置目标的尽力而为，往往沦未口号。",
          "start": 34.575,
          "end": 39.125
        }
      ]
    }
  ]
}