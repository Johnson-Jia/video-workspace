      "scene": "seg1",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "装好工具，关键是规范资产化。",
          "start": 0.1,
          "end": 3.287
        },
        {
          "index": 1,
          "text": "团队规范写进,克劳德.md——项目根目录的规范文件，AI 每次启动自动读取。",
          "start": 3.237,
          "end": 10.012
        },
        {
          "index": 2,
          "text": "克劳德.md 写什么？",
          "start": 10.012,
          "end": 12.512
        },
        {
          "index": 3,
          "text": "四块就够。",
          "start": 12.512,
          "end": 14.075
        },
        {
          "index": 4,
          "text": "头一块，技术栈——React 加 TypeScript 加 Vite，写明白，AI 生成就不会跑偏。",
          "start": 14.075,
          "end": 20.937
        },
        {
          "index": 5,
          "text": "第二块，命名规范——组件 PascalCase，工具函数 camelCase，AI 起名有据。",
          "start": 20.937,
          "end": 27.537
        },
        {
          "index": 6,
          "text": "第三块，常用命令——改动必跑 npm test，提交前先 lint，AI 改完代码自己会跑检查。",
          "start": 27.537,
          "end": 35.7
        },
        {
          "index": 7,
          "text": "第四块，提交规则——约定式提交，feat 是新功能，fix 是修 bug，docs 是文档，提交信息 AI 也能帮你写。",
          "start": 35.7,
          "end": 44.912
        },
        {
          "index": 8,
          "text": "这就是规范资产化：人定的规矩，AI 自动执行。",
          "start": 44.912,
          "end": 49.775
        },
        {
          "index": 9,
          "text": "克劳德.md 提交进 Git，全团队共享，新人来了 AI 帮他守规矩。",
          "start": 49.775,
          "end": 55.625
        },
        {
          "index": 10,
          "text": "规范不再是文档里落灰的字，是 AI 每次生成都遵守的硬约束。",
          "start": 55.625,
          "end": 61.837
        }
      ]
    }
  ]
}