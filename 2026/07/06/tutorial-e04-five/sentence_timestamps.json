      "sentences": [
        {
          "index": 0,
          "text": "克劳德.md 是规范资产化的起点。",
          "start": 0.1,
          "end": 3.0
        },
        {
          "index": 1,
          "text": "除了它还有四件——Skill、MCP、RAG、Hooks，合称五件套。",
          "start": 2.95,
          "end": 7.69
        },
        {
          "index": 2,
          "text": "克劳德.md：项目规范，AI 每次自动读。",
          "start": 7.69,
          "end": 11.14
        },
        {
          "index": 3,
          "text": "Skill：可复用工作流，AI 按需调用。",
          "start": 11.14,
          "end": 14.31
        },
        {
          "index": 4,
          "text": "MCP：连接外部工具，让 AI 能查数据库、调接口。",
          "start": 14.31,
          "end": 18.34
        },
        {
          "index": 5,
          "text": "RAG：检索知识库，减少幻觉。",
          "start": 18.34,
          "end": 21.3
        },
        {
          "index": 6,
          "text": "Hooks：事件钩子，自动跑检查。",
          "start": 21.3,
          "end": 23.99
        },
        {
          "index": 7,
          "text": "这五件套是团队级提效的关键——个体再强，规范不沉淀就复制不开。",
          "start": 23.99,
          "end": 29.54
        }
      ]
    }
  ]
}