      "sentences": [
        {
          "index": 0,
          "text": "第一件套，业务知识 RAG。",
          "start": 0.1,
          "end": 2.13
        },
        {
          "index": 1,
          "text": "通用大模型不懂你的业务——产品手册、内部规范它都没读过。",
          "start": 2.08,
          "end": 6.82
        },
        {
          "index": 2,
          "text": "RAG 的做法是：先检索知识库片段，再喂给模型，让它开卷考试。",
          "start": 6.82,
          "end": 11.86
        },
        {
          "index": 3,
          "text": "核心是两阶段检索：第一阶段多路召回，优先找全；第二阶段 CrossEncoder 重排，精度提上去。",
          "start": 11.86,
          "end": 18.33
        },
        {
          "index": 4,
          "text": "还要做多租户隔离——把租户标识拼进过滤表达式，A 公司的知识 B 公司查不到，default 是全租户共享。",
          "start": 18.33,
          "end": 25.39
        },
        {
          "index": 5,
          "text": "业务 RAG 让 AI 准确回答业务问题，幻觉大幅下降。",
          "start": 25.39,
          "end": 29.33
        },
        {
          "index": 6,
          "text": "这是给 AI 装上业务记忆。",
          "start": 29.33,
          "end": 31.72
        }
      ]
    }
  ]
}