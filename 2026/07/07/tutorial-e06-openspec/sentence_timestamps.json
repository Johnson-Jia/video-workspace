      "sentences": [
        {
          "index": 0,
          "text": "SDD 用 OpenSpec 落地。",
          "start": 0.1,
          "end": 2.325
        },
        {
          "index": 1,
          "text": "三个核心概念先分清。",
          "start": 2.275,
          "end": 4.8
        },
        {
          "index": 2,
          "text": "Spec 规格是稳定的、跨变更共享的，放 specs 目录。",
          "start": 4.8,
          "end": 9.662
        },
        {
          "index": 3,
          "text": "Change 变更是一次性的、做完归档，放 changes 目录。",
          "start": 9.662,
          "end": 14.512
        },
        {
          "index": 4,
          "text": "Archive 是变更完成后的存档。",
          "start": 14.512,
          "end": 17.6
        },
        {
          "index": 5,
          "text": "四条命令覆盖全流程：explore 探索需求调查代码库，propose 生成 proposal、design、specs、tasks，apply 按 tasks 执行，archive 验证通过后归档。",
          "start": 17.6,
          "end": 30.637
        },
        {
          "index": 6,
          "text": "关键一条：每次对话 OpenSpec 会自动读 specs 目录所有 spec 应用到生成代码，所以 specs 要精简，只放稳定的全局规范，一次性变更放 changes。",
          "start": 30.637,
          "end": 43.475
        }
      ]
    }
  ]
}