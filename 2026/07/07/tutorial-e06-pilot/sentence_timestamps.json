      "scene": "seg1",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "闭环不是上来就全员跑，先选对试点团队、定清成功标准。",
          "start": 0.1,
          "end": 5.662
        },
        {
          "index": 1,
          "text": "选谁：选意愿强的团队加业务典型的项目。",
          "start": 5.612,
          "end": 10.087
        },
        {
          "index": 2,
          "text": "别选最忙的——没空配合；别选最边缘的——结果没说服力。",
          "start": 10.087,
          "end": 15.737
        },
        {
          "index": 3,
          "text": "多大：一到两个团队，每组三到八人，配一两个真实需求，跑四到八周。",
          "start": 15.737,
          "end": 22.812
        },
        {
          "index": 4,
          "text": "成功标准四条：AI 代码占比达标、产出提升、质量不降、团队愿意继续用。",
          "start": 22.812,
          "end": 29.925
        },
        {
          "index": 5,
          "text": "失败就止损：四到八周没明显改善就复盘，不硬推。",
          "start": 29.925,
          "end": 35.225
        },
        {
          "index": 6,
          "text": "试点的目的不是证明能行，是拿数据说话——成功有数据推广，失败有原因可查。",
          "start": 35.225,
          "end": 42.887
        }
      ]
    }
  ]
}