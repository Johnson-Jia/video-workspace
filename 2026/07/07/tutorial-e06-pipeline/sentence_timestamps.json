      "sentences": [
        {
          "index": 0,
          "text": "团队工作流编排 OpenSpec 加 Superpowers 加代码图谱，跑六个阶段。",
          "start": 0.1,
          "end": 6.225
        },
        {
          "index": 1,
          "text": "阶段一需求探索，用 brainstorming，用户可以纠正方向——这一步最关键，主动找死代码和 bug，跳过探索直接动手等于重写 bug。",
          "start": 6.175,
          "end": 17.062
        },
        {
          "index": 2,
          "text": "阶段二规范生成，openspec-propose 产出 proposal、design、tasks、spec。",
          "start": 17.062,
          "end": 23.175
        },
        {
          "index": 3,
          "text": "阶段三计划拆分，writing-plans 拆成可执行步骤，有代码图谱时配合 impact 和 locate。",
          "start": 23.175,
          "end": 30.312
        },
        {
          "index": 4,
          "text": "阶段四 TDD 加审查，subagent-driven，跑 RED GREEN REFACTOR 循环。",
          "start": 30.312,
          "end": 35.712
        },
        {
          "index": 5,
          "text": "阶段五验证，verification-before-completion，有图谱时加 detect changes。",
          "start": 35.712,
          "end": 41.262
        },
        {
          "index": 6,
          "text": "阶段六归档，openspec-archive。",
          "start": 41.262,
          "end": 44.212
        },
        {
          "index": 7,
          "text": "每阶段只读当前 Stage 文件，这叫渐进式披露，省 token。",
          "start": 44.212,
          "end": 49.412
        }
      ]
    }
  ]
}