  "segments": [
    {
      "scene": "seg1",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "拆墙的核心思想叫 SDD，规范驱动开发。",
          "start": 0.1,
          "end": 4.212
        },
        {
          "index": 1,
          "text": "把开发拆成三层产物。",
          "start": 4.162,
          "end": 6.587
        },
        {
          "index": 2,
          "text": "首层 spec.md，记 WHAT——可测试的行为规格，用 WHEN THEN 格式写。",
          "start": 6.587,
          "end": 12.05
        },
        {
          "index": 3,
          "text": "它回答\"做什么\"。",
          "start": 12.05,
          "end": 13.937
        },
        {
          "index": 4,
          "text": "第二层 plan.md，记 HOW——含完整代码的实施指南，每步前后对比加精确文件路径。",
          "start": 13.937,
          "end": 20.875
        },
        {
          "index": 5,
          "text": "它回答\"怎么做\"。",
          "start": 20.875,
          "end": 22.812
        },
        {
          "index": 6,
          "text": "第三层 tasks.md，记 DO——可追踪的 checkbox 任务清单。",
          "start": 22.812,
          "end": 27.525
        },
        {
          "index": 7,
          "text": "它回答\"做到哪了\"。",
          "start": 27.525,
          "end": 29.475
        },
        {
          "index": 8,
          "text": "核心价值是左移：把发现需求理解偏差，从改代码左移到改 Markdown，交付质量提升一个数量级。",
          "start": 29.475,
          "end": 38.062
        },
        {
          "index": 9,
          "text": "AI 初始理解往往不准，但改 spec 比改代码快得多。",
          "start": 38.062,
          "end": 42.812
        },
        {
          "index": 10,
          "text": "tasks 清单还带来一个 bonus——任务中断后可虫新接入继续执行，下一段细讲。",
          "start": 42.812,
          "end": 49.8
        }
      ]
    }
  ]
}