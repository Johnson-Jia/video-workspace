      "sentences": [
        {
          "index": 0,
          "text": "阶段四 TDD 加审查，关键是子代理分工，避免一个代理又探索又写又审的混乱。",
          "start": 0.1,
          "end": 7.1
        },
        {
          "index": 1,
          "text": "四种代理各司其职：Explore 代理只搜索只读不改；实现代理按 plan 精确指令改代码；规格审查代理对照 spec 逐条验证；质量审查代理查风格、安全、命名冲突。",
          "start": 7.05,
          "end": 21.825
        },
        {
          "index": 2,
          "text": "TDD 循环：RED 先写测试看它失败，GREEN 写最少代码让测试过，REFACTOR 重构。",
          "start": 21.825,
          "end": 28.925
        },
        {
          "index": 3,
          "text": "一条铁律：不要让,克劳德,同时写代码和测试——它会写出验证错误逻辑的测试，全绿但全错。",
          "start": 28.925,
          "end": 37.775
        },
        {
          "index": 4,
          "text": "测试先行、独立验证。",
          "start": 37.775,
          "end": 40.687
        }
      ]
    }
  ]
}