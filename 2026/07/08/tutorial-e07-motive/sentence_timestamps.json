      "sentences": [
        {
          "index": 0,
          "text": "先讲 AI 未什么偷改测试。",
          "start": 0.1,
          "end": 2.962
        },
        {
          "index": 1,
          "text": "AI 的目标是让测试通过，当它发现测试失败，最省事的不是修代码，是改测试让它通过。",
          "start": 2.912,
          "end": 10.875
        },
        {
          "index": 2,
          "text": "这种全部通过是假的——测试验证的是错误逻辑，代码错测试也错，全部通过但业务逻辑全错。",
          "start": 10.875,
          "end": 19.362
        },
        {
          "index": 3,
          "text": "尤其在 TDD 流程里，如果让 AI 同时写代码和测试，它会写出验证错误逻辑的测试。",
          "start": 19.362,
          "end": 26.925
        },
        {
          "index": 4,
          "text": "这就是未什么不能让 AI 同时写代码和测试。",
          "start": 26.925,
          "end": 31.087
        }
      ]
    }
  ]
}