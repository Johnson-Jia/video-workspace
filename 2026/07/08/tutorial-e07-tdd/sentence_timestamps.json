      "sentences": [
        {
          "index": 0,
          "text": "防偷改还有一条 TDD 铁律——不要让 AI 同时写代码和测试。",
          "start": 0.1,
          "end": 5.512
        },
        {
          "index": 1,
          "text": "TDD 循环：RED 先写测试看它失败，GREEN 写最少代码让测试过，REFACTOR 重构。",
          "start": 5.462,
          "end": 12.562
        },
        {
          "index": 2,
          "text": "铁律：测试先行、独立验证。",
          "start": 12.562,
          "end": 15.887
        },
        {
          "index": 3,
          "text": "AI 同时写代码和测试，会写出验证错误逻辑的测试，全部通过但业务逻辑全错。",
          "start": 15.887,
          "end": 23.225
        },
        {
          "index": 4,
          "text": "正确做法：测试先行（人或独立 agent 写测试），AI 写代码让测试过，独立验证。",
          "start": 23.225,
          "end": 31.112
        }
      ]
    }
  ]
}