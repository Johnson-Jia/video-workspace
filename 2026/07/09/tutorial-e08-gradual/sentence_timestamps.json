  "segments": [
    {
      "scene": "seg1",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "最后提醒个坑——度量是逐步建的，不是部署工具就出数据。",
          "start": 0.1,
          "end": 5.4
        },
        {
          "index": 1,
          "text": "真实团队按阶段来，三步走。",
          "start": 5.35,
          "end": 8.525
        },
        {
          "index": 2,
          "text": "先有业务覆盖率，盘点哪些业务模块接入了 AI 辅助，哪些团队还在传统流程。",
          "start": 8.525,
          "end": 16.062
        },
        {
          "index": 3,
          "text": "再有 bug 排查覆盖率，线上出问题，能不能用 AI 工具链从告警一路追溯到具体代码航、具体提交。",
          "start": 16.062,
          "end": 25.25
        },
        {
          "index": 4,
          "text": "最后才有 AI 代码占比，用三层识别算出可信的真实数字。",
          "start": 25.25,
          "end": 31.075
        },
        {
          "index": 5,
          "text": "未什么必须是这个顺序？",
          "start": 31.075,
          "end": 33.6
        },
        {
          "index": 6,
          "text": "前两层是基础。",
          "start": 33.6,
          "end": 35.562
        },
        {
          "index": 7,
          "text": "业务没铺开，占比没有分母；问题追不到，占比就是空中楼阁，老板一问就露馅。",
          "start": 35.562,
          "end": 42.775
        },
        {
          "index": 8,
          "text": "所以别指望一上来就跑出七成六点六。",
          "start": 42.775,
          "end": 46.575
        },
        {
          "index": 9,
          "text": "先建可量化的业务指标，度量体系随转型成熟分阶段落地。",
          "start": 46.575,
          "end": 52.625
        }
      ]
    }
  ]
}