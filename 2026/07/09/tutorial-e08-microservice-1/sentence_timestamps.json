      "sentences": [
        {
          "index": 0,
          "text": "多 Agent 并行是横向放大，同时干多个任务。",
          "start": 0.1,
          "end": 4.85
        }
      ]
    },
    {
      "scene": "s2",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "更远的终局是纵向贯通——把非技术人员提需求、AI 全流程执行、部署上线，串成一条 Agent 微服务流水线。",
          "start": 0.1,
          "end": 10.5
        }
      ]
    },
    {
      "scene": "s3",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "这是成熟期愿景，不是起步就建。",
          "start": 0.1,
          "end": 3.8
        }
      ]
    },
    {
      "scene": "s4",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "结构是一个顶级 Agent 加六个专项 Agent。",
          "start": 0.1,
          "end": 4.425
        }
      ]
    },
    {
      "scene": "s5",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "顶级 Agent 接收语音需求，做语义解析、任务分发、异常兜底。",
          "start": 0.1,
          "end": 6.1
        }
      ]
    },
    {
      "scene": "s6",
      "segment_index": 5,
      "sentences": [
        {
          "index": 0,
          "text": "六个专项 Agent 各管一段，接口标准，按项目隔离权限。",
          "start": 0.1,
          "end": 5.825
        }
      ]
    },
    {
      "scene": "s7",
      "segment_index": 6,
      "sentences": [
        {
          "index": 0,
          "text": "先看前三个：需求定位，调 RAG 和代码图谱，定位需求对应的项目和功能模块；",
          "start": 0.1,
          "end": 8.1
        }
      ]
    },
    {
      "scene": "s8",
      "segment_index": 7,
      "sentences": [
        {
          "index": 0,
          "text": "接口规划，按接口规范规划，优先复用已有接口，避免虫复开发；",
          "start": 0.1,
          "end": 6.775
        }
      ]
    },
    {
