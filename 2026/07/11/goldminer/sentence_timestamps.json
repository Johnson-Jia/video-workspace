  "segments": [
    {
      "scene": "scene_1_hook",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "淘金！",
          "start": 0.1,
          "end": 1.115
        },
        {
          "index": 1,
          "text": "开淘！",
          "start": 1.065,
          "end": 2.076
        },
        {
          "index": 2,
          "text": "手握一亿九千万注册用户的公司，怎么死在了这个让所有人羡慕的数字上。",
          "start": 2.076,
          "end": 8.021
        }
      ]
    },
    {
      "scene": "scene_2_what",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "今天这家叫沪江，二零零一年起步，中国在线教育的老前辈。",
          "start": 0.1,
          "end": 4.919
        },
        {
          "index": 1,
          "text": "从英语社区掌成横跨语言、K12、职业技能的大平台，十七年烧掉一点八七亿美金，换回一亿九千万用户，二零一八年冲港股IPO。",
          "start": 4.869,
          "end": 15.576
        }
      ]
    },
    {
      "scene": "scene_3_why_fail",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "招股书一公开，真相血淋淋。",
          "start": 0.1,
          "end": 2.843
        },
        {
          "index": 1,
          "text": "沪江从来没赚过钱，死因不是双减不是竞争，是单位经济崩盘。",
          "start": 2.793,
          "end": 7.847
        },
        {
          "index": 2,
          "text": "其一，获客成本爆炸。",
          "start": 7.847,
          "end": 10.097
        },
        {
          "index": 3,
          "text": "新东方、猿辅导带百亿美金杀进场，沪江被卷进竞价战，拉一个付费用户花一百到两百美金，可付费用户一年才贡献五十到八十美金。",
          "start": 10.097,
          "end": 20.641
        },
        {
          "index": 4,
          "text": "拉一个，亏一个。",
          "start": 20.641,
          "end": 22.51
        },
        {
          "index": 5,
          "text": "其二，平台抽佣被架空。",
          "start": 22.51,
          "end": 24.978
        },
        {
          "index": 6,
          "text": "沪江连接师生抽两到三成，可学生学完课程常跟授课方私下续课，绕开平台。",
          "start": 24.978,
          "end": 31.576
        },
        {
          "index": 7,
          "text": "其三，免费转付费漏斗断裂。",
          "start": 31.576,
          "end": 34.336
        },
        {
          "index": 8,
          "text": "一亿九千万用户里，掏钱的只有百分之二到五，海量免费用户只烧服务器不产收入。",
          "start": 34.336,
          "end": 40.989
        },
        {
          "index": 9,
          "text": "规模越大，窟窿越大。",
          "start": 40.989,
          "end": 43.228
        },
        {
          "index": 10,
          "text": "二零一八IPO失败断了血，二零二一关停。",
          "start": 43.228,
          "end": 47.239
        }
      ]
    },
    {
      "scene": "scene_4_loot",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "我淘到的教训就一句，虚荣指标害死人。",
          "start": 0.1,
          "end": 3.593
        },
        {
          "index": 1,
          "text": "一亿九千万这个数字，在百分之二转化率面前一钱不值。",
          "start": 3.543,
          "end": 7.913
        },
        {
          "index": 2,
          "text": "创始人起步就该盯回本周期、单客户边际贡献，而不是累计注册数。",
          "start": 7.913,
          "end": 13.641
        },
        {
          "index": 3,
          "text": "还有，横向平台打不过垂直专家，沪江想当教育界的亚马逊，哪个品类都没做透。",
          "start": 13.641,
          "end": 20.086
        },
        {
          "index": 4,
          "text": "可偷的点子更值钱，AI原生垂直职业培训平台，只盯AI工程、Web3这种新兴技能，用大模型做个性化学习加代码反馈。",
          "start": 20.086,
          "end": 30.391
        }
      ]
    },
    {
      "scene": "scene_5_compare_cta",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "沪江不是孤例。",
          "start": 0.1,
          "end": 1.593
        },
        {
          "index": 1,
          "text": "同航魔力耳朵、Qkids死在双减一刀切，Changingedu是监管加单位经济双杀。",
          "start": 1.543,
          "end": 7.413
        },
        {
          "index": 2,
          "text": "可沪江是这一航里，唯一死在自己手里的。",
          "start": 7.413,
          "end": 10.934
        },
        {
          "index": 3,
          "text": "这个AI垂直培训的点子，你觉得能成吗？",
          "start": 10.934,
          "end": 14.913
        }
      ]
    }
  ]
}