      "sentences": [
        {
          "index": 0,
          "text": "七种 Skill 范式，各管一摊。",
          "start": 0.1,
          "end": 3.075
        },
        {
          "index": 1,
          "text": "工具型，封装高频开发动作，像 SQL 查询、CRUD 生成，业务开发团队最爱。",
          "start": 3.025,
          "end": 10.437
        },
        {
          "index": 2,
          "text": "规范型，让 AI 输出符合团队设计规范，前端团队用它统一 Token。",
          "start": 10.437,
          "end": 16.9
        },
        {
          "index": 3,
          "text": "平台型，低代码搭建，严格触发条件加接口白名单，绝不猜测写操作。",
          "start": 16.9,
          "end": 23.712
        },
        {
          "index": 4,
          "text": "流程型，AI 分析变更生成规范提交，自动提交。",
          "start": 23.712,
          "end": 28.775
        },
        {
          "index": 5,
          "text": "记忆型，持久化记忆跨会话复用，按项目隔离。",
          "start": 28.775,
          "end": 33.387
        },
        {
          "index": 6,
          "text": "诊断分析型，只读分析不改代码，性能诊断、慢 SQL 定位，跟工具型会改代码的有别。",
          "start": 33.387,
          "end": 41.475
        },
        {
          "index": 7,
          "text": "编排型，自己不实现，把多个 Skill 串成流水线，像 devflow 编排 OpenSpec 加 Superpowers 成六阶段。",
          "start": 41.475,
          "end": 50.275
        }
      ]
    }
  ]
}