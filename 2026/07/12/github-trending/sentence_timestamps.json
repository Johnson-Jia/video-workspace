  "segments": [
    {
      "scene": "s1",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "7月12日，单日冲上789星，颠覆常识",
          "start": 0.1,
          "end": 4.37
        }
      ]
    },
    {
      "scene": "s2",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "有人用Rust重写了三十年的Postgres，已经通过全部回归测试。",
          "start": 0.1,
          "end": 4.81
        },
        {
          "index": 1,
          "text": "它让做数据库的开发者，看到工业级内核被一人重写的可能性",
          "start": 4.76,
          "end": 9.53
        }
      ]
    },
    {
      "scene": "s3",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "微软开源的Windows效率工具集PowerToys，一堆系统级小工具免费用。",
          "start": 0.1,
          "end": 4.9
        },
        {
          "index": 1,
          "text": "窗口管理、颜色拾取、批量改名，普通用户开箱即用",
          "start": 4.85,
          "end": 9.52
        }
      ]
    },
    {
      "scene": "s4",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "第三个，NASA把送上天的飞行软件框架F-prime开源了。",
          "start": 0.1,
          "end": 4.13
        },
        {
          "index": 1,
          "text": "给做嵌入式硬件的开发者，航天级代码也能拿来改",
          "start": 4.08,
          "end": 8.26
        }
      ]
    },
    {
      "scene": "s5",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "第四个，一个集成AI的流程图应用，自然语言交流就能改图。",
          "start": 0.1,
          "end": 4.64
        },
        {
          "index": 1,
          "text": "不用手动画框拖线，普通人也能做专业图表",
          "start": 4.59,
          "end": 8.28
        }
      ]
    },
    {
      "scene": "s6",
      "segment_index": 5,
      "sentences": [
        {
          "index": 0,
          "text": "开源智能家居平台Home Assistant，本地控制、隐私至上。",
          "start": 0.1,
          "end": 4.22
        },
        {
          "index": 1,
          "text": "拔掉网线照样能管家里设备，数据不外传。",
          "start": 4.17,
          "end": 7.65
        },
        {
          "index": 2,
          "text": "这五个项目你最想用哪个，关注我下期见",
          "start": 7.65,
          "end": 11.13
        }
      ]
    }
  ]
}