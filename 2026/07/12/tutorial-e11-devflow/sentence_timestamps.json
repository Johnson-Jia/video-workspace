      "sentences": [
        {
          "index": 0,
          "text": "devflow 是编排型 skill，自己不实现，把多个 skill 串成流水线。",
          "start": 0.1,
          "end": 5.462
        },
        {
          "index": 1,
          "text": "它把需求到交付分成六阶段：探索、规范、计划、测试驱动、验证、归档。",
          "start": 5.412,
          "end": 13.137
        },
        {
          "index": 2,
          "text": "每个阶段调用对应工具——规范阶段调用 OpenSpec，计划阶段调用 Superpowers。",
          "start": 13.137,
          "end": 19.525
        },
        {
          "index": 3,
          "text": "它支持任务中断续接，中断了接着跑；支持规则覆盖，团队规矩能改写默认出口。",
          "start": 19.525,
          "end": 26.862
        },
        {
          "index": 4,
          "text": "devflow 把规范驱动开发从口号变成团队默认工作流。",
          "start": 26.862,
          "end": 32.075
        }
      ]
    }
  ]
}