      "sentences": [
        {
          "index": 0,
          "text": "十三条团队规范按职能分五层。",
          "start": 0.1,
          "end": 3.575
        },
        {
          "index": 1,
          "text": "入口是 team-conventions 总纲，克劳德.md 用 at 符号引用所有 rule，AI 自动加载。",
          "start": 3.525,
          "end": 10.75
        },
        {
          "index": 2,
          "text": "其一接口层，api-response 统一响应模型，service-dao 接口实现分离，事务归 Service。",
          "start": 10.75,
          "end": 17.875
        },
        {
          "index": 3,
          "text": "其二质量稳定层，error-handling 异常处理禁空 catch，logging 日志级别脱敏，testing 用 Given-When-Then。",
          "start": 17.875,
          "end": 25.65
        },
        {
          "index": 4,
          "text": "其三数据层，database 表设计向后兼容；batch 批量代替循环。",
          "start": 25.65,
          "end": 31.425
        },
        {
          "index": 5,
          "text": "其四并发层，async 线程池上下文传递，distributed-lock 用 Redisson 控粒度。",
          "start": 31.425,
          "end": 37.75
        },
        {
          "index": 6,
          "text": "其五工程规范层，git-branch 走 Conventional Commits 命名，naming 类后缀方法动词目录分层。",
          "start": 37.75,
          "end": 45.225
        },
        {
          "index": 7,
          "text": "五层覆盖团队开发全流程。",
          "start": 45.225,
          "end": 48.25
        }
      ]
    }
  ]
}