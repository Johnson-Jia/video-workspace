      "sentences": [
        {
          "index": 0,
          "text": "先说清楚 skill 和 rule 的区别。",
          "start": 0.1,
          "end": 2.937
        },
        {
          "index": 1,
          "text": "skill 是可复用的工作流加领域知识，AI 按需调用——你让它做某件事，它加载对应 skill。",
          "start": 2.887,
          "end": 10.4
        },
        {
          "index": 2,
          "text": "rule 是始终生效的规范，AI 自动遵守——不用你提，它每次都按规范来。",
          "start": 10.4,
          "end": 16.962
        },
        {
          "index": 3,
          "text": "一个按需，一个始终。",
          "start": 16.962,
          "end": 19.425
        },
        {
          "index": 4,
          "text": "比如 sql-query 是 skill，你让它查数据时调用；database 规范是 rule，每次写 SQL 自动按规范。",
          "start": 19.425,
          "end": 27.437
        },
        {
          "index": 5,
          "text": "两者配合，AI 既会干活又守规矩。",
          "start": 27.437,
          "end": 31.587
        }
      ]
    }
  ]
}