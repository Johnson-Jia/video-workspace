  "segments": [
    {
      "scene": "s1",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "第29周，AI agent 冲上 GitHub，单这一周就掌一万多星。",
          "start": 0.1,
          "end": 5.21
        }
      ]
    },
    {
      "scene": "s2",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "先看编码 agent 这组，给做编程的开发者。",
          "start": 0.1,
          "end": 3.34
        },
        {
          "index": 1,
          "text": "stablyai 的 orca 让多个 agent 并行写代码，桌面和手机都能跑，这周掌了四千四。",
          "start": 3.29,
          "end": 8.73
        },
        {
          "index": 2,
          "text": "herdr 住在终端里同时管多个 agent，codex-plugin-cc 让两家 AI 互相审代码派任务，DesktopCommanderMCP 给 agent 装上终端和文件控制能力。",
          "start": 8.73,
          "end": 18.39
        }
      ]
    },
    {
      "scene": "s3",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "接着技能生态这组。",
          "start": 0.1,
          "end": 1.87
        },
        {
          "index": 1,
          "text": "caveman 用穴居人语气说话，能省六成五词元，总星八万八，是这组的元老。",
          "start": 1.82,
          "end": 7.39
        },
        {
          "index": 2,
          "text": "克劳德-skills 收了三百四十五个技能和插件。",
          "start": 7.39,
          "end": 10.74
        },
        {
          "index": 3,
          "text": "克劳德-video 让 agent 能看懂视频，这周掌了四千三。",
          "start": 10.74,
          "end": 14.45
        },
        {
          "index": 4,
          "text": "archify 一句话就画出架构图。",
          "start": 14.45,
          "end": 17.08
        }
      ]
    },
    {
      "scene": "s4",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "安全工具这组讲的是防御价值。",
          "start": 0.1,
          "end": 2.75
        },
        {
          "index": 1,
          "text": "strix 帮开发者提前找出应用里的漏洞再修复，这周掌了四千一。",
          "start": 2.7,
          "end": 7.15
        },
        {
          "index": 2,
          "text": "pentagi 是全自动的渗透测试 agent。",
          "start": 7.15,
          "end": 10.06
        },
        {
          "index": 3,
          "text": "CubeSandbox 给 agent 一个隔离沙箱，防止它乱跑搞破坏。",
          "start": 10.06,
          "end": 14.15
        }
      ]
    },
    {
      "scene": "s5",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "应用办公这组普通人也能上手。",
          "start": 0.1,
          "end": 2.67
        },
        {
          "index": 1,
          "text": "OfficeCLI 让 agent 直接读写 Word 和 Excel，单文件就跑，这周掌了近七千星，是这周的掌星王。",
          "start": 2.62,
          "end": 9.26
        },
        {
          "index": 2,
          "text": "page-agent 用一句话控制网页界面。",
          "start": 9.26,
          "end": 11.84
        },
        {
          "index": 3,
          "text": "astryx 是一套 agent 就绪的设计系统。",
          "start": 11.84,
          "end": 14.93
        }
      ]
    },
    {
      "scene": "s6",
      "segment_index": 5,
      "sentences": [
        {
          "index": 0,
          "text": "这周 GitHub 的信号很清楚：agent 不再是散装工具，开始成体系了，从写代码到找漏洞再到接管办公，都有了对应方案。",
          "start": 0.1,
          "end": 8.31
        },
        {
          "index": 1,
          "text": "这周的项目你会试哪个？",
          "start": 8.26,
          "end": 10.42
        },
        {
          "index": 2,
          "text": "关注 GitHub 星探，下周见。",
          "start": 10.42,
          "end": 12.97
        }
      ]
    }
  ]
}