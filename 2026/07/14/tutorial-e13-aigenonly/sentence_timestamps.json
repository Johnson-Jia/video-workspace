      "sentences": [
        {
          "index": 0,
          "text": "这是整套框架最关键的思想。",
          "start": 0.1,
          "end": 3.25
        },
        {
          "index": 1,
          "text": "AI 只生成，不执行。",
          "start": 3.2,
          "end": 5.55
        },
        {
          "index": 2,
          "text": "handler 由录制加 AI 转换加人审，在编码期产出。",
          "start": 5.55,
          "end": 10.437
        },
        {
          "index": 3,
          "text": "运行期是确定性的数据驱动调度，零 AI。",
          "start": 10.437,
          "end": 14.712
        },
        {
          "index": 4,
          "text": "这样设计的考虑？",
          "start": 14.712,
          "end": 16.675
        },
        {
          "index": 5,
          "text": "规避幻觉。",
          "start": 16.675,
          "end": 18.112
        },
        {
          "index": 6,
          "text": "AI 直接运行测试，可能幻觉出一个虚假通过——它以为验证了，实际没有。",
          "start": 18.112,
          "end": 24.412
        },
        {
          "index": 7,
          "text": "AI 只负责生成代码，人审通过后，运行期全确定性执行，根治虚假通过。",
          "start": 24.412,
          "end": 31.9
        }
      ]
    }
  ]
