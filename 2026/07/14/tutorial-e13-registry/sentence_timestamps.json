      "sentences": [
        {
          "index": 0,
          "text": "注册中心是这套框架的灵魂。",
          "start": 0.1,
          "end": 3.35
        },
        {
          "index": 1,
          "text": "写一个装饰器 register，把方法登记进全局表，调度器按类型自动取。",
          "start": 3.3,
          "end": 9.662
        },
        {
          "index": 2,
          "text": "关键细节，类引用延迟解析——装饰器执行时类还没定义完，那时取会拿到空，所以类引用放到调度器创建实例时再解析。",
          "start": 9.662,
          "end": 20.262
        },
        {
          "index": 3,
          "text": "好触是，新增一个业务模块，写完注册，调度器自动发现，零改调度器代码。",
          "start": 20.262,
          "end": 27.425
        },
        {
          "index": 4,
          "text": "这是企业级测试框架提炼出来的核心模式。",
          "start": 27.425,
          "end": 31.8
        }
      ]
    }
