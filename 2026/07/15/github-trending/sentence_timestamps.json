  "segments": [
    {
      "scene": "s1",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "单日炸了四千多颗星。",
          "start": 0.1,
          "end": 2.09
        }
      ]
    },
    {
      "scene": "s2",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "它叫 OpenCut，开源版的剪映。",
          "start": 0.1,
          "end": 2.47
        },
        {
          "index": 1,
          "text": "浏览器打开就能剪，不充会员，今天一口气掌了四千三百多颗星。",
          "start": 2.42,
          "end": 7.44
        }
      ]
    },
    {
      "scene": "s3",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "第二个是 skills，一个工程师技能包合集。",
          "start": 0.1,
          "end": 3.03
        },
        {
          "index": 1,
          "text": "作者把命令航工具直接开放，克隆下来你也能用，今天掌了将近两千颗星。",
          "start": 2.98,
          "end": 8.41
        }
      ]
    },
    {
      "scene": "s4",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "这个给开发者，破坏命令守卫。",
          "start": 0.1,
          "end": 2.64
        },
        {
          "index": 1,
          "text": "AI 助手替你跑命令时，万一误删仓库怎么办，它专门拦住危险的删除操作。",
          "start": 2.59,
          "end": 8.5
        }
      ]
    },
    {
      "scene": "s5",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "第四个是 penpot，开源的团队设计平台。",
          "start": 0.1,
          "end": 3.17
        },
        {
          "index": 1,
          "text": "重在多人协作和可扩展，适合产品团队一块改稿。",
          "start": 3.12,
          "end": 7.46
        }
      ]
    },
    {
      "scene": "s6",
      "segment_index": 5,
      "sentences": [
        {
          "index": 0,
          "text": "第五个是 sharpemu，一个实验性质的 PS5 模拟器。",
          "start": 0.1,
          "end": 3.94
        },
        {
          "index": 1,
          "text": "还在早期阶段，玩家可以关注一下。",
          "start": 3.89,
          "end": 6.8
        }
      ]
    },
    {
      "scene": "s7",
      "segment_index": 6,
      "sentences": [
        {
          "index": 0,
          "text": "最后是 Win11Debloat，连续霸榜的 Windows 瘦身脚本。",
          "start": 0.1,
          "end": 4.18
        },
        {
          "index": 1,
          "text": "一键卸预装关遥测，Win10 和 11 都能用。",
          "start": 4.13,
          "end": 7.66
        }
      ]
    },
    {
      "scene": "s8",
      "segment_index": 7,
      "sentences": [
        {
          "index": 0,
          "text": "今天这六个，你最想试哪一个？",
          "start": 0.1,
          "end": 2.68
        },
        {
          "index": 1,
          "text": "关注 GitHub 星探，每天给你挑热门开源项目。",
          "start": 2.63,
          "end": 6.23
        }
      ]
    }
  ]
}