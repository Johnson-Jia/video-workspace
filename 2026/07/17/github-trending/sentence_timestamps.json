      "scene": "s1",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "用 AI 去 AI 味，这操作绝了。",
          "start": 0.1,
          "end": 2.75
        },
        {
          "index": 1,
          "text": "今天榜上还有个能免费剪视频的，单日三千多颗星。",
          "start": 2.7,
          "end": 6.72
        }
      ]
    },
    {
      "scene": "s2",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "先说个老朋友，OpenCut，开源的视频剪辑工具，又掌了快两千颗星，没会员浏览器就能剪。",
          "start": 0.1,
          "end": 6.5
        }
      ]
    },
    {
      "scene": "s3",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "真正炸场的叫 hallmark。",
          "start": 0.1,
          "end": 1.89
        },
        {
          "index": 1,
          "text": "AI 生成的界面总有一股 AI 味，圆角太大、配色太花、空话太多。",
          "start": 1.84,
          "end": 7.13
        },
        {
          "index": 2,
          "text": "这个技能装在主流 AI 编辑器里专治这毛病，单日掌了三千一百多颗星。",
          "start": 7.13,
          "end": 12.28
        },
        {
          "index": 3,
          "text": "用 AI 的手，去 AI 的味，反差拉满。",
          "start": 12.28,
          "end": 15.33
        }
      ]
    },
    {
      "scene": "s4",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "再来个跨界的，一千三百多个健身动作的数据集，带动图和肌群信息，给做健身应用的开发者用。",
          "start": 0.1,
          "end": 7.35
        }
      ]
    },
    {
      "scene": "s5",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "想自学的可以看 DeepTutor，高校研究团队出的终身个性化辅导，打开网页就能用，今天掌了六百多颗星。",
          "start": 0.1,
          "end": 7.51
        },
        {
          "index": 1,
          "text": "它记住你学过什么，一直陪你练。",
          "start": 7.46,
          "end": 10.28
        }
      ]
    },
    {
      "scene": "s6",
      "segment_index": 5,
      "sentences": [
        {
          "index": 0,
          "text": "最后两个收藏向。",
          "start": 0.1,
          "end": 1.61
        },
        {
          "index": 1,
          "text": "build-your-own-x 从零重造技术学编程，ossu 给一条免费自学计算机的路径，都是 GitHub 万星长青。",
          "start": 1.56,
          "end": 7.99
        },
        {
          "index": 2,
          "text": "想学编程的话，这几个你最想试哪个，关注我下期见。",
          "start": 7.99,
          "end": 12.31
        }
      ]
    }
  ]
