      "sentences": [
        {
          "index": 0,
          "text": "霸榜两项过万星，又冲上六个跨圈新项目。",
          "start": 0.1,
          "end": 3.7
        }
      ]
    },
    {
      "scene": "s2",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "霸榜的先带过，OpenCut 开源剪辑工具又掌千星，hallmark 去 AI 味设计技能又掌一千五，昨天讲过。",
          "start": 0.1,
          "end": 7.75
        }
      ]
    },
    {
      "scene": "s3",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "新上榜 docuseal，开源电子签名工具，自己创建签署文档，全程免费。",
          "start": 0.1,
          "end": 5.47
        },
        {
          "index": 1,
          "text": "今天掌近一百颗星，给小团队省一份合规钱。",
          "start": 5.42,
          "end": 9.33
        }
      ]
    },
    {
      "scene": "s4",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "PostHog 是另一个跨圈新秀，产品分析平台，AI 可观测、数据分析、会话回放全整合。",
          "start": 0.1,
          "end": 6.59
        },
        {
          "index": 1,
          "text": "今天掌四百多颗星，给做产品的省一堆工具费。",
          "start": 6.54,
          "end": 10.36
        }
      ]
    },
    {
      "scene": "s5",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "开发者向的两个。",
          "start": 0.1,
          "end": 1.8
        },
        {
          "index": 1,
          "text": "turbovec 用 Rust 写的向量索引库，特别快。",
          "start": 1.75,
          "end": 4.88
        },
        {
          "index": 2,
          "text": "code-review-graph 给代码库建知识图谱，让 AI 工具只读关键部分。",
          "start": 4.88,
          "end": 9.85
        }
      ]
    },
    {
      "scene": "s6",
      "segment_index": 5,
      "sentences": [
        {
          "index": 0,
          "text": "跨圈这几个你最想试哪个，电子签名的还是产品分析的。",
          "start": 0.1,
          "end": 4.41
        },
        {
          "index": 1,
          "text": "关注我，下期见。",
          "start": 4.36,
          "end": 6.36
        }
      ]
    }
  ]
}