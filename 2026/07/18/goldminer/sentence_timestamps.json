      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "火花思维，三到十二岁的在线数学思维启蒙，小班直播，家掌抢着报名。",
          "start": 0.1,
          "end": 6.495
        },
        {
          "index": 1,
          "text": "明星赛道，融了将近六亿美元。",
          "start": 6.445,
          "end": 9.489
        }
      ]
    },
    {
      "scene": "s3",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "2021年7月24号，双减政策落地，K9学科培训禁止营利、禁外资、周末节假日禁课、政府定价。",
          "start": 0.1,
          "end": 8.582
        },
        {
          "index": 1,
          "text": "火花七八成收入来自小学数学，转非营利没法收费，禁外资没法融资，周末禁课没法上课。",
          "start": 8.532,
          "end": 16.021
        },
        {
          "index": 2,
          "text": "几周之内，裁员超过八成。",
          "start": 16.021,
          "end": 18.913
        }
      ]
    },
    {
      "scene": "s4",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "淘金！",
          "start": 0.1,
          "end": 1.115
        },
        {
          "index": 1,
          "text": "这案子三个教训。",
          "start": 1.065,
          "end": 2.815
        },
        {
          "index": 2,
          "text": "其一，教育医疗金融是强监管赛道，政府动手比转型快。",
          "start": 2.815,
          "end": 7.847
        },
        {
          "index": 3,
          "text": "其二，直播小班有天花板，得线性加师资，异步AI才省。",
          "start": 7.847,
          "end": 12.695
        },
        {
          "index": 4,
          "text": "其三，获客烧钱战，单客户成本从一千掌到三千。",
          "start": 12.695,
          "end": 17.13
        },
        {
          "index": 5,
          "text": "可偷的点子：AI协作数学平台，AI异步教加每周直播解题，七成五毛利，避开国内监管做海外。",
          "start": 17.13,
          "end": 25.478
        }
      ]
    },
    {
      "scene": "s5",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "同期学而思转直播带货、猿辅导转素质教育，活下来了；火花卡在小学数学，没退路。",
          "start": 0.1,
          "end": 7.702
