  },
  "segments": [
    {
      "scene": "s1",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "两万八千亿参数，开源，硅谷焦虑了。",
          "start": 0.1,
          "end": 3.48
        }
      ]
    },
    {
      "scene": "s2",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "Kimi K3，月之暗面刚放的大模型，两万八千亿参数，史上最大开源。",
          "start": 0.1,
          "end": 5.44
        },
        {
          "index": 1,
          "text": "七月十六号发布，二十七号权重全开源。",
          "start": 5.39,
          "end": 8.72
        }
      ]
    },
    {
      "scene": "s3",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "成绩单什么样？",
          "start": 0.1,
          "end": 1.4
        },
        {
          "index": 1,
          "text": "编程榜 SWE-bench 它拿了九十三点四，第三方独立验证的；前端编程竞技场直接登顶。",
          "start": 1.35,
          "end": 7.5
        },
        {
          "index": 2,
          "text": "跟当前领先的闭源模型头对头十四项，它赢六项，长程编程那项领先七分。",
          "start": 7.5,
          "end": 13.18
        },
        {
          "index": 3,
          "text": "有意思的是，月之暗面自己家的测试台上，闭源那家还赢四分，这反而让人觉得数据可信。",
          "start": 13.18,
          "end": 19.57
        }
      ]
    },
    {
      "scene": "s4",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "开源的好触实打实。",
          "start": 0.1,
          "end": 1.84
        },
        {
          "index": 1,
          "text": "用它的接口，价格只有闭源那家的三分之一，十五块对五十块。",
          "start": 1.79,
          "end": 6.31
        },
        {
          "index": 2,
          "text": "能本地部署，能自己微调，架构全透明。",
          "start": 6.31,
          "end": 9.86
        },
        {
          "index": 3,
          "text": "当然门槛也高，得一太字节显存，普通人电脑跑不动。",
          "start": 9.86,
          "end": 14.19
        }
      ]
    },
    {
      "scene": "s5",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "这事得放大的看。",
          "start": 0.1,
          "end": 1.72
        },
        {
          "index": 1,
          "text": "从,深度求索,到通义千问再到 Kimi K3，中国开源模型一路接力。",
          "start": 1.67,
          "end": 6.83
        },
        {
          "index": 2,
          "text": "另一边，美国出口管制越收越紧，华未昇腾芯片全球任何地方用都算违规，连自家的 Fable 模型都被暂停过三周。",
          "start": 6.83,
          "end": 14.95
        },
        {
          "index": 3,
          "text": "七月中旬世界人工智能大会上，有句话被广泛引用：反对把一国的安全建立在他国不安全之上。",
          "start": 14.95,
          "end": 22.33
        }
      ]
    },
    {
      "scene": "s6",
      "segment_index": 5,
      "sentences": [
        {
          "index": 0,
          "text": "市场反应很直接，被称为第二次,深度求索,冲击。",
          "start": 0.1,
          "end": 3.79
        },
        {
          "index": 1,
          "text": "台积电当天跌百分之七，英伟达一度丢了全球最高市值的宝座。",
          "start": 3.74,
          "end": 8.61
        }
      ]
    },
    {
      "scene": "s7",
      "segment_index": 6,
      "sentences": [
        {
          "index": 0,
          "text": "火到什么程度？",
          "start": 0.1,
          "end": 1.55
        },
        {
          "index": 1,
          "text": "发布才两天，月之暗面宣布算力扛不住，暂停新用户订阅。",
          "start": 1.5,
          "end": 6.23
        },
        {
          "index": 2,
          "text": "这不是翻车，反过来证明需求炸了。",
          "start": 6.23,
          "end": 9.38
        }
      ]
    },
    {
      "scene": "s8",
      "segment_index": 7,
      "sentences": [
        {
          "index": 0,
          "text": "开源还是闭源，全球AI这场竞争，格局变了。",
          "start": 0.1,
          "end": 3.87
        },
        {
          "index": 1,
          "text": "你怎么看？",
          "start": 3.82,
          "end": 4.92
        },
        {
          "index": 2,
          "text": "关注我下期见。",
          "start": 4.92,
          "end": 6.63
        }
      ]
    }
  ]
}