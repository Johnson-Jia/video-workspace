      "sentences": [
        {
          "index": 0,
          "text": "六个项目杀入，AI能看视频。",
          "start": 0.1,
          "end": 2.77
        }
      ]
    },
    {
      "scene": "s2",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "先看克劳德-video。",
          "start": 0.1,
          "end": 1.79
        },
        {
          "index": 1,
          "text": "它下载视频、抽取关键帧、转录语音。",
          "start": 1.74,
          "end": 4.9
        },
        {
          "index": 2,
          "text": "再全交给AI助手处理。",
          "start": 4.9,
          "end": 7.08
        },
        {
          "index": 3,
          "text": "AI以前只会生成视频。",
          "start": 7.08,
          "end": 8.97
        },
        {
          "index": 4,
          "text": "现在能反过来自己看懂。",
          "start": 8.97,
          "end": 11.06
        },
        {
          "index": 5,
          "text": "等于替你看完了整段。",
          "start": 11.06,
          "end": 13.06
        }
      ]
    },
    {
      "scene": "s3",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "再看airi，四万四千星。",
          "start": 0.1,
          "end": 2.36
        },
        {
          "index": 1,
          "text": "自托管的AI伴侣。",
          "start": 2.31,
          "end": 4.06
        },
        {
          "index": 2,
          "text": "能实时语音聊天。",
          "start": 4.06,
          "end": 5.72
        },
        {
          "index": 3,
          "text": "装在自己电脑上，数据归你。",
          "start": 5.72,
          "end": 8.22
        },
        {
          "index": 4,
          "text": "还能进游戏陪你打我的世界。",
          "start": 8.22,
          "end": 10.75
        }
      ]
    },
    {
      "scene": "s4",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "还有last30days，五万四千星。",
          "start": 0.1,
          "end": 2.64
        },
        {
          "index": 1,
          "text": "你定个主题。",
          "start": 2.59,
          "end": 3.87
        },
        {
          "index": 2,
          "text": "它让AI跨七八个平台去研究。",
          "start": 3.87,
          "end": 6.51
        },
        {
          "index": 3,
          "text": "资料扒下来，整理成带出处的总结。",
          "start": 6.51,
          "end": 9.4
        },
        {
          "index": 4,
          "text": "像雇了个会查资料的助理。",
          "start": 9.4,
          "end": 11.88
        }
      ]
    },
    {
      "scene": "s5",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "GeoLibre，浏览器打开就能用。",
          "start": 0.1,
          "end": 2.45
        },
        {
          "index": 1,
          "text": "做地图可视化、空间分析。",
          "start": 2.4,
          "end": 4.69
        },
        {
          "index": 2,
          "text": "数据留在本地，不上云。",
          "start": 4.69,
          "end": 6.79
        },
        {
          "index": 3,
          "text": "专业GIS以前得装笨重软件。",
          "start": 6.79,
          "end": 9.51
        },
        {
          "index": 4,
          "text": "现在网页里直接跑。",
          "start": 9.51,
          "end": 11.51
        }
      ]
    },
    {
      "scene": "s6",
      "segment_index": 5,
      "sentences": [
        {
          "index": 0,
          "text": "再补两个上榜的。",
          "start": 0.1,
          "end": 1.73
        },
        {
          "index": 1,
          "text": "jenkins是老牌自动化服务器。",
          "start": 1.68,
          "end": 4.09
        },
        {
          "index": 2,
          "text": "做持续集成的开发者都不陌生。",
          "start": 4.09,
          "end": 6.66
        },
        {
          "index": 3,
          "text": "断网蓝牙群聊bitchat。",
