      "scene": "s1",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "不用装专业软件，浏览器里直接造3D建筑。",
          "start": 0.1,
          "end": 3.66
        },
        {
          "index": 1,
          "text": "今天GitHub上的项目，方向挺杂。",
          "start": 3.61,
          "end": 6.52
        }
      ]
    },
    {
      "scene": "s2",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "先说editor。",
          "start": 0.1,
          "end": 1.38
        },
        {
          "index": 1,
          "text": "在浏览器里建3D建筑模型，建完生成链接就能分享。",
          "start": 1.33,
          "end": 5.86
        },
        {
          "index": 2,
          "text": "不用专业显卡，普通人也能做出像样作品。",
          "start": 5.86,
          "end": 9.11
        },
        {
          "index": 3,
          "text": "单日掌了四百多星。",
          "start": 9.11,
          "end": 11.02
        }
      ]
    },
    {
      "scene": "s3",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "再看ECC。",
          "start": 0.1,
          "end": 1.42
        },
        {
          "index": 1,
          "text": "它给AI编程工具加上技能、记忆和安全能力，让AI写代码更稳。",
          "start": 1.37,
          "end": 6.16
        },
        {
          "index": 2,
          "text": "半年掌到二十三万星，三万五千多个fork，真有开发者在用。",
          "start": 6.16,
          "end": 10.89
        }
      ]
    },
    {
      "scene": "s4",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "再来speech-to-speech，知名AI开源社区出的。",
          "start": 0.1,
          "end": 3.25
        },
        {
          "index": 1,
          "text": "用开源模型在本地搭语音助手，跟它说话就能回。",
          "start": 3.2,
          "end": 7.13
        },
        {
          "index": 2,
          "text": "数据不用上传云端，留在自己电脑里。",
          "start": 7.13,
          "end": 10.38
        }
      ]
    },
    {
      "scene": "s5",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "再补两个上榜的。",
          "start": 0.1,
          "end": 1.73
        },
        {
          "index": 1,
          "text": "jenkins，十六年的自动化服务器，代码一提交就自动构建、测试、部署。",
          "start": 1.68,
          "end": 7.07
        },
        {
          "index": 2,
          "text": "老牌基建依然能打。",
          "start": 7.07,
          "end": 9.08
        }
      ]
    },
    {
      "scene": "s6",
      "segment_index": 5,
      "sentences": [
        {
          "index": 0,
          "text": "微软也下场了，agent-governance-toolkit。",
          "start": 0.1,
          "end": 2.71
        },
        {
          "index": 1,
          "text": "给AI智能体上安全锁，管执行权限、做零信任较验。",
          "start": 2.66,
          "end": 7.2
        },
        {
          "index": 2,
          "text": "AI越火，越需要这种治理工具。",
          "start": 7.2,
          "end": 9.94
        }
      ]
    },
    {
      "scene": "s7",
      "segment_index": 6,
      "sentences": [
        {
          "index": 0,
          "text": "再补一个，superfile。",
          "start": 0.1,
          "end": 2.09
        },
        {
          "index": 1,
          "text": "终端里的文件管理器，界面做得挺好看，单日掌了六百多星。",
          "start": 2.04,
          "end": 6.88
        }
      ]
    },
    {
      "scene": "s8",
      "segment_index": 7,
      "sentences": [
        {
          "index": 0,
          "text": "今天这几个方向差别挺大，你最想试哪个？",
          "start": 0.1,
          "end": 3.42
        },
        {
          "index": 1,
          "text": "关注我，下期见。",
          "start": 3.37,
          "end": 5.37
        }
      ]
    }
  ]
