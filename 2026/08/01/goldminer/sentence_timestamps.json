  },
  "segments": [
    {
      "scene": "s1",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "淘金！",
          "start": 0.1,
          "end": 1.115
        },
        {
          "index": 1,
          "text": "开淘！",
          "start": 1.065,
          "end": 2.076
        },
        {
          "index": 2,
          "text": "双减砍补课，却埋25亿编程。",
          "start": 2.076,
          "end": 5.25
        }
      ]
    },
    {
      "scene": "s2",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "主角登场，编程猫，CodeMao。",
          "start": 0.1,
          "end": 2.745
        },
        {
          "index": 1,
          "text": "中国最大的少儿编程平台，覆盖 7 到 16 岁孩子。",
          "start": 2.695,
          "end": 6.945
        },
        {
          "index": 2,
          "text": "它做的是图形化编程工具，拖拖拽拽就能搭出小游戏，路子类似 Scratch。",
          "start": 6.945,
          "end": 12.478
        },
        {
          "index": 3,
          "text": "资本一路疯抢，累计融资 3.6 亿美金，折合 25 亿人民币。",
          "start": 12.478,
          "end": 17.695
        },
        {
          "index": 4,
          "text": "我本以为素质教育是条安稳赛道，可它偏偏死在一张红头文件手里。",
          "start": 17.695,
          "end": 23.119
        }
      ]
    },
    {
      "scene": "s3",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "2021 年 7 月 24 日，双减落地。",
          "start": 0.1,
          "end": 3.213
        },
        {
          "index": 1,
          "text": "本意砍语数英的应试补课，给家庭减负。",
          "start": 3.163,
          "end": 6.586
        },
        {
          "index": 2,
          "text": "可监管的解释一路扩大，把少儿编程也归进了补课——编程明明是素质教育，跟应试压根不沾边。",
          "start": 6.586,
          "end": 14.217
        },
        {
          "index": 3,
          "text": "编程猫约 95% 的营收，来自这瞬间违法的中小学段。",
          "start": 14.217,
          "end": 18.989
        },
        {
          "index": 4,
          "text": "红头文件一发，90 天，业务蒸发，投资人断供，裁员七成。",
          "start": 18.989,
          "end": 24.304
        },
        {
          "index": 5,
          "text": "它没做错任何事，产品对、技术对、用户也认，却被告知：你违法。",
          "start": 24.304,
          "end": 30.282
        }
      ]
    },
    {
      "scene": "s4",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "我扒完残骸，淘到三个真教训。",
          "start": 0.1,
          "end": 2.865
        },
        {
          "index": 1,
          "text": "其一，监管集中风险：营收全压中国，手握 3.6 亿美金，2018 年就该出海，单一国家别超四成。",
          "start": 2.815,
          "end": 10.891
        },
        {
          "index": 2,
          "text": "其二，订阅死区：月费三五十块，太贵当不了休闲，太便宜又做不出深度。",
          "start": 10.891,
          "end": 17.326
        },
        {
          "index": 3,
          "text": "其三，转型太慢：危机来了，要 60 天能赚钱的转身，不是 9 个月的销售周期。",
          "start": 17.326,
          "end": 23.619
        },
        {
          "index": 4,
          "text": "点子也现成：用大模型当 AI 老师砍掉人力成本，免费基础课引流，出海东南亚。",
          "start": 23.619,
          "end": 30.804
        }
      ]
    },
    {
      "scene": "s5",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "同一场双减飓风，新东方靠直播带货活了下来，好未来也熬过冬天。",
          "start": 0.1,
          "end": 5.571
        },
        {
          "index": 1,
          "text": "编程猫却栽在转型太慢、出海缺位。",
          "start": 5.521,
          "end": 8.76
        },
        {
          "index": 2,
          "text": "一张考卷，有人交白卷，有人抄了满分。",
          "start": 8.76,
          "end": 12.228
        },
        {
          "index": 3,
          "text": "这个 AI 编程教育的点子，你觉得能成吗？",
          "start": 12.228,
          "end": 16.271
        }
      ]
    }
  ]
}