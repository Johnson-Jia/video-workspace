  "segments": [
    {
      "scene": "s1",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "AI 居然连干几小时。",
          "start": 0.1,
          "end": 2.32
        }
      ]
    },
    {
      "scene": "s2",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "先说微软这套 AI 入门课，12 周 24 节，从基础讲到实战，一分钱没收。",
          "start": 0.1,
          "end": 5.97
        },
        {
          "index": 1,
          "text": "今天单日掌了快九百五十颗星，直接冲上榜首。",
          "start": 5.92,
          "end": 9.52
        }
      ]
    },
    {
      "scene": "s3",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "第二个 kaneo，开源的项目管理工具，功能刚好够用、不臃肿。",
          "start": 0.1,
          "end": 4.37
        },
        {
          "index": 1,
          "text": "同类商业软件按人头收费，它能自己部署，今天掌了七百多颗星。",
          "start": 4.32,
          "end": 9.49
        }
      ]
    },
    {
      "scene": "s4",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "invidious 是个视频网站的开源前端，自己部署，界面更轻更干净。",
          "start": 0.1,
          "end": 4.93
        },
        {
          "index": 1,
          "text": "这是个老牌项目，二十多万人点过星，今天还在掌。",
          "start": 4.88,
          "end": 8.87
        }
      ]
    },
    {
      "scene": "s5",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "还有微软的 TRELLIS.2，一句话文字描述，就能生成 3D 模型。",
          "start": 0.1,
          "end": 4.71
        },
        {
          "index": 1,
          "text": "原来做 3D 要专业软件加学习成本，现在门槛被它拉下来不少。",
          "start": 4.66,
          "end": 9.6
        }
      ]
    },
    {
      "scene": "s6",
      "segment_index": 5,
      "sentences": [
        {
          "index": 0,
          "text": "开头那个能连干几小时的，是字节的 deer-flow。",
          "start": 0.1,
          "end": 3.4
        },
        {
          "index": 1,
          "text": "普通助手只回一句，它能自己调研、写代码、做创作，独自干几小时，给做 AI 应用的开发者用。",
          "start": 3.35,
          "end": 10.77
        }
      ]
    },
    {
      "scene": "s7",
      "segment_index": 6,
      "sentences": [
        {
          "index": 0,
          "text": "还有个本地语音助手，不用联网。",
          "start": 0.1,
          "end": 2.58
        },
        {
          "index": 1,
          "text": "这几个你最想试哪个？",
          "start": 2.53,
          "end": 4.66
        },
        {
          "index": 2,
          "text": "关注我，下期见。",
          "start": 4.66,
          "end": 6.66
        }
      ]
    }
  ]
}