  "segments": [
    {
      "scene": "s1",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "8 个 AI，4 个钻进命令航。",
          "start": 0.1,
          "end": 2.57
        }
      ]
    },
    {
      "scene": "s2",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "先看终端里常驻一个 AI 编程助手。",
          "start": 0.1,
          "end": 3.12
        },
        {
          "index": 1,
          "text": "你敲命令，它接手写代码，挂一整天也不卡。",
          "start": 3.07,
          "end": 6.31
        },
        {
          "index": 2,
          "text": "缓存稳住了上下文，挂着就能一直用。",
          "start": 6.31,
          "end": 9.58
        }
      ]
    },
    {
      "scene": "s3",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "另一个，把超大模型拆成一层层来算。",
          "start": 0.1,
          "end": 3.29
        },
        {
          "index": 1,
          "text": "普通一张消费级显卡，就能跑通常要八张专业卡的模型。",
          "start": 3.24,
          "end": 7.53
        },
        {
          "index": 2,
          "text": "靠的是权重流式加载，按需取用。",
          "start": 7.53,
          "end": 10.67
        }
      ]
    },
    {
      "scene": "s4",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "还有款工具，一个命令读遍六大平台。",
          "start": 0.1,
          "end": 3.31
        },
        {
          "index": 1,
          "text": "社交、视频、社区的内容它都能抓，不用申请接口、不花接口钱，AI 自己去翻全网。",
          "start": 3.26,
          "end": 9.82
        }
      ]
    },
    {
      "scene": "s5",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "最后这个 AI 技能，专做三十天调研。",
          "start": 0.1,
          "end": 3.04
        },
        {
          "index": 1,
          "text": "指定话题，它跨平台汇总成报告，还带来源，热度一目了然。",
          "start": 2.99,
          "end": 8.12
        }
      ]
    },
    {
      "scene": "s6",
      "segment_index": 5,
      "sentences": [
        {
          "index": 0,
          "text": "榜单里还有给 AI 存记忆的中间件，团队共享、四种记忆可复用，对话文档代码都能变资产。",
          "start": 0.1,
          "end": 6.8
        },
        {
          "index": 1,
          "text": "另外两门大厂 AI 入门课还在霸榜，单日掌星两千六。",
          "start": 6.75,
          "end": 11.13
        }
      ]
    },
    {
      "scene": "s7",
      "segment_index": 6,
      "sentences": [
        {
          "index": 0,
          "text": "命令航 AI 和网页 AI，你更信哪个？",
          "start": 0.1,
          "end": 3.3
        },
        {
          "index": 1,
          "text": "关注我，下期见。",
          "start": 3.25,
          "end": 5.25
        }
      ]
    }
  ]
}