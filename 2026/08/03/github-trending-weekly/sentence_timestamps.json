  "segments": [
    {
      "scene": "s1",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "第32周，八个AI编程工具杀入周榜。",
          "start": 0.1,
          "end": 3.83
        }
      ]
    },
    {
      "scene": "s2",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "AI编程这组先看。",
          "start": 0.1,
          "end": 1.83
        },
        {
          "index": 1,
          "text": "阿里刚开源的代码审查工具，能精确定位线程安全、SQL注入这类漏洞。",
          "start": 1.78,
          "end": 7.19
        },
        {
          "index": 2,
          "text": "jcode主打省内存，老电脑跑编程智能体也不卡。",
          "start": 7.19,
          "end": 10.74
        },
        {
          "index": 3,
          "text": "t3code掏出手机就能遥控AI写代码。",
          "start": 10.74,
          "end": 14.38
        }
      ]
    },
    {
      "scene": "s3",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "给AI助手加技能的这组。",
          "start": 0.1,
          "end": 2.27
        },
        {
          "index": 1,
          "text": "book-to-skill把技术书PDF直接变成AI能用的技能库。",
          "start": 2.22,
          "end": 6.18
        },
        {
          "index": 2,
          "text": "i-have-adhd让AI别把关键结论埋在常答案里。",
          "start": 6.18,
          "end": 9.82
        },
        {
          "index": 3,
          "text": "ego-lite把浏览器登录态共享给AI，替你操作网页。",
          "start": 9.82,
          "end": 13.79
        }
      ]
    },
    {
      "scene": "s4",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "AI接入和创意这组最多。",
          "start": 0.1,
          "end": 2.27
        },
        {
          "index": 1,
          "text": "OmniRoute一个接口接住两百多个大模型，还能省大半token。",
          "start": 2.22,
          "end": 6.44
        },
        {
          "index": 2,
          "text": "aisuite是知名AI学者开源的多模型统一接口。",
          "start": 6.44,
          "end": 10.06
        },
        {
          "index": 3,
          "text": "airi是能语音聊天还能玩我的世界的AI伴侣，全程自己部署。",
          "start": 10.06,
          "end": 14.66
        },
        {
          "index": 4,
          "text": "buzz是人和AI共建代码的蜂巢协作平台。",
          "start": 14.66,
          "end": 18.42
        }
      ]
    },
    {
      "scene": "s5",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "通讯和学习这组跨度大但实用。",
          "start": 0.1,
          "end": 2.95
        },
        {
          "index": 1,
          "text": "bitchat用蓝牙mesh组网，不联网也能加密聊天。",
          "start": 2.9,
          "end": 6.21
        },
        {
          "index": 2,
          "text": "editor在浏览器里创建分享3D建筑模型。",
          "start": 6.21,
          "end": 9.71
        },
        {
          "index": 3,
          "text": "AI-For-Beginners是微软12周24节的AI入门课。",
          "start": 9.71,
          "end": 13.84
        }
      ]
    },
    {
      "scene": "s6",
      "segment_index": 5,
      "sentences": [
        {
          "index": 0,
          "text": "这周GitHub大半被AI编程工具占了，写代码、审代码、调模型全链路开源。",
          "start": 0.1,
          "end": 6.25
        }
      ]
    },
    {
      "scene": "s7",
      "segment_index": 6,
      "sentences": [
        {
          "index": 0,
          "text": "这十三个项目你最想试哪个？",
          "start": 0.1,
          "end": 2.56
        },
        {
          "index": 1,
          "text": "第32周周榜就到这，关注GitHub星探，下周见。",
          "start": 2.51,
          "end": 6.63
        }
      ]
    }
  ]
}