    {
      "scene": "s1",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "AI 居然不健忘，团队共用一个脑",
          "start": 0.1,
          "end": 3.03
        }
      ]
    },
    {
      "scene": "s2",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "先看腾讯开源的 AI 团队记忆中枢。",
          "start": 0.1,
          "end": 3.03
        },
        {
          "index": 1,
          "text": "以前 AI 聊完就忘，这个给整个团队装共享大脑，谁学到的大家都懂。",
          "start": 2.98,
          "end": 8.61
        },
        {
          "index": 2,
          "text": "一天掌了一千星。",
          "start": 8.61,
          "end": 10.43
        }
      ]
    },
    {
      "scene": "s3",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "第二个，给 AI 装眼睛读全网。",
          "start": 0.1,
          "end": 2.63
        },
        {
          "index": 1,
          "text": "六大平台它自己去翻，一个命令零接口费，AI 自己就能做调研。",
          "start": 2.58,
          "end": 7.52
        },
        {
          "index": 2,
          "text": "总星六万五。",
          "start": 7.52,
          "end": 9.13
        }
      ]
    },
    {
      "scene": "s4",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "第三个，让 AI 实时开口跟你聊。",
          "start": 0.1,
          "end": 2.78
        },
        {
          "index": 1,
          "text": "不用打字，它边听边答，跟真人说话一样。",
          "start": 2.73,
          "end": 5.82
        },
        {
          "index": 2,
          "text": "实时语音 AI 框架，一万两千星。",
          "start": 5.82,
          "end": 9.08
        }
      ]
    },
    {
      "scene": "s5",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "第四个更狠，4G 显存跑 700 亿参数 AI 大脑。",
          "start": 0.1,
          "end": 4.11
        },
        {
          "index": 1,
          "text": "在你自己电脑上跑，数据不出门，不用担心隐私泄露。",
          "start": 4.06,
          "end": 7.9
        },
        {
          "index": 2,
          "text": "两万七千星。",
          "start": 7.9,
          "end": 9.5
        }
      ]
    },
    {
      "scene": "s6",
      "segment_index": 5,
      "sentences": [
        {
          "index": 0,
          "text": "最后一个，开源 AI 语音工作室。",
          "start": 0.1,
          "end": 2.64
        },
        {
          "index": 1,
          "text": "克隆声音、语音听写、声音创作，带界面普通人也能用。",
          "start": 2.59,
          "end": 6.89
        },
        {
          "index": 2,
          "text": "不用花钱买会员，快五万星了。",
          "start": 6.89,
          "end": 9.79
        }
      ]
    },
    {
      "scene": "s7",
      "segment_index": 6,
      "sentences": [
        {
          "index": 0,
          "text": "这几个 AI 你最想试哪个？",
          "start": 0.1,
          "end": 2.48
        },
        {
          "index": 1,
          "text": "关注我，下期见。",
          "start": 2.43,
          "end": 4.43
        }
      ]
    }
  ]
