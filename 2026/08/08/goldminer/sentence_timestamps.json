      "sentences": [
        {
          "index": 0,
          "text": "淘金！",
          "start": 0.1,
          "end": 1.03
        },
        {
          "index": 1,
          "text": "开淘！",
          "start": 0.98,
          "end": 1.91
        },
        {
          "index": 2,
          "text": "越扩越亏，188M烧光。",
          "start": 1.91,
          "end": 4.8
        }
      ]
    },
    {
      "scene": "s2",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "我扒的这家叫 Changingedu，2014 年做起 K-12 在线辅导加自适应学习，主打中小学课外补习。",
          "start": 0.1,
          "end": 7.04
        },
        {
          "index": 1,
          "text": "一路融了 1.88 亿美金，当年教培赛道的明星，砸钱抢市场抢得很凶。",
          "start": 6.99,
          "end": 12.76
        }
      ]
    },
    {
      "scene": "s3",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "它其实死于两刀。",
          "start": 0.1,
          "end": 1.65
        },
        {
          "index": 1,
          "text": "头一刀是单位经济早崩了：抢一个学生要花五百到八百美金，一个月只赚五十到一百，年流失四五成，越扩张亏越多，本质是用新钱补旧账的庞氏。",
          "start": 1.6,
          "end": 12.04
        },
        {
          "index": 2,
          "text": "后一刀才是 2021 年 7 月双减，核心课禁营利、禁外资、禁周末补课，一夜把整个模式判非法。",
          "start": 12.04,
          "end": 19.1
        },
        {
          "index": 3,
          "text": "就算没这刀，它当时月烧两千万美金，也撑不到盈利。",
          "start": 19.1,
          "end": 23.46
        }
      ]
    },
    {
      "scene": "s4",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "我淘到的教训一句：单位经济得小规模先跑通，每个客户在亏就别扩张，规模从修不好漏水的桶。",
          "start": 0.1,
          "end": 7.75
        },
        {
          "index": 1,
          "text": "后一刀提醒你，教育医疗金融这种强监管航业，政策能一夜抹掉整条赛道。",
          "start": 7.7,
          "end": 13.08
        },
        {
          "index": 2,
          "text": "可偷的点子更香：用大模型当主讲，课时成本从五十美金压到几毛钱，真人只做激励和答疑，毛利翻好几倍。",
          "start": 13.08,
          "end": 21.29
        }
      ]
    },
    {
      "scene": "s5",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "同遭双减的还有 Qkids，一亿美金照样归零。",
          "start": 0.1,
          "end": 3.28
        },
        {
          "index": 1,
          "text": "整个教培一夜蒸发一千多亿美金市值，谁都没跑掉。",
          "start": 3.23,
          "end": 7.12
        },
        {
          "index": 2,
          "text": "淘金！",
          "start": 7.12,
          "end": 8.06
        },
        {
          "index": 3,
          "text": "开淘！",
          "start": 8.06,
          "end": 8.99
        },
        {
          "index": 4,
          "text": "大模型代课这条路，你怎么看？",
          "start": 8.99,
          "end": 11.95
        }
      ]
    }
  ]
}