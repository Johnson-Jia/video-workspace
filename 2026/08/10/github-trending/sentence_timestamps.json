  "segments": [
    {
      "scene": "s1",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "谷歌居然开源了天气模型。",
          "start": 0.1,
          "end": 2.54
        }
      ]
    },
    {
      "scene": "s2",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "先看谷歌DeepMind的WeatherNext，用AI预测全球天气的模型。",
          "start": 0.1,
          "end": 4.28
        },
        {
          "index": 1,
          "text": "以前预报要解复杂的大气方程，它直接推算，连台风路径都能给出，代码还开源了。",
          "start": 4.23,
          "end": 10.53
        }
      ]
    },
    {
      "scene": "s3",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "再看t3code，用手机遥控电脑里的AI写代码。",
          "start": 0.1,
          "end": 3.85
        },
        {
          "index": 1,
          "text": "平时AI编程助手在电脑上跑着，你出门在外，手机就能接手指挥，相当于给AI配了个遥控器。",
          "start": 3.8,
          "end": 10.88
        }
      ]
    },
    {
      "scene": "s4",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "另一个，code-graph-rag，让AI真正读懂整个代码库。",
          "start": 0.1,
          "end": 4.27
        },
        {
          "index": 1,
          "text": "普通AI读代码靠文本切片，它把代码建成知识图谱，跨文件理清调用关系，给开发者一个看懂全貌的助手。",
          "start": 4.22,
          "end": 12.52
        }
      ]
    },
    {
      "scene": "s5",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "最后是ComfyUI，星标十二万的节点式AI画图平台。",
          "start": 0.1,
          "end": 4.39
        },
        {
          "index": 1,
          "text": "普通AI画图输文字出图，它把生成流程拆成可拖拽节点，像搭积木一样组合模型，拼出复杂工作流。",
          "start": 4.34,
          "end": 12.45
        }
      ]
    },
    {
      "scene": "s6",
      "segment_index": 5,
      "sentences": [
        {
          "index": 0,
          "text": "这四个，你会用上哪个？",
          "start": 0.1,
          "end": 2.34
        },
        {
          "index": 1,
          "text": "关注我，每天热门开源见。",
          "start": 2.29,
          "end": 4.81
        }
      ]
    }
  ]
}