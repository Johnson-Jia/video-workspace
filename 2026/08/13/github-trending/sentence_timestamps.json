        }
      ]
    },
    {
      "scene": "s2",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "先看 diagram-design，二十九套编辑级图表模板。",
          "start": 0.1,
          "end": 3.63
        },
        {
          "index": 1,
          "text": "不用从零排版，套上就有杂志感。",
          "start": 3.58,
          "end": 6.26
        },
        {
          "index": 2,
          "text": "单日掌星两千八百多，做文档的人直接拿来用。",
          "start": 6.26,
          "end": 10.11
        }
      ]
    },
    {
      "scene": "s3",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "接着 localsend，跨设备传文件不用数据线。",
          "start": 0.1,
          "end": 3.38
        },
        {
          "index": 1,
          "text": "同一局域网里，手机电脑隔空互传，不挑系统，不用登录云盘。",
          "start": 3.33,
          "end": 8.36
        },
        {
          "index": 2,
          "text": "八万七千人在用。",
          "start": 8.36,
          "end": 10.23
        }
      ]
    },
    {
      "scene": "s4",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "再看 everyone-can-use-english，学英语不用报班背单词。",
          "start": 0.1,
          "end": 3.62
        },
        {
          "index": 1,
          "text": "这套开源方法让三万六千人按自己的节奏，把英语在真实场景里真正用起来。",
          "start": 3.57,
          "end": 9.82
        }
      ]
    },
    {
      "scene": "s5",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "然后是 ppt-master，做演示文稿不用一页页排版。",
          "start": 0.1,
          "end": 3.73
        },
        {
          "index": 1,
          "text": "把文档交给 AI，直接生成带动画和数据图表的原生 PPT，还能自动配音讲解。",
          "start": 3.68,
          "end": 9.45
        },
        {
          "index": 2,
          "text": "四万五千人在用。",
          "start": 9.45,
          "end": 11.37
        }
      ]
    },
    {
      "scene": "s6",
      "segment_index": 5,
      "sentences": [
        {
          "index": 0,
          "text": "最后是 needle，跑 AI 模型不用云端显卡。",
          "start": 0.1,
          "end": 3.26
        },
        {
          "index": 1,
          "text": "十四兆的小模型塞进手机手表，离线也能用。",
          "start": 3.21,
          "end": 6.94
        },
        {
          "index": 2,
          "text": "这五个让生活变简单的开源工具，你最想试哪个？",
          "start": 6.94,
          "end": 10.73
        },
        {
          "index": 3,
          "text": "关注我，下期见。",
