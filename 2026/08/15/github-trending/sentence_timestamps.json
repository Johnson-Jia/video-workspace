      "scene": "s1",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "剪视频控电脑，居然攒了二十万星",
          "start": 0.1,
          "end": 3.21
        }
      ]
    },
    {
      "scene": "s2",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "先看 OpenCut，开源的视频剪辑工具。",
          "start": 0.1,
          "end": 2.88
        },
        {
          "index": 1,
          "text": "不用买会员装大软件，浏览器打开就能剪，时间线、字幕、转场都有，八万多人在用。",
          "start": 2.83,
          "end": 9.47
        }
      ]
    },
    {
      "scene": "s3",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "再看 rustdesk，开源远程桌面。",
          "start": 0.1,
          "end": 2.49
        },
        {
          "index": 1,
          "text": "人在外面，手机直接连家里电脑，跟坐在家里操作一样，连接数据还能自己管，十二万人在用。",
          "start": 2.44,
          "end": 9.25
        }
      ]
    },
    {
      "scene": "s4",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "第三个 spec-kit，GitHub 官方出手。",
          "start": 0.1,
          "end": 2.63
        },
        {
          "index": 1,
          "text": "AI 写码总翻车，多半不是模型笨，是需求没写清。",
          "start": 2.58,
          "end": 6.35
        },
        {
          "index": 2,
          "text": "先把规格写明白，AI 再照着干，单日掌星一千一。",
          "start": 6.35,
          "end": 10.52
        }
      ]
    },
    {
      "scene": "s5",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "最后 ego-lite，给 AI 智能体用的浏览器。",
          "start": 0.1,
          "end": 3.25
        },
        {
          "index": 1,
          "text": "它直接用你登录过的网页状态接着干活，像个不用带教的数字实习生，还不打断你正用的窗口。",
          "start": 3.2,
          "end": 9.93
        }
      ]
    },
    {
      "scene": "s6",
      "segment_index": 5,
      "sentences": [
        {
          "index": 0,
          "text": "这四个工具，你会先用哪个？",
          "start": 0.1,
          "end": 2.56
        },
        {
          "index": 1,
          "text": "关注我，下期见。",
          "start": 2.51,
          "end": 4.51
        }
      ]
    }
  ]
}