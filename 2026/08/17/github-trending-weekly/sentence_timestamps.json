    {
      "scene": "s6",
      "segment_index": 5,
      "sentences": [
        {
          "index": 0,
          "text": "一周看下来，GitHub在给AI建办公室：记忆、技能、路由，都有人抢着做。",
          "start": 0.1,
          "end": 5.9
        },
        {
          "index": 1,
          "text": "另一头，模型越做越小，直接扎进手表里。",
          "start": 5.85,
          "end": 9.56
        }
