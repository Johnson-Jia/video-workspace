          "start": 5.36,
          "end": 7.72
        },
        {
          "index": 3,
          "text": "manim专攻数学动画。",
          "start": 7.72,
          "end": 9.72
        },
        {
          "index": 4,
          "text": "holehe帮你自查邮箱，在哪些网站注册过。",
          "start": 9.72,
          "end": 13.1
        }
