        {
          "index": 0,
          "text": "11万人把照片搬回自己家",
          "start": 0.1,
          "end": 2.75
        }
      ]
    },
    {
      "scene": "s2",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "先看 immich，自托管照片管理。",
          "start": 0.1,
          "end": 2.52
        },
        {
          "index": 1,
          "text": "家里一台旧电脑，手机连上，照片视频自动备份。",
          "start": 2.47,
          "end": 6.19
        },
        {
          "index": 2,
          "text": "不压缩画质、不限速。",
          "start": 6.19,
          "end": 8.15
        },
        {
          "index": 3,
          "text": "11万颗星，照片的钥匙自己拿。",
          "start": 8.15,
          "end": 11.23
        }
      ]
    },
    {
      "scene": "s3",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "OpenLogi，管罗技键鼠的本地工具。",
          "start": 0.1,
          "end": 2.71
        },
        {
          "index": 1,
          "text": "改键、条 DPI、滚轮速度全能条，免账号、零遥测。",
          "start": 2.66,
          "end": 7.03
        },
        {
          "index": 2,
          "text": "做了三个月，攒下八千六百星。",
          "start": 7.03,
          "end": 9.69
        }
      ]
    },
    {
      "scene": "s4",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "Motrix，全功能下载管理器。",
          "start": 0.1,
          "end": 2.37
        },
        {
          "index": 1,
          "text": "界面干净得像十年前的软件，一做就是七年，攒下 5万3千颗星。",
          "start": 2.32,
          "end": 7.41
        },
        {
          "index": 2,
          "text": "全协议、全平台，下载这件事交给专业的。",
          "start": 7.41,
          "end": 11.22
        }
      ]
    },
    {
      "scene": "s5",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "llmfit，本地模型的体检站。",
          "start": 0.1,
          "end": 2.32
        },
        {
          "index": 1,
          "text": "一条命令，先测硬件能跑啥，再挑模型，20G 的弯路替你省了。",
          "start": 2.27,
          "end": 7.54
        },
        {
          "index": 2,
          "text": "3万2千颗星，单日再掌 198。",
          "start": 7.54,
          "end": 11.16
        }
      ]
    },
    {
      "scene": "s6",
      "segment_index": 5,
      "sentences": [
        {
          "index": 0,
          "text": "strix，给自己的应用做安全体检。",
          "start": 0.1,
          "end": 2.85
        },
        {
          "index": 1,
          "text": "AI 帮你找漏洞、给修复建议，上线前心里有底。",
          "start": 2.8,
          "end": 6.24
        },
        {
          "index": 2,
          "text": "单日掌 598 星，总计 5万4千颗星。",
          "start": 6.24,
          "end": 10.01
