      "scene": "s1",
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "AI金鱼记忆，730星治好",
          "start": 0.1,
          "end": 2.86
        }
      ]
    },
    {
      "scene": "s2",
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "AI新开会话，背景忘个精光。",
          "start": 0.1,
          "end": 2.51
        },
        {
          "index": 1,
          "text": "8月19日，一个Rust工具出手了，给AI装上外挂硬盘，换家AI也能带走。",
          "start": 2.46,
          "end": 8.29
        },
        {
          "index": 2,
          "text": "2700星，单日暴掌730。",
          "start": 8.29,
          "end": 11.51
        }
      ]
    },
    {
      "scene": "s3",
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "第二个更跨界。",
          "start": 0.1,
          "end": 1.49
        },
        {
          "index": 1,
          "text": "做项目管理的18年老厂，调了一整套Linux桌面。",
          "start": 1.44,
          "end": 5.04
        },
        {
          "index": 2,
          "text": "字体、窗口、快捷键全替你选好。",
          "start": 5.04,
          "end": 8.06
        },
        {
          "index": 3,
          "text": "2.6万人买单，单日再掌411星。",
          "start": 8.06,
          "end": 11.65
        }
      ]
    },
    {
      "scene": "s4",
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "第三个，剪视频不用开会员。",
          "start": 0.1,
          "end": 2.45
        },
        {
          "index": 1,
          "text": "开源剪辑工具，时间线、多轨道、导出全免费。",
          "start": 2.4,
          "end": 6.23
        },
        {
          "index": 2,
          "text": "8.5万人在用，单日再掌288星。",
          "start": 6.23,
          "end": 9.82
        }
      ]
    },
    {
      "scene": "s5",
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "第四个最意外。",
          "start": 0.1,
          "end": 1.47
        },
        {
          "index": 1,
          "text": "别人开源代码，这位作者开源了一整本书。",
          "start": 1.42,
          "end": 4.6
        },
        {
          "index": 2,
          "text": "正文、PDF、配套代码全送。",
          "start": 4.6,
          "end": 7.42
        },
        {
          "index": 3,
          "text": "3.9万人收藏，单日再掌556星。",
          "start": 7.42,
          "end": 11.23
        }
      ]
    },
    {
      "scene": "s6",
      "segment_index": 5,
      "sentences": [
        {
          "index": 0,
          "text": "最后，前几天说过的免费接口清单，又掌了一千多星。",
          "start": 0.1,
          "end": 4.15
        },
        {
          "index": 1,
          "text": "免费书和AI记忆外挂，你会先试哪个？",
          "start": 4.1,
          "end": 7.27
        },
        {
          "index": 2,
          "text": "关注我，下期见。",
          "start": 7.27,
          "end": 9.27
        }
      ]
    }
  ]
}