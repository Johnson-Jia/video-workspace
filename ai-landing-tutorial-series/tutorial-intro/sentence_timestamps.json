{
  "meta": {
    "voice": "zh-CN-YunjianNeural",
    "rate": "+0%",
    "source": "edge-tts-srt"
  },
  "segments": [
    {
      "scene": 1,
      "segment_index": 0,
      "sentences": [
        {
          "index": 0,
          "text": "八十多人团队，三个月，人均产出翻倍，AI 代码占比七成六，这套转型方法论到底怎么做到的，三分钟给你讲透。",
          "start": 0.1,
          "end": 10.625
        }
      ]
    },
    {
      "scene": 2,
      "segment_index": 1,
      "sentences": [
        {
          "index": 0,
          "text": "核心理念一句话，AI 扩展的是会用 AI 的人的能力边界，人是根本。",
          "start": 0.1,
          "end": 6.537
        }
      ]
    },
    {
      "scene": 3,
      "segment_index": 2,
      "sentences": [
        {
          "index": 0,
          "text": "整个路线分思想地基加六阶段落地，从启动、实施、规模到沉淀，四组递进。",
          "start": 0.1,
          "end": 7.712
        }
      ]
    },
    {
      "scene": 4,
      "segment_index": 3,
      "sentences": [
        {
          "index": 0,
          "text": "先懂五条原理，大模型本质是预测下一个词元，会幻觉，必须验证。",
          "start": 0.1,
          "end": 7.2
        }
      ]
    },
    {
      "scene": 5,
      "segment_index": 4,
      "sentences": [
        {
          "index": 0,
          "text": "上下文是稀缺资源，减法优先，干净会话，命令航优于协议中间件。",
          "start": 0.1,
          "end": 7.062
        }
      ]
    },
    {
      "scene": 6,
      "segment_index": 5,
      "sentences": [
        {
          "index": 0,
          "text": "启动四件事，目标量化、路线图、组织保障、风险预案，缺一不可。",
          "start": 0.1,
          "end": 7.137
        }
      ]
    },
    {
      "scene": 7,
      "segment_index": 6,
      "sentences": [
        {
          "index": 0,
          "text": "预算四块成本，三到六个月回本，按你公司的真实薪资算。",
          "start": 0.1,
          "end": 5.662
        }
      ]
    },
    {
      "scene": 8,
      "segment_index": 7,
      "sentences": [
        {
          "index": 0,
          "text": "立项别承诺翻倍，承诺目标值加试点路径，更诚实也更有力。",
          "start": 0.1,
          "end": 6.187
        }
      ]
    },
    {
      "scene": 9,
      "segment_index": 8,
      "sentences": [
        {
          "index": 0,
          "text": "赋能三件事，选工具、全员培训到全覆盖、规范资产化，做到位才算赋能。",
          "start": 0.1,
          "end": 7.6
        }
      ]
    },
    {
      "scene": 10,
      "segment_index": 9,
      "sentences": [
        {
          "index": 0,
          "text": "工具按角色选，开发者要终端原生，非开发云端形态更友好。",
          "start": 0.1,
          "end": 6.312
        }
      ]
    },
    {
      "scene": 11,
      "segment_index": 10,
      "sentences": [
        {
          "index": 0,
          "text": "克劳德,文档每航都要挣位置，删了不犯错就删，详细指令移进技能。",
          "start": 0.1,
          "end": 7.062
        }
      ]
    },
    {
      "scene": 12,
      "segment_index": 11,
      "sentences": [
        {
          "index": 0,
          "text": "给 AI 装上眼睛和记忆，四件套未大代码库准备，小团队可跳过。",
          "start": 0.1,
          "end": 6.675
        }
      ]
    },
    {
      "scene": 13,
      "segment_index": 12,
      "sentences": [
        {
          "index": 0,
          "text": "改代码前先看影响范围，图谱和检索分层共存，确定性走图、语义走检索。",
          "start": 0.1,
          "end": 8.087
        }
      ]
    },
    {
      "scene": 14,
      "segment_index": 13,
      "sentences": [
        {
          "index": 0,
          "text": "单点用 AI 容易，闭环难，用规范加编排串成六阶段闭环。",
          "start": 0.1,
          "end": 6.375
        }
      ]
    },
    {
      "scene": 15,
      "segment_index": 14,
      "sentences": [
        {
          "index": 0,
          "text": "规范驱动三产物，需求偏差左移到改文档，便宜一个量级。",
          "start": 0.1,
          "end": 5.912
        }
      ]
    },
    {
      "scene": 16,
      "segment_index": 15,
      "sentences": [
        {
          "index": 0,
          "text": "编排型技能六阶段，每阶段只读当前文件，探索阶段主动找死代码。",
          "start": 0.1,
          "end": 7.225
        }
      ]
    },
    {
      "scene": 17,
      "segment_index": 16,
      "sentences": [
        {
          "index": 0,
          "text": "防 AI 偷改测试，不让 AI 同时写代码和测试，全绿可能全错。",
          "start": 0.1,
          "end": 6.475
        }
      ]
    },
    {
      "scene": 18,
      "segment_index": 17,
      "sentences": [
        {
          "index": 0,
          "text": "真实交付案例，AI 是执行者，用户对业务的理解才是核心。",
          "start": 0.1,
          "end": 6.062
        }
      ]
    },
    {
      "scene": 19,
      "segment_index": 18,
      "sentences": [
        {
          "index": 0,
          "text": "从试点到全员，多智能体并行放大提效，用数据证伪。",
          "start": 0.1,
          "end": 6.012
        }
      ]
    },
    {
      "scene": 20,
      "segment_index": 19,
      "sentences": [
        {
          "index": 0,
          "text": "AI 占比三层识别，埋点加风格学，防伪造。",
          "start": 0.1,
          "end": 4.725
        }
      ]
    },
    {
      "scene": 21,
      "segment_index": 20,
      "sentences": [
        {
          "index": 0,
          "text": "成果数据，十三组推广，覆盖八成，强相关但非因果。",
          "start": 0.1,
          "end": 6.112
        }
      ]
    },
    {
      "scene": 22,
      "segment_index": 21,
      "sentences": [
        {
          "index": 0,
          "text": "沉淀复用，个体经验变组织资产，把犯错变成自我改进。",
          "start": 0.1,
          "end": 6.125
        }
      ]
    },
    {
      "scene": 23,
      "segment_index": 22,
      "sentences": [
        {
          "index": 0,
          "text": "七种技能范式各管一摊，写好关键在描述要具体。",
          "start": 0.1,
          "end": 5.412
        }
      ]
    },
    {
      "scene": 24,
      "segment_index": 23,
      "sentences": [
        {
          "index": 0,
          "text": "真实避坑，静默吞异常占故障一成五，关键任务必须有外部健康检查。",
          "start": 0.1,
          "end": 7.325
        }
      ]
    },
    {
      "scene": 25,
      "segment_index": 24,
      "sentences": [
        {
          "index": 0,
          "text": "落地验收两档，数据事后统计，对比公允，先质量后速度。",
          "start": 0.1,
          "end": 6.137
        }
      ]
    },
    {
      "scene": 26,
      "segment_index": 25,
      "sentences": [
        {
          "index": 0,
          "text": "代码审查，关键项用钩子强制，不让 AI 自己审自己。",
          "start": 0.1,
          "end": 5.425
        }
      ]
    },
    {
      "scene": 27,
      "segment_index": 26,
      "sentences": [
        {
          "index": 0,
          "text": "开发测试交接，交付防伪加反馈，实现和测试分开写。",
          "start": 0.1,
          "end": 5.75
        }
      ]
    },
    {
      "scene": 28,
      "segment_index": 27,
      "sentences": [
        {
          "index": 0,
          "text": "术语速查，资产、协议、框架，进实施阶段先认。",
          "start": 0.1,
          "end": 5.6
        }
      ]
    },
    {
      "scene": 29,
      "segment_index": 28,
      "sentences": [
        {
          "index": 0,
          "text": "落地清单总览，七阶段、四手册、两验收、三交接，可照做的清单。",
          "start": 0.1,
          "end": 7.312
        }
      ]
    },
    {
      "scene": 30,
      "segment_index": 29,
      "sentences": [
        {
          "index": 0,
          "text": "想清楚、准备好、做出来、铺开去，人是根本。",
          "start": 0.1,
          "end": 4.775
        },
        {
          "index": 1,
          "text": "这套方法论十三集合集，点关注，评论区有教程仓库，每集深讲一个阶段。",
          "start": 4.725,
          "end": 11.925
        }
      ]
    }
  ]
}